Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.418659757941622*^9}],

Cell[TextData[{
 "To expose most clearly the anatomy of the phase singularity one can (as MPF \
advocate) construct the first-order Taylor expansion of  ",
 StyleBox["\[CapitalPsi]\[CapitalPsi][x,y,t,\[Alpha],\[Beta]] ", "Output"],
 "about the singular point x = 2 \[Alpha] t,",
 StyleBox[" ", "Output"],
 "y = 2 \[Beta] t."
}], "Text",
 CellChangeTimes->{{3.418659767037107*^9, 3.4186599728565207`*^9}, {
  3.418660004448476*^9, 3.418660023669159*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"\[CapitalPsi]\[CapitalPsi]", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"2", "\[Alpha]", " ", "t"}], "+", "dx"}], ",", 
     RowBox[{
      RowBox[{"2", "\[Beta]", " ", "t"}], "+", "dy"}], ",", "t", ",", 
     "\[Alpha]", ",", "\[Beta]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"dx", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"dy", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.418659282185923*^9, 3.4186593822640963`*^9}}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    InterpretationBox[
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SuperscriptBox["\[Alpha]", "2"]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SuperscriptBox["\[Beta]", "2"]}]}]], " ", "dy"}], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "dy", "]"}], "2"],
       SeriesData[$CellContext`dy, 0, {}, 1, 2, 1],
       Editable->False]}],
     SeriesData[$CellContext`dy, 0, {
      Complex[0, 1] 
       E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
         Complex[0, 1] $CellContext`t $CellContext`\[Beta]^2)}, 1, 2, 1],
     Editable->False], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     InterpretationBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SuperscriptBox["\[Alpha]", "2"]}], "+", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SuperscriptBox["\[Beta]", "2"]}]}]], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", "t", " ", 
               SuperscriptBox["\[Alpha]", "2"]}], "+", 
              RowBox[{"\[ImaginaryI]", " ", "t", " ", 
               SuperscriptBox["\[Beta]", "2"]}]}]]}], " ", "\[Alpha]"}], "+", 
          
          RowBox[{"\[ImaginaryI]", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "t", " ", 
              SuperscriptBox["\[Alpha]", "2"]}], "+", 
             RowBox[{"\[ImaginaryI]", " ", "t", " ", 
              SuperscriptBox["\[Beta]", "2"]}]}]], " ", "\[Beta]"}]}], ")"}], 
        " ", "dy"}], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "dy", "]"}], "2"],
        SeriesData[$CellContext`dy, 0, {}, 0, 2, 1],
        Editable->False]}],
      SeriesData[$CellContext`dy, 0, {
       E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
         Complex[0, 1] $CellContext`t $CellContext`\[Beta]^2), -
         E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
           Complex[0, 
              1] $CellContext`t $CellContext`\[Beta]^2) $CellContext`\[Alpha] + 
        Complex[0, 1] 
         E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
           Complex[0, 
              1] $CellContext`t $CellContext`\[Beta]^2) $CellContext`\[Beta]},
        0, 2, 1],
      Editable->False], ")"}], " ", "dx"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "dx", "]"}], "2"],
    SeriesData[$CellContext`dx, 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`dx, 0, {
    SeriesData[$CellContext`dy, 0, {
     Complex[0, 1] 
      E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
        Complex[0, 1] $CellContext`t $CellContext`\[Beta]^2)}, 1, 2, 1], 
    SeriesData[$CellContext`dy, 0, {
     E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
       Complex[0, 1] $CellContext`t $CellContext`\[Beta]^2), -
       E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
         Complex[0, 
            1] $CellContext`t $CellContext`\[Beta]^2) $CellContext`\[Alpha] + 
      Complex[0, 1] 
       E^(Complex[0, 1] $CellContext`t $CellContext`\[Alpha]^2 + 
         Complex[0, 
            1] $CellContext`t $CellContext`\[Beta]^2) $CellContext`\[Beta]}, 
     0, 2, 1]}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.418659397931723*^9, 3.568661415055751*^9}]
}, Open  ]],

Cell["\<\
Use that information to construct the following function, which is \"tangent \
to the wave function at the point where it vanishes\"\
\>", "Text",
 CellChangeTimes->{{3.4186600714883547`*^9, 3.418660128799217*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "\[Psi]", "]"}]], "Input",
 CellChangeTimes->{{3.418659572919862*^9, 3.418659578717681*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"dx_", ",", "dy_", ",", "t_", ",", "\[Alpha]_", ",", "\[Beta]_"}], 
   "]"}], ":=", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "t", " ", 
      SuperscriptBox["\[Alpha]", "2"]}], "+", 
     RowBox[{"\[ImaginaryI]", " ", "t", " ", 
      SuperscriptBox["\[Beta]", "2"]}]}]], 
   RowBox[{"(", 
    RowBox[{"dx", "+", 
     RowBox[{"\[ImaginaryI]", " ", "dy"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.4186594470059958`*^9, 3.418659461722193*^9}, {
  3.4186595174076366`*^9, 3.418659548100149*^9}}],

Cell["\<\
and then examine the phase of that relatively simple function:\
\>", "Text",
 CellChangeTimes->{{3.418660152989292*^9, 3.418660160948394*^9}, {
  3.418660238559914*^9, 3.4186602472473516`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Arg", "[", 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"dx", ",", "dy", ",", ".5", ",", ".5", ",", ".5"}], "]"}], "]"}],
    ",", 
   RowBox[{"{", 
    RowBox[{"dx", ",", 
     RowBox[{"-", ".1"}], ",", ".1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"dy", ",", 
     RowBox[{"-", ".1"}], ",", ".1"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], ",", " ", 
   RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", " ", 
   RowBox[{"Ticks", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", 
     RowBox[{
     "\"\<Close-up  Detail of the Phase Singularity\>\"", ",", "Bold", ",", 
      "Red"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.418659632158607*^9, 3.418659680678397*^9}, {
  3.418672904263061*^9, 3.4186729254075003`*^9}, {3.418682509043977*^9, 
  3.418682533919106*^9}}],

