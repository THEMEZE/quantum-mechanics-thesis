 CellChangeTimes->{{3.417804884444412*^9, 3.417804898393997*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"LocalPhase", "[", 
   RowBox[{"dx_", ",", "dy_", ",", "t_"}], "]"}], ":=", 
