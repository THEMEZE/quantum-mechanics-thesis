        RowBox[{"\[CapitalPsi]star", ",", "x"}], "]"}]}]}], ")"}]}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["J", "y"], "=", 
  RowBox[{
   RowBox[{
    FractionBox["\[HBar]", 
     RowBox[{"2", "m", " ", "\[ImaginaryI]"}]], 
