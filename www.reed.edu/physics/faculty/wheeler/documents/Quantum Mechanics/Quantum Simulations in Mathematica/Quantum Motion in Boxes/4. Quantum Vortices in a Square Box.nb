Cell["Looking here only to the first of those, we have", "Text",
 CellChangeTimes->{{3.418733979184689*^9, 3.4187339894163103`*^9}, {
  3.4187340199185534`*^9, 3.418734020142521*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"\[Psi]2", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "3"], "+", "dx"}], ",", 
     RowBox[{
      FractionBox["1", "3"], "+", "dy"}], ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"dx", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"dy", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.417804490946665*^9, 3.417804521887105*^9}, {
   3.41780471215137*^9, 3.417804744275189*^9}, 3.41780490616195*^9, {
   3.417804959982532*^9, 3.417804965477556*^9}, 3.417805023938637*^9, {
   3.418734040435721*^9, 3.418734042600835*^9}}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"(", 
    InterpretationBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"3", " ", "\[ImaginaryI]", " ", 
        SqrtBox[
         FractionBox["3", "2"]], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "10"}], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", "\[Pi]", " ", 
        "dy"}]}], "+", 
      InterpretationBox[
       SuperscriptBox[
        RowBox[{"O", "[", "dy", "]"}], "2"],
       SeriesData[$CellContext`dy, 0, {}, 1, 2, 1],
       Editable->False]}],
     SeriesData[$CellContext`dy, 0, {
      Complex[0, -3] Rational[3, 2]^Rational[1, 2] 
       E^(Complex[0, -10] Pi^2 $CellContext`t) Pi}, 1, 2, 1],
     Editable->False], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           SqrtBox[
            FractionBox["3", "2"]], " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "10"}], " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", "\[Pi]"}], 
          ")"}]}]}], "-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"3", " ", "\[ImaginaryI]"}]}], ")"}], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "10"}], " ", "\[ImaginaryI]", " ", 
           SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
         SuperscriptBox["\[Pi]", "2"], " ", "dy"}], 
        SqrtBox["2"]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "dy", "]"}], "2"],
        SeriesData[$CellContext`dy, 0, {}, 0, 2, 1],
        Editable->False]}],
      SeriesData[$CellContext`dy, 
       0, {(-3) Rational[3, 2]^Rational[1, 2] 
        E^(Complex[0, -10] Pi^2 $CellContext`t) Pi, Complex[-3, -3] 
        2^Rational[-1, 2] E^(Complex[0, -10] Pi^2 $CellContext`t) Pi^2}, 0, 2,
        1],
      Editable->False], ")"}], " ", "dx"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "dx", "]"}], "2"],
    SeriesData[$CellContext`dx, 0, {}, 0, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`dx, 0, {
    SeriesData[$CellContext`dy, 0, {
     Complex[0, -3] Rational[3, 2]^Rational[1, 2] 
      E^(Complex[0, -10] Pi^2 $CellContext`t) Pi}, 1, 2, 1], 
    SeriesData[$CellContext`dy, 
     0, {(-3) Rational[3, 2]^Rational[1, 2] 
      E^(Complex[0, -10] Pi^2 $CellContext`t) Pi, Complex[-3, -3] 
      2^Rational[-1, 2] E^(Complex[0, -10] Pi^2 $CellContext`t) Pi^2}, 0, 2, 
     1]}, 0, 2, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.418734047315627*^9, 3.568661473662786*^9}]
}, Open  ]],

