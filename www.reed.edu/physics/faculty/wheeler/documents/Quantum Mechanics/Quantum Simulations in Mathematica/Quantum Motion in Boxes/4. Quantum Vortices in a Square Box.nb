Cell["\<\
be a solution of the Schr\[ODoubleDot]dinger equation that depends upon \
certain parameters {\[Alpha], \[Beta], ...}. Then (by linearity)\
\>", "Text",
 CellChangeTimes->{{3.417453299267584*^9, 3.417453356741261*^9}, {
  3.4185762768502693`*^9, 3.418576277597966*^9}, {3.4185763692911663`*^9, 
  3.4185763737843227`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[CapitalPsi]", "mn"], "[", 
   RowBox[{"x", ",", "y", ",", "t", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}], 
  "=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SubscriptBox["\[PartialD]", "\[Alpha]"], ")"}], "m"], 
   SuperscriptBox[
    RowBox[{"(", 
     SubscriptBox["\[PartialD]", "\[Beta]"], ")"}], "n"], 
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"x", ",", "y", ",", "t", ",", "\[Alpha]", ",", "\[Beta]"}], 
    "]"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.417453372301364*^9, 3.4174534465388517`*^9}, 
   3.417453485238508*^9}],

Cell[TextData[{
 "is also a solution. So are all real/complex linear combinations of such \
functions. Note, however, that functions produced in this way will, in \
general, not mimic the boundary conditions satisfied by the mother function \
",
 StyleBox["\[CapitalPsi]", "Output"],
 ". Nor will they, in general, be normalized. "
}], "Text",
 CellChangeTimes->{{3.417453508449544*^9, 3.4174535688480263`*^9}, {
   3.417454062290012*^9, 3.417454169298841*^9}, {3.418576404024068*^9, 
   3.418576431476274*^9}, 3.418576469833941*^9}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.418576590084908*^9}],

Cell["Look, for example, to the function", "Text",
 CellChangeTimes->{{3.4185767244902477`*^9, 3.418576749728806*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[CapitalPsi]", "=", 
  RowBox[{"Exp", "[", 
   RowBox[{"\[ImaginaryI]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Alpha]", " ", "x"}], "+", 
      RowBox[{"\[Beta]", " ", "y"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[Alpha]", "2"], "+", 
         SuperscriptBox["\[Beta]", "2"]}], ")"}], " ", "t"}]}], ")"}]}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", " ", "\[Alpha]"}], "+", 
     RowBox[{"y", " ", "\[Beta]"}], "-", 
     RowBox[{"t", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Alpha]", "2"], "+", 
        SuperscriptBox["\[Beta]", "2"]}], ")"}]}]}], ")"}]}]]], "Output",
 CellChangeTimes->{3.418576607511235*^9, 3.418603991544198*^9, 
  3.418672460930867*^9, 3.5686613665220547`*^9}]
}, Open  ]],

Cell["\<\
which clearly does satisfy the free-particle Schr\[ODoubleDot]dinger equation:\
\>", "Text",
 CellChangeTimes->{{3.418576763353715*^9, 3.418576835931424*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    RowBox[{"D", "[", 
     RowBox[{"\[CapitalPsi]", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "-", 
   RowBox[{"D", "[", 
    RowBox[{"\[CapitalPsi]", ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "2"}], "}"}]}], "]"}], "-", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"D", "[", 
     RowBox[{"\[CapitalPsi]", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "1"}], "}"}]}], "]"}]}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.41745372722429*^9, 3.4174537968607903`*^9}, {
  3.417453833147834*^9, 3.417453843161677*^9}}],

