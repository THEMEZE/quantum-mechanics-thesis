Cell["\<\
As previously remarked, we expect the singular point to be a point at which \
the phase of the wave function\
\>", "Text",
 CellChangeTimes->{{3.4186581965938463`*^9, 3.41865825098555*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPsi]\[CapitalPsi]", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_", ",", "\[Alpha]_", ",", "\[Beta]_"}], 
   "]"}], ":=", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", " ", "\[Alpha]"}], "+", 
       RowBox[{"y", " ", "\[Beta]"}], "-", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Alpha]", "2"], "+", 
          SuperscriptBox["\[Beta]", "2"]}], ")"}]}]}], ")"}]}]], " ", 
   RowBox[{"(", 
    RowBox[{"x", "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{"y", "+", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "t", " ", "\[Alpha]"}], "-", 
        RowBox[{"2", " ", "t", " ", "\[Beta]"}]}], ")"}]}]}], 
    ")"}]}]}]], "Input"],

Cell["\<\
becomes undifferentiable. The close relationship between the vorticity and \
phase singularities is illustrated in the following sequence of paired \
figures \
\>", "Text",
 CellChangeTimes->{{3.418658320799725*^9, 3.418658384401642*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"\[CapitalOmega]\[CapitalOmega]", "[", 
    RowBox[{"x", ",", "y", ",", "0", ",", "0", ",", "0"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
