Cell["\<\
To produce motion\[LongDash]which in quantum mechanics is an interference \
effect\[LongDash]one must take such functions in (normalized) linear \
combination. In the simplest instance we have constructs of the form\
\>", "Text",
 CellChangeTimes->{{3.418665456910383*^9, 3.418665480162304*^9}, {
  3.4186656344832363`*^9, 3.418665685261076*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"\[CapitalPsi]", ",", "\[Mu]", ",", "\[Phi]"}], "]"}]], "Input",
 CellChangeTimes->{{3.4186659417744217`*^9, 3.418665946264223*^9}, {
  3.41867439729427*^9, 3.418674402311988*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_", ",", "\[Mu]_", ",", "\[Phi]_"}], "]"}],
   ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Mu]", "]"}], 
    RowBox[{"F21", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "+", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], 
    RowBox[{"Sin", "[", "\[Mu]", "]"}], 
    RowBox[{"F12", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.418665698936522*^9, 3.4186658587228413`*^9}, {
  3.418666108102606*^9, 3.418666110239129*^9}, {3.4186743692115602`*^9, 
  3.4186743772535963`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[CapitalPsi]", "[", 
  RowBox[{"x", ",", "y", ",", "t", ",", "\[Mu]", ",", "\[Phi]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.418665964960287*^9, 3.418665971626371*^9}, {
  3.418674381453498*^9, 3.4186743822345343`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "5"}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
   RowBox[{"Cos", "[", "\[Mu]", "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "\[Pi]", " ", "x"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "y"}], "]"}]}], "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "5"}], " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", "t"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]}]], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "\[Pi]", " ", "y"}], "]"}], " ", 
