       SuperscriptBox[
        SubscriptBox["\[PartialD]", "y"], "2"]}]}], ")"}]}], "\[Psi]"}], "=", 
  
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], "\[Psi]"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.418576033990489*^9, 3.418576098003338*^9}}],

Cell[TextData[StyleBox["I have need now of this",
