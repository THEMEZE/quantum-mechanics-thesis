Cell[TextData[{
 "Generally, ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalE]", "n"], "=", 
   RowBox[{
    SuperscriptBox["n", "2"], 
    SuperscriptBox["\[Pi]", "2"]}]}]],
  CellChangeTimes->{{3.4186611104676733`*^9, 3.418661125295545*^9}}],
 " so the buzzing eigenfunctions (solutions of the time-dependent ",
 "Schr\[ODoubleDot]dinger equation",
 ") are"
}], "Text",
 CellChangeTimes->{{3.418661098289193*^9, 3.4186610998907137`*^9}, {
  3.418661140819173*^9, 3.4186611970448647`*^9}}],

