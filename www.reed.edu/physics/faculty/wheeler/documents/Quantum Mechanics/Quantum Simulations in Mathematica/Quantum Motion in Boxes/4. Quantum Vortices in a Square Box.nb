Cell[CellGroupData[{

Cell["\<\
Energy eigenfunctions for the two-dimensional square well of infinite depth\
\>", "Subsection",
 CellChangeTimes->{{3.4186617119124517`*^9, 3.418661712812943*^9}}],

Cell["\<\
The system separates into two copies of the system just studied, so we are \
led immediately to the buzzing normalized eigenfunctions\
\>", "Text",
 CellChangeTimes->{{3.418664306003339*^9, 3.418664372614498*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"F11", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"f1", "[", "x", "]"}], 
   RowBox[{"f1", "[", "y", "]"}], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     SuperscriptBox["\[Pi]", "2"], 
     RowBox[{"(", 
