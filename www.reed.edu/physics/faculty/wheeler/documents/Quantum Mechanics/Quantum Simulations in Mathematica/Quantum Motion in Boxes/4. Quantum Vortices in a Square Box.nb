Cell[CellGroupData[{

Cell["\<\
Energy eigenfunctions for the one-dimensional square well of infinite depth\
\>", "Subsection",
 CellChangeTimes->{{3.4186603688223248`*^9, 3.418660420020974*^9}}],

Cell["\<\
We seek normalized solutions of the time-independent Schr\[ODoubleDot]dinger \
equation\
\>", "Text",
 CellChangeTimes->{{3.418660511975828*^9, 3.41866052201416*^9}, {
  3.418660558023985*^9, 3.418660574595189*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[PartialD]", "x"], "2"], 
    RowBox[{"\[Psi]", "[", "x", "]"}]}]}], "=", 
  RowBox[{"\[ScriptCapitalE]", "  ", 
   RowBox[{"\[Psi]", "[", "x", "]"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.418660583057055*^9, 3.418660677764805*^9}}],

Cell["that conform to the boundary conditions", "Text",
 CellChangeTimes->{{3.418660740957177*^9, 3.4186607547200317`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", "0", "]"}], "=", 
  RowBox[{
   RowBox[{"\[Psi]", "[", "1", "]"}], "=", "0"}]}]], "DisplayFormula",
 CellChangeTimes->{{3.41866077004705*^9, 3.4186607792726793`*^9}}],

Cell["We are led to the functions", "Text",
 CellChangeTimes->{{3.418660832467677*^9, 3.4186608409707613`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "[", "x_", "]"}], ":=", 
  RowBox[{
   SqrtBox["2"], 
   RowBox[{"Sin", "[", 
    RowBox[{"1", "\[Pi]", " ", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "[", "x_", "]"}], ":=", 
  RowBox[{
   SqrtBox["2"], 
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Pi]", " ", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f3", "[", "x_", "]"}], ":=", 
  RowBox[{
   SqrtBox["2"], 
   RowBox[{"Sin", "[", 
    RowBox[{"3", "\[Pi]", " ", "x"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.416917552268627*^9, 3.4169176220501823`*^9}, {
  3.417480688924155*^9, 3.41748069207821*^9}}],

Cell["and their higher order relatives. ", "Text",
