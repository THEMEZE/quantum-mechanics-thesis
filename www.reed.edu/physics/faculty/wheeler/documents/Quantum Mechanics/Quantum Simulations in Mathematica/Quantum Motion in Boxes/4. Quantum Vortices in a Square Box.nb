     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "100"}], ",", "100"}], "}"}]}], ",", " ", 
   RowBox[{"Ticks", "\[Rule]", "False"}], ",", " ", 
   RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", " ", 
