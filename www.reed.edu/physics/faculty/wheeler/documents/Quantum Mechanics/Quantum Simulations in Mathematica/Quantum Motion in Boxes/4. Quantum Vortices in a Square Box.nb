       RowBox[{"F12", "[", 
        RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", "x"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"F12", "[", 
      RowBox[{"x", ",", "y", ",", "t"}], "]"}], 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"CompConj", "[", 
        RowBox[{"F12", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}], "]"}], ",", "x"}], 
      "]"}]}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"-", "\[ImaginaryI]"}], 
