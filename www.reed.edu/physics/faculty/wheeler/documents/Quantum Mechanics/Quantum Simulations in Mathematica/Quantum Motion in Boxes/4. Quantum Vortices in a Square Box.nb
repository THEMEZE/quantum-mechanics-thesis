   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", " ", "\[Alpha]"}], "+", 
      RowBox[{"y", " ", "\[Beta]"}], "-", 
      RowBox[{"t", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[Alpha]", "2"], "+", 
         SuperscriptBox["\[Beta]", "2"]}], ")"}]}]}], ")"}]}]], " ", 
  RowBox[{"(", 
   RowBox[{"x", "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{"y", "+", 
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "t", " ", "\[Alpha]"}], "-", 
       RowBox[{"2", " ", "t", " ", "\[Beta]"}]}], ")"}]}]}], 
   ")"}]}]], "Output",
 CellChangeTimes->{3.4186042118734007`*^9, 3.568661369479546*^9}]
}, Open  ]],

