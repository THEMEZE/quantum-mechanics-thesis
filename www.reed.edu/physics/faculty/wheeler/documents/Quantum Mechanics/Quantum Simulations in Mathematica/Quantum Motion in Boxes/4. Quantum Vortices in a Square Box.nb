Cell["\<\
has the physical dimension of a \"velocity.\" It was shown above that\
\>", "Text",
 CellChangeTimes->{{3.418574165173839*^9, 3.418574217156817*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"quantum", " ", "mechanical", " ", "velocity", " ", "field"}], " ",
    "\[Congruent]", " ", 
   FractionBox[
    RowBox[{"probability", " ", "currrent"}], 
    RowBox[{"probability", " ", "density"}]]}], "=", 
  RowBox[{
   FractionBox["1", "m"], 
   RowBox[{"Grad", "[", "S", "]"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.418574227973907*^9, 3.418574315161972*^9}, 
   3.418574417071101*^9}],

Cell["Exists except ", "Text",
 CellChangeTimes->{{3.417451902436017*^9, 3.417451940069683*^9}, {
   3.417451979891233*^9, 3.4174521115236063`*^9}, {3.417452267476343*^9, 
   3.4174523115026083`*^9}, 3.418574714711379*^9}],

Cell["The velocity field", "Text",
 CellChangeTimes->{{3.4185745137499237`*^9, 3.418574524961605*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       SubscriptBox["V", "x"], "[", 
       RowBox[{"x", ",", "y", ",", "t"}], "]"}]},
     {
      RowBox[{
       SubscriptBox["V", "y"], "[", 
       RowBox[{"x", ",", "y", ",", "t"}], "]"}]}
    }], "\[NoBreak]", ")"}], "=", 
  RowBox[{
   FractionBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{
         SubscriptBox["J", "x"], "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}]},
       {
        RowBox[{
         SubscriptBox["J", "y"], "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}]}
      }], "\[NoBreak]", ")"}], 
    RowBox[{"P", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]], "=", 
   RowBox[{
    FractionBox["1", "m"], 
    RowBox[{"Grad", "[", "S", "]"}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.4185745541013803`*^9, 3.418574634240838*^9}, {
  3.418574664983241*^9, 3.418574670758239*^9}, {3.418574812061778*^9, 
  3.418574828203642*^9}}],

Cell[TextData[{
 "exists except where the probability density ",
 StyleBox["P[x,y,z,t]", "Output"],
 " vanishes (which is to say: where \[CapitalPsi]",
 StyleBox["[x,y,z,t]", "Output"],
 " vanishes), and might exist even at such points if  J",
 StyleBox["[x,y,z,t] ", "Output"],
 "happened also to vanish in just the right way. At those points the phase \
must be undifferentiable (discontinuous)."
}], "Text",
 CellChangeTimes->{{3.418574677922181*^9, 3.418574687607469*^9}, {
  3.418574720936082*^9, 3.4185747280221987`*^9}, {3.418574774111809*^9, 
  3.418574779170444*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.418574877951685*^9}],

Cell["\<\
In fluid dynamics (see \[Section]1.2\[LongDash]\"Rotation and Vorticity\"\
\[LongDash]pages 19-31 in A. J. Chorin & J. E. Marsden, A Mathematical \
Introduction to Fluid Mechanics (2nd edition, 1990)) the vector-valued field \
produced by constructing the curl of a velocity field is called the \
\"vorticity\": \
\>", "Text",
 CellChangeTimes->{{3.418574885200459*^9, 3.418574885771036*^9}, {
  3.418575017443143*^9, 3.4185750731520987`*^9}, {3.418575107829928*^9, 
  3.4185753211775007`*^9}}],

Cell[BoxData[
 RowBox[{"\[CapitalOmega]", "=", 
  RowBox[{"Curl", "[", "V", "]"}]}]], "DisplayFormula",
 CellChangeTimes->{{3.41857532993469*^9, 3.4185753393612947`*^9}}],

Cell["For the \"quantum mechanical probability fluid\" one has", "Text",
 CellChangeTimes->{{3.4185753760633183`*^9, 3.4185753965559053`*^9}}],

Cell[BoxData[
 RowBox[{"\[CapitalOmega]", "=", 
  RowBox[{
   RowBox[{
    FractionBox["1", "m"], 
    RowBox[{"Curl", "[", " ", 
     RowBox[{"Grad", "[", "S", "]"}], "]"}]}], "=", "0"}]}]], "DisplayFormula",\

 CellChangeTimes->{{3.41857543513544*^9, 3.4185754895285788`*^9}}],

Cell[TextData[{
 "except at singular points (points where phase discontinuities cause  ",
 StyleBox["Grad[S]", "Output"],
 "  to be undefined)."
}], "Text",
 CellChangeTimes->{{3.418575558746125*^9, 3.418575569329318*^9}, {
  3.418575611518765*^9, 3.418575644245124*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.4185757644423*^9}]
}, Open  ]],

