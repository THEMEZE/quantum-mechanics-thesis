  RowBox[{"4.`*^-8", "-", 
   RowBox[{"4.`*^-8", " ", "y", " ", "\[Alpha]"}], "+", 
   RowBox[{"4.`*^-8", " ", "x", " ", "\[Beta]"}]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1.`*^-8", "+", 
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"], "-", 
     RowBox[{"4.`", " ", "t", " ", "x", " ", "\[Alpha]"}], "+", 
     RowBox[{"4.`", " ", 
      SuperscriptBox["t", "2"], " ", 
      SuperscriptBox["\[Alpha]", "2"]}], "-", 
     RowBox[{"4.`", " ", "t", " ", "y", " ", "\[Beta]"}], "+", 
     RowBox[{"4.`", " ", 
      SuperscriptBox["t", "2"], " ", 
      SuperscriptBox["\[Beta]", "2"]}]}], ")"}], "2"]]], "Output",
 CellChangeTimes->{{3.418649930376873*^9, 3.4186499404323587`*^9}, 
   3.418656441399008*^9, 3.418657079516535*^9, 3.418658088977426*^9, 
   3.418672601701874*^9, 3.568661371037786*^9}]
}, Open  ]],

Cell["to the definition", "Text",
 CellChangeTimes->{{3.418657753065927*^9, 3.4186577556317997`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]\[CapitalOmega]", "[", 
   RowBox[{
   "x_", ",", "y_", ",", "t_", " ", ",", "\[Alpha]_", ",", "\[Beta]_"}], 
   "]"}], ":=", 
  FractionBox[
   RowBox[{"4.`*^-8", "-", 
    RowBox[{"4.`*^-8", " ", "y", " ", "\[Alpha]"}], "+", 
    RowBox[{"4.`*^-8", " ", "x", " ", "\[Beta]"}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1.`*^-8", "+", 
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["y", "2"], "-", 
      RowBox[{"4.`", " ", "t", " ", "x", " ", "\[Alpha]"}], "+", 
      RowBox[{"4.`", " ", 
       SuperscriptBox["t", "2"], " ", 
       SuperscriptBox["\[Alpha]", "2"]}], "-", 
      RowBox[{"4.`", " ", "t", " ", "y", " ", "\[Beta]"}], "+", 
      RowBox[{"4.`", " ", 
       SuperscriptBox["t", "2"], " ", 
       SuperscriptBox["\[Beta]", "2"]}]}], ")"}], "2"]]}]], "Input",
 CellChangeTimes->{{3.418605559953896*^9, 3.4186055684390783`*^9}, 
   3.418649959028167*^9, {3.4186561367048883`*^9, 3.4186563106993237`*^9}, 
   3.418656483270924*^9, 3.418657108607192*^9, 3.4186581025076733`*^9}],

Cell["\<\
This function has a large value at the singularity (located at the origin of \
the {x,y}-plane when t = \[Alpha] = \[Beta] =0)\
\>", "Text",
 CellChangeTimes->{{3.418657776689979*^9, 3.4186578390354033`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[CapitalOmega]\[CapitalOmega]", "[", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}]], "Input",
 CellChangeTimes->{
  3.418657866875867*^9, {3.418657914452817*^9, 3.4186579161442003`*^9}}],

Cell[BoxData["3.9999999999999994`*^8"], "Output",
 CellChangeTimes->{3.418657870433731*^9, 3.4186579195073557`*^9, 
  3.418658125081259*^9, 3.4186726196372557`*^9, 3.568661371117092*^9}]
}, Open  ]],

Cell["but falls to very small values at close-by points", "Text",
 CellChangeTimes->{{3.418657933326871*^9, 3.4186579565075397`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[CapitalOmega]\[CapitalOmega]", "[", 
  RowBox[{"0.01", ",", "0.01", ",", "0", ",", "0", ",", "0"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalOmega]\[CapitalOmega]", "[", 
  RowBox[{"0.1", ",", "0.1", ",", "0", ",", "0", ",", "0"}], "]"}]}], "Input",\

 CellChangeTimes->{{3.4186580002730007`*^9, 3.418658021925556*^9}, {
  3.4186726336050453`*^9, 3.41867264233117*^9}}],

