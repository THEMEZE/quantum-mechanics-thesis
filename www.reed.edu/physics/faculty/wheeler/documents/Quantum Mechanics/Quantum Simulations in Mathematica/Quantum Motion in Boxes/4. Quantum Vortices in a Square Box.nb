Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.4186892049581537`*^9}],

Cell[TextData[StyleBox["SECOND EXAMPLE", "Subsubsection"]], "Text",
 CellChangeTimes->{{3.4186892153870773`*^9, 3.418689219183977*^9}}],

Cell["Here, following again in the steps of MPF, I use", "Text",
 CellChangeTimes->{{3.418733554870716*^9, 3.418733576738139*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Cos", "[", 
  FractionBox["\[Pi]", "4"], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"\[Pi]", "/", "2"}]}]], 
  RowBox[{"Sin", "[", 
   FractionBox["\[Pi]", "4"], "]"}]}]}], "Input",
 CellChangeTimes->{{3.417801215364654*^9, 3.417801222784479*^9}, {
  3.418733597482596*^9, 3.418733597915186*^9}}],

Cell[BoxData[
 FractionBox["1", 
  SqrtBox["2"]]], "Output",
 CellChangeTimes->{3.418733603237945*^9, 3.568661454310025*^9}],

Cell[BoxData[
 FractionBox["\[ImaginaryI]", 
  SqrtBox["2"]]], "Output",
 CellChangeTimes->{3.418733603237945*^9, 3.5686614543172398`*^9}]
}, Open  ]],

Cell["to assemble", "Text",
 CellChangeTimes->{{3.418733612245858*^9, 3.418733614071741*^9}, {
  3.4187336727243967`*^9, 3.418733674419958*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]2", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"F31", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "+", 
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     SqrtBox["2"]], 
    RowBox[{"F13", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.4175249964627953`*^9, 3.417525080372241*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]2", "[", 
  RowBox[{"x", ",", "y", ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.4178016216931477`*^9, 3.417801626004221*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox["2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "10"}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"3", " ", "\[Pi]", " ", "x"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "y"}], "]"}]}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   SqrtBox["2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "10"}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"3", " ", "\[Pi]", " ", "y"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.418689294528097*^9, 3.4187332731274776`*^9, 
  3.568661454406986*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]2star", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    SqrtBox["2"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"+", "10"}], " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "\[Pi]", " ", "x"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "y"}], "]"}]}], "-", 
   RowBox[{"\[ImaginaryI]", " ", 
    SqrtBox["2"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"+", "10"}], " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "\[Pi]", " ", "y"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.417801645326715*^9, 3.417801681956621*^9}}],

Cell["\<\
Proceeding now through the familiar sequence of constructions\[Ellipsis]\
\>", "Text",
 CellChangeTimes->{{3.4187336362385197`*^9, 3.41873366652709*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]2star", "[", 
    RowBox[{"x", ",", "y", ",", "0"}], "]"}], 
   RowBox[{"\[Psi]2", "[", 
    RowBox[{"x", ",", "y", ",", "0"}], "]"}]}], "//", 
  "ComplexExpand"}]], "Input",
 CellChangeTimes->{{3.417525210500143*^9, 3.417525254225754*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "\[Pi]", " ", "x"}], "]"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "y"}], "]"}], "2"]}], "+", 
  RowBox[{"2", " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
