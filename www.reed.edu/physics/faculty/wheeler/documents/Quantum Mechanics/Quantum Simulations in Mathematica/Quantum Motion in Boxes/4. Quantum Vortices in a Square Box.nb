Cell["\<\
where \[Mu] is a \"mixing angle\" and \[Phi] a \"relative phase\" factor. For \
no better reason than to achieve agreement with MPF I set\
\>", "Text",
 CellChangeTimes->{{3.418665877415159*^9, 3.418665909135229*^9}, {
  3.4186660202435417`*^9, 3.418666031295706*^9}, {3.41866615415839*^9, 
