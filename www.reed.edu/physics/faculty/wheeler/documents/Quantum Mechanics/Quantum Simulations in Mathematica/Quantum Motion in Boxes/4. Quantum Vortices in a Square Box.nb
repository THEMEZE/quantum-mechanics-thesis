     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["1", "2"], "+", 
       SuperscriptBox["3", "2"]}], ")"}], "t"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F21", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
