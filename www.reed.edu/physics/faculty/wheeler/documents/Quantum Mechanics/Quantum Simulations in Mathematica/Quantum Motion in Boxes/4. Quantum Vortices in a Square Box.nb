Cell[TextData[StyleBox["THIRD EXAMPLE", "Subsubsection"]], "Text",
 CellChangeTimes->{{3.4187346854780684`*^9, 3.418734687516961*^9}}],

Cell["\<\
MPF's final example uses coefficients borrowed from the 2nd example to \
assemble\
\>", "Text",
 CellChangeTimes->{{3.41873484934795*^9, 3.418734888040474*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]3", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    RowBox[{"F31", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "+", 
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     SqrtBox["2"]], 
    RowBox[{"F12", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.4175249964627953`*^9, 3.417525080372241*^9}, {
  3.418735020689005*^9, 3.418735029053329*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]3", "[", 
  RowBox[{"x", ",", "y", ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{3.418735051315731*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SqrtBox["2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "10"}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"3", " ", "\[Pi]", " ", "x"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "y"}], "]"}]}], "+", 
  RowBox[{"\[ImaginaryI]", " ", 
   SqrtBox["2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "5"}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", "t"}]], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "\[Pi]", " ", "y"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.418735055538394*^9, 3.568661474042316*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]3star", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
