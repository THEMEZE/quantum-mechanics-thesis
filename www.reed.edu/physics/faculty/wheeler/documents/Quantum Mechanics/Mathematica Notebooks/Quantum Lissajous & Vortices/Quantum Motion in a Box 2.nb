Cell["\<\
The following commands permit one to construct unlimitedly many slightly \
de-tuned instances of the simplest kind of Lissajous figures\[LongDash]those \
in which right/left and up/down traversals occur with the same (or nearly the \
same) period:\
\>", "Text",
 CellChangeTimes->{{3.417121726048036*^9, 3.4171217625287743`*^9}, {
  3.417121841020288*^9, 3.417121927398012*^9}, {3.417130144934813*^9, 
  3.417130149716146*^9}, {3.4171869443860397`*^9, 3.417186948767404*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"X", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x0", " ", "\[Rule]", 
      RowBox[{"RandomReal", "[", "]"}]}], ",", " ", 
     RowBox[{"v", " ", "\[Rule]", "1"}]}], "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{"Y", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x0", " ", "\[Rule]", 
      RowBox[{"RandomReal", "[", "]"}]}], ",", " ", 
     RowBox[{"v", " ", "\[Rule]", "1.005"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", "[", "t", "]"}], ",", 
       RowBox[{"Y", "[", "t", "]"}]}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "30"}], "}"}], ",", 
    RowBox[{"GridLines", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"Ticks", "\[Rule]", "False"}], ",", " ", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], ",", " ", 
    RowBox[{"LabelStyle", "\[Rule]", "Large"}]}], "]"}], " "}]}], "Input",
 CellChangeTimes->{{3.4171216107655983`*^9, 3.417121616116976*^9}, {
   3.4171216734529247`*^9, 3.4171216797125177`*^9}, {3.417121962322969*^9, 
   3.417121962917819*^9}, 3.417130217213683*^9, 3.4171302474676456`*^9}],

