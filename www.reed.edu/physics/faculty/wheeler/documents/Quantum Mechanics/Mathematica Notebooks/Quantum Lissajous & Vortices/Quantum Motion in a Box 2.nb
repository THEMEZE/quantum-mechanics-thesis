Cell["\<\
An excellent approxiation to such a figure\[LongDash]viewed simply as a \
mathematical object\[LongDash]could be produced by much simpler means:\
\>", "Text",
 CellChangeTimes->{{3.4281759846917477`*^9, 3.428176049121233*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ApproximatingSimpleLissajous", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{".5", "+", 
       RowBox[{".175", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"2", "\[Pi]"}], "7"], "t"}], "]"}]}]}], ",", 
      RowBox[{".5", "+", 
       RowBox[{".175", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"2", "\[Pi]"}], "3"], "t"}], "]"}]}]}]}], "}"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "21"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}]], "Input",
