Cell["\<\
in which the time variable enters (via cross terms\[LongDash]interference \
terms) with the following factors: \
\>", "Text",
 CellChangeTimes->{{3.428112976329301*^9, 3.428113036335531*^9}, 
   3.428175775947838*^9, {3.428175808292842*^9, 3.428175819044738*^9}}],

