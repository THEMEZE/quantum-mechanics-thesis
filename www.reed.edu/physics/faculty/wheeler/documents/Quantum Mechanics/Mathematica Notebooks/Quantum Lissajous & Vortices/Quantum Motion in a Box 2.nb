Cell["\<\
The motion appears to be \"Lissajous-like\" only in some very soft sense. But \
the situation gains sharpness when one looks to the  motion of the expected \
position of the quantum particle:\
\>", "Text",
 CellChangeTimes->{{3.428171113039233*^9, 3.428171222728826*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExpPositionData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], 
        RowBox[{"P", "[", 
         RowBox[{"x", ",", "y", ",", 
          FractionBox["n", "20"]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "100"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.4281526187464657`*^9, 3.428152630745885*^9}, {
  3.428152691797708*^9, 3.428152732250368*^9}, {3.428152978726509*^9, 
  3.4281530382635736`*^9}, {3.428153326801733*^9, 3.428153335481721*^9}, {
  3.4281534290546217`*^9, 3.428153435551722*^9}, {3.4281535070470753`*^9, 
  3.428153514697551*^9}, {3.42815356022439*^9, 3.4281535733488703`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuantumOrbit", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"ExpPositionData", ",", 
    RowBox[{"Joined", "\[Rule]", "True"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "\[Rule]", "\"\<\!\(\*
StyleBox[\"Orbit\",
FontSize->14,
