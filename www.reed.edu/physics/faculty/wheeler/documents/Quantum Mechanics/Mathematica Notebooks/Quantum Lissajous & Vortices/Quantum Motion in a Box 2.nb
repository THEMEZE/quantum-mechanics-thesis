Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.42817535012144*^9}],

Cell["\<\
I turn now to the construction of a quantum state that executes a \"soft\" \
Lissajous figure. It proceeds from the assumption that x and y are \
independent random variables. From\
\>", "Text",
 CellChangeTimes->{{3.428108307812566*^9, 3.42810836060183*^9}, 
   3.428175337805711*^9, {3.428175499463627*^9, 3.428175517527495*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "x", "]"}]], "Input",
 CellChangeTimes->{{3.428108817548072*^9, 3.428108819675375*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]x", "[", 
   RowBox[{"x_", ",", "t_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Alpha]", "]"}], 
    SqrtBox["2"], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "1", " ", "x"}], "]"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      SuperscriptBox["1", "2"], "t"}]]}], "+", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Alpha]", "]"}], 
    SqrtBox["2"], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "2", " ", "x"}], "]"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      SuperscriptBox["2", "2"], "t"}]]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]y", "[", 
   RowBox[{"y_", ",", "t_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Beta]", "]"}], 
    SqrtBox["2"], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "3", " ", "y"}], "]"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      SuperscriptBox["3", "2"], "t"}]]}], "+", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Beta]", "]"}], 
    SqrtBox["2"], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "4", " ", "y"}], "]"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      SuperscriptBox["4", "2"], "t"}]]}]}]}]}], "Input",
 CellChangeTimes->{{3.428108369147726*^9, 3.428108419422431*^9}, {
  3.428108466138039*^9, 3.428108469831613*^9}, {3.42810856263253*^9, 
  3.428108745759659*^9}, {3.428108835209662*^9, 3.4281088494853563`*^9}, {
  3.428111865610858*^9, 3.4281118680971823`*^9}}],

Cell["\<\
(where \[Alpha] and \[Beta] are \"mixing angles\") construct\
\>", "Text",
 CellChangeTimes->{{3.428108886351121*^9, 3.4281089371312017`*^9}}],

Cell["\<\
We construct the probability density associated with \[Phi]x[x, t, \[Alpha]] \
and \
\>", "Text",
 CellChangeTimes->{{3.428111417119812*^9, 3.4281114575252123`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Px", "[", 
   RowBox[{"x_", ",", "t_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Re", "[", 
       RowBox[{"\[Phi]x", "[", 
        RowBox[{"x", ",", "t", ",", "\[Alpha]"}], "]"}], "]"}], "]"}], ")"}], 
    "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Im", "[", 
       RowBox[{"\[Phi]x", "[", 
        RowBox[{"x", ",", "t", ",", "\[Alpha]"}], "]"}], "]"}], "]"}], ")"}], 
    "2"]}]}]], "Input",
 CellChangeTimes->{{3.4281107014472303`*^9, 3.428110791927484*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TrigReduce", "[", 
  RowBox[{"Px", "[", 
   RowBox[{"x", ",", "t", ",", "\[Alpha]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.428110807643605*^9, 3.428110833949911*^9}}],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"4", "-", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "\[Pi]", " ", "x"}], "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"4", " ", "\[Pi]", " ", "x"}], "]"}]}], "-", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"2", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"4", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "-", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"2", " ", "\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"4", " ", "\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "+", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "-", 
      RowBox[{"3", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "-", 
      RowBox[{"\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "+", 
      RowBox[{"\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "+", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "+", 
      RowBox[{"3", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "-", 
      RowBox[{"3", " ", "\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "+", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "-", 
      RowBox[{"\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "+", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "+", 
      RowBox[{"\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"3", " ", "t"}], "+", 
      RowBox[{"3", " ", "\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Alpha]"}]}], "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.428110813694786*^9, 3.4281108358692636`*^9}}]
}, Open  ]],

Cell["\<\
and see that it has angular frequency\
\>", "Text",
 CellChangeTimes->{{3.428111461241612*^9, 3.428111546702483*^9}, {
   3.428169028496421*^9, 3.428169053989915*^9}, 3.428169088098394*^9}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[CapitalOmega]", "x"], "=", "3"}]], "Input",
 CellChangeTimes->{{3.4281690601510468`*^9, 3.428169068527252*^9}}],

Cell["\<\
 Experimentation leads us to set \[Alpha]  = 0.64 (in order to get a good \
clear slosh); the moving distribution looks like this:\
\>", "Text",
 CellChangeTimes->{{3.42816910222363*^9, 3.42816911376584*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Px", "[", 
      RowBox[{"x", ",", "t", ",", "0.64"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "3"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "3"]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.428169146982798*^9, 3.428169202953663*^9}}],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`t$$ = 0.006283185307179587, Typeset`show$$ =
     True, Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{
      Hold[$CellContext`t$$], 0, Rational[2, 3] Pi}}, Typeset`size$$ = {
    450., {143., 150.}}, Typeset`update$$ = 0, Typeset`initDone$$, 
