Cell["\<\
A description of the motion of a free particle trapped within a 2-dimensional \
box is obtained by forming the tensor product of the preceding construction: \
\
\>", "Text",
 CellChangeTimes->{{3.428107462792351*^9, 3.428107523820405*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"X", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x0", " ", "\[Rule]", " ", ".4"}], ",", " ", 
     RowBox[{"v", " ", "\[Rule]", " ", "1"}]}], "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{"Y", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x0", " ", "\[Rule]", " ", "0"}], ",", " ", 
     RowBox[{"v", " ", "\[Rule]", " ", "3"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", "[", "t", "]"}], ",", 
       RowBox[{"Y", "[", "t", "]"}]}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
    RowBox[{"GridLines", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "1", "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"Ticks", "\[Rule]", "False"}], ",", " ", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], ",", " ", 
    RowBox[{"LabelStyle", "\[Rule]", "Large"}]}], "]"}], " "}]}], "Input",
 CellChangeTimes->{{3.417096220642892*^9, 3.417096241690468*^9}, {
  3.4171867715232553`*^9, 3.4171867743159323`*^9}}],

