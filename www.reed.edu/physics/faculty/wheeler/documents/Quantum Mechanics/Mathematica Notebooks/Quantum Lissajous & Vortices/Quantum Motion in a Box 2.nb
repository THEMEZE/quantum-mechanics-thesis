  3.427846911746355*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"CompConj", "[", "A_", "]"}], " ", ":=", " ", 
  RowBox[{"A", " ", "/.", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{"Complex", "[", 
     RowBox[{"0", ",", "n_"}], "]"}], "->", 
    RowBox[{"-", 
     RowBox[{"Complex", "[", 
      RowBox[{"0", ",", "n"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.4281793191292467`*^9, 3.428179335563093*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.427638270622589*^9}],

Cell[CellGroupData[{

Cell["Quantum Motion of a Particle in a Box", "Title",
 CellChangeTimes->{{3.427638289012788*^9, 3.4276383037985353`*^9}}],

Cell["\<\
Nicholas Wheeler
Reed College Physics Department
18 August 2008\
\>", "Text",
 CellChangeTimes->{{3.427638310552442*^9, 3.427638326702342*^9}, 
   3.428076408067396*^9},
 FontSize->10],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.427638339742312*^9}],

Cell[CellGroupData[{

Cell["Introduction", "Subsection",
 CellChangeTimes->{{3.427638350096182*^9, 3.427638354253036*^9}}],

Cell["\<\
It is by way of preparation for discussion of \"quantum Liossajous figures\" \
and \"quantum vorticity\" that I look here to aspects\[LongDash]specifically, \
dynamics aspects\[LongDash]of the simplest and most familiar of all quantum \
mechanical systems: the \"particle-in-a-box\" problem. I work first in one \
dimension, then by straightforward generalization in two dimensions.\
\>", "Text",
 CellChangeTimes->{{3.427639507972825*^9, 3.427639725627645*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.427639746247148*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Two-dimensional theory",
 FontWeight->"Bold"]], "Subsubtitle",
 CellChangeTimes->{{3.4276397560507*^9, 3.427639764740745*^9}, {
  3.4280764185389833`*^9, 3.428076419420608*^9}}],

Cell["\<\
We redirect our attention now to properties of the solutions of\
\>", "Text",
 CellChangeTimes->{{3.427640310669792*^9, 3.427640328690339*^9}, {
  3.428076469322249*^9, 3.428076482040999*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["\[HBar]", "2"], 
     RowBox[{"2", "m"}]]}], 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], 
     RowBox[{"+", 
      SubscriptBox["\[PartialD]", 
       RowBox[{"y", ",", "y"}]]}]}], ")"}], 
   RowBox[{"\[Psi]", "[", 
    RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "=", 
  RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.427640334827813*^9, 3.427640452472559*^9}, 
   3.4276405128154716`*^9, {3.4276768886001167`*^9, 3.427676891868166*^9}, {
   3.4280764868754473`*^9, 3.428076525712512*^9}}],

Cell["that conform to the boundary conditions", "Text",
 CellChangeTimes->{{3.4276404786269217`*^9, 3.427640487698247*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"0", ",", "0", ",", "t"}], "]"}], "=", 
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"a", ",", "0", ",", "t"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Psi]", "[", 
     RowBox[{"0", ",", "a", ",", "t"}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Psi]", "[", 
      RowBox[{"a", ",", "a", ",", "t"}], "]"}], "=", 
     RowBox[{"0", "    ", ":", "    ", 
      RowBox[{"all", "  ", "t"}]}]}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.427640500919813*^9, 3.427640549028561*^9}, {
  3.42807654881467*^9, 3.4280765919562893`*^9}}],

Cell["If we adopt units in which", "Text",
 CellChangeTimes->{{3.427640818301907*^9, 3.4276408231779003`*^9}}],

Cell[BoxData[
 RowBox[{"\[HBar]", "=", 
  RowBox[{
   RowBox[{"2", "m"}], "=", 
   RowBox[{"a", "=", "1"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.427640827206102*^9, 3.427640841733309*^9}}],

Cell["we have", "Text",
 CellChangeTimes->{{3.4276408692819843`*^9, 3.4276408699777822`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], 
      RowBox[{"+", 
       SubscriptBox["\[PartialD]", 
        RowBox[{"y", ",", "y"}]]}]}], ")"}]}], 
   RowBox[{"\[Psi]", "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], "=", 
  RowBox[{"\[ImaginaryI]", "  ", 
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], " ", 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"x", ",", "t"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"0", ",", "t"}], "]"}], "=", 
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"1", ",", "t"}], "]"}], "    ", ":", "    ", 
   RowBox[{"all", "  ", "t"}]}]}]}], "DisplayFormula",
 CellChangeTimes->{{3.4276408890139523`*^9, 3.427640912845538*^9}, 
   3.428076640862585*^9}],

Cell["\<\
which is easier to work with. If we assume the wave function to have \
separated structure\
\>", "Text",
 CellChangeTimes->{{3.42764094166451*^9, 3.4276409486657467`*^9}, {
  3.427640980705662*^9, 3.4276410043137493`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"x", ",", "y", ",", "t"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "1"], "[", "x", "]"}], "*", 
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "2"], "[", "y", "]"}], "*", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
     "t"}]]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.427641023687886*^9, 3.427641047252144*^9}, 
   3.427641206549806*^9, {3.428078410362851*^9, 3.428078411205225*^9}, {
   3.428078441579027*^9, 3.428078458419064*^9}}],

Cell["and are led immediately to the orthonormal eigenfunctions", "Text",
 CellChangeTimes->{{3.427641321408271*^9, 3.427641344657391*^9}, {
  3.4276416884105253`*^9, 3.427641691073447*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", 
   RowBox[{"x_", ",", "y_", ",", "m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"2", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"m", " ", "\[Pi]", " ", "x"}], "]"}], 
   RowBox[{"Sin", "[", 
    RowBox[{"n", " ", "\[Pi]", " ", "y"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.427641354258855*^9, 3.427641421436613*^9}, {
  3.427641547855241*^9, 3.4276415520360947`*^9}, {3.4280784880663652`*^9, 
  3.428078546558466*^9}}],

