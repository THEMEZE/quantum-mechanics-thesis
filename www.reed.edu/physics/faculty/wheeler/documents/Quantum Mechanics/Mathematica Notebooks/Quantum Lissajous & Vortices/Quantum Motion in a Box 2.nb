Cell["From", "Text",
 CellChangeTimes->{{3.427646064399022*^9, 3.427646064950388*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], 
      RowBox[{"\[CapitalPsi]", "[", 
       RowBox[{"x", ",", "y", ",", "m", ",", "n"}], "]"}]}]}], "-", 
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"y", ",", "y"}]], 
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"x", ",", "y", ",", "m", ",", "n"}], "]"}]}]}], "\[Equal]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["m", "2"], "+", 
      SuperscriptBox["n", "2"]}], ")"}], " ", 
    SuperscriptBox["\[Pi]", "2"], 
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"x", ",", "y", ",", "m", ",", "n"}], "]"}]}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.427643425064548*^9, 3.427643447610077*^9}, {
   3.427643488174602*^9, 3.4276435169513702`*^9}, {3.428078953447525*^9, 
   3.428079219102376*^9}, {3.428079669102421*^9, 3.428079674522369*^9}, 
   3.428079735290963*^9}],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.4280792010775557`*^9, 3.428079220876996*^9}, 
   3.4280796775750027`*^9, 3.4280797399768543`*^9, 3.428090084236355*^9}]
}, Open  ]],

Cell["we are led to define the \"eigenfrequencies\"", "Text",
 CellChangeTimes->{{3.427646088293364*^9, 3.4276461014147873`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Omega]", "[", 
   RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["m", "2"], "+", 
     SuperscriptBox["n", "2"]}], ")"}], 
   SuperscriptBox["\[Pi]", "2"]}]}]], "Input",
 CellChangeTimes->{{3.427643529750581*^9, 3.4276435587998466`*^9}, {
  3.428079230310904*^9, 3.428079247431863*^9}}],

Cell["and to construct the \"buzz factors\"", "Text",
 CellChangeTimes->{{3.4276461122199717`*^9, 3.427646127150288*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "BuzzFactor", "]"}]], "Input",
 CellChangeTimes->{{3.4280798072095623`*^9, 3.428079813303382*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"BuzzFactor", "[", 
   RowBox[{"m_", ",", "n_", ",", "t_"}], "]"}], ":=", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{"\[Omega]", "[", 
     RowBox[{"m", ",", "n"}], "]"}], " ", "t"}]]}]], "Input",
 CellChangeTimes->{{3.427643590921043*^9, 3.4276436412999763`*^9}, {
  3.4280792677892942`*^9, 3.4280792791386003`*^9}, {3.428079876563057*^9, 
  3.4280798845249577`*^9}}],

Cell["The time-dependent eigenfunctions are given now by", "Text",
 CellChangeTimes->{{3.427646143699524*^9, 3.427646159654396*^9}, 
   3.428090048188087*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"x_", ",", "y_", ",", "m_", ",", "n_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"x", ",", "y", ",", "m", ",", "n"}], "]"}], "*", 
   StyleBox[
    RowBox[{"BuzzFactor", "[", 
     RowBox[{"m", ",", "n", ",", "t"}], "]"}], "Code"]}]}]], "Input",
 CellChangeTimes->{{3.4280793331656857`*^9, 3.4280794271377897`*^9}}],

Cell["\<\
which we verify do satisfy the time-dependent Schr\[OSlash]odinger equation:\
\>", "Text",
 CellChangeTimes->{{3.427646168295282*^9, 3.4276461719262743`*^9}, {
  3.428090134998006*^9, 3.4280901488904133`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["\[PartialD]", 
       RowBox[{"x", ",", "x"}]], 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"x", ",", "y", ",", "m", ",", "n", ",", "t"}], "]"}]}]}], "-", 
    
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"y", ",", "y"}]], 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"x", ",", "y", ",", "m", ",", "n", ",", "t"}], "]"}]}]}], 
   "\[Equal]", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], " ", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"x", ",", "y", ",", "m", ",", "n", ",", "t"}], "]"}]}]}]}], "//",
   "Simplify"}]], "Input",
 CellChangeTimes->{{3.4280794602549057`*^9, 3.4280795492410097`*^9}}],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.4280795409789124`*^9, 3.428079551152289*^9}, 
   3.428079925147175*^9, 3.42809015560015*^9}]
}, Open  ]],

Cell["\<\
The function \[Psi][x, y, m, n, t], since complex-valued, does not lend \
itself to graphic representation (people sometimes graph the amplitude, and \
use color to indicate the t-dependent phase), and there is no reason to graph \
the \"moving probability amplitude,\" since it does not move! To see motion \
one must look to weighted linear combinations of eigenfunctions that buzz \
with distinct frequencies.\
\>", "Text",
 CellChangeTimes->{{3.428080530247095*^9, 3.4280805369938173`*^9}, {
  3.428080570294387*^9, 3.428080680225699*^9}, {3.428081138926194*^9, 
  3.428081347233238*^9}, {3.428085487856174*^9, 3.4280854995642967`*^9}, {
  3.4280902029716787`*^9, 3.428090217996769*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.4280855042289762`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Motion of simple 2D superpositions", "Subsubtitle",
 CellChangeTimes->{{3.428085535603072*^9, 3.428085547161579*^9}}],

Cell["\<\
One must be careful to distinguish superpositions of the form\
\>", "Text",
 CellChangeTimes->{{3.428090310339094*^9, 3.428090328212961*^9}, 
   3.42809078934814*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", 
   RowBox[{"x", ",", "y", ",", "t"}], "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     UnderscriptBox["\[Sum]", "m"], 
     RowBox[{
      SubscriptBox["A", "m"], " ", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"x", ",", "m", ",", "t"}], "]"}]}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     UnderscriptBox["\[Sum]", "n"], 
     RowBox[{
      SubscriptBox["B", "n"], " ", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"x", ",", "n", ",", "t"}], "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.428090340343937*^9, 3.428090396096439*^9}, {
  3.428090577767221*^9, 3.428090627863521*^9}, {3.428090947105681*^9, 
  3.42809095606096*^9}}],

Cell[TextData[{
 "\[LongDash] which are assembled from ",
 StyleBox["products of sums of one-dimensional buzzing eigenfunctions",
  FontVariations->{"Underline"->True}]
}], "Text",
 CellChangeTimes->{{3.428090656436673*^9, 3.428090697531567*^9}, 
   3.428090746805852*^9, {3.4280910200010366`*^9, 3.428091022408202*^9}, {
   3.4280910742199306`*^9, 3.428091076361004*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", 
   RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   SqrtBox["2"], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"n", " ", "\[Pi]", " ", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", "[", 
   RowBox[{"x_", ",", "n_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"x", ",", "n"}], "]"}], "*", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     SuperscriptBox["n", "2"], 
     SuperscriptBox["\[Pi]", "2"], "t"}]]}]}]}], "Input",
 CellChangeTimes->{{3.428090553898303*^9, 3.428090554371229*^9}, {
  3.4280909657424383`*^9, 3.428090968365378*^9}}],

Cell["\<\
\[LongDash]from superpositions of the form\
\>", "Text",
 CellChangeTimes->{{3.428090764605341*^9, 3.4280907780284758`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPhi]", "[", 
   RowBox[{"x", ",", "y", ",", "t"}], "]"}], "=", 
  RowBox[{
   UnderscriptBox["\[Sum]", "m"], 
   RowBox[{
    UnderscriptBox["\[Sum]", "n"], 
    RowBox[{
     SubscriptBox["C", "mn"], " ", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"x", ",", "y", ",", "m", ",", "n", ",", "t"}], 
      "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.428090810732136*^9, 3.42809087297668*^9}, 
   3.4280909178882427`*^9}],

Cell[TextData[{
 "which are ",
 StyleBox["sums of products of one-dimensional buzzing eigenfunctions",
  FontVariations->{"Underline"->True}],
 ". The former give rise in the classical limit to Lissajous figures, and the \
latter to more complex kinds of quantum motion. I look to the alternatives in \
the order stated."
}], "Text",
 CellChangeTimes->{{3.428091033844572*^9, 3.428091086192932*^9}, {
  3.428091124057407*^9, 3.428091166481979*^9}, {3.4280925429980297`*^9, 
  3.4280925529608717`*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.4280925564796877`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["First approach to the quantum theory of Lissajous figures", \
"Subsubtitle",
 CellChangeTimes->{{3.428092572291174*^9, 3.4280925785691967`*^9}, {
  3.428175444378042*^9, 3.428175460639203*^9}}],

Cell["\<\
The classical motion of a partticle that moves freely within a \
one-dimensional bounding box is shown in the figure which I now construct:\
\>", "Text",
 CellChangeTimes->{{3.428107014735157*^9, 3.428107077245235*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "n"}], "-", "x0", "-", 
          RowBox[{"v", " ", "t"}]}], ",", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "n"}], "-", "1"}], ")"}], "-", "x0"}], "v"], "<", 
          "t", "<", 
          FractionBox[
           RowBox[{
            RowBox[{"2", "n"}], "-", "x0"}], "v"]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"v", " ", "t"}], "-", 
          RowBox[{"2", "n"}], "+", "x0"}], ",", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"2", "n"}], "-", "x0"}], "v"], "<", "t", "<", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "n"}], "+", "1"}], ")"}], "-", "x0"}], "v"]}]}], 
        "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "50"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.417049681558341*^9, 3.4170498095035477`*^9}, {
