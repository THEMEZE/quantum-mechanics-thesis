     ImageSizeCache->{494.5, {185.5, 192.}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    SynchronousInitialization->True,
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
 CellChangeTimes->{{3.428169191473768*^9, 3.4281692379909687`*^9}, {
  3.428169297531362*^9, 3.4281693073560123`*^9}}]
}, Open  ]],

Cell["Similarly,", "Text",
 CellChangeTimes->{{3.428111595574905*^9, 3.4281115977672586`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Py", "[", 
   RowBox[{"y_", ",", "t_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Re", "[", 
       RowBox[{"\[Phi]y", "[", 
        RowBox[{"y", ",", "t", ",", "\[Beta]"}], "]"}], "]"}], "]"}], ")"}], 
    "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Im", "[", 
       RowBox[{"\[Phi]y", "[", 
        RowBox[{"y", ",", "t", ",", "\[Beta]"}], "]"}], "]"}], "]"}], ")"}], 
    "2"]}]}]], "Input",
 CellChangeTimes->{{3.428111633689468*^9, 3.42811166588435*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TrigReduce", "[", 
  RowBox[{"Py", "[", 
   RowBox[{"x", ",", "t", ",", "\[Beta]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.428111673581897*^9, 3.428111677444017*^9}}],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"4", "-", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"6", " ", "\[Pi]", " ", "x"}], "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"8", " ", "\[Pi]", " ", "x"}], "]"}]}], "-", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"6", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"8", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "-", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"6", " ", "\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"8", " ", "\[Pi]", " ", "x"}], "+", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "+", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"7", " ", "t"}], "-", 
      RowBox[{"7", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"7", " ", "t"}], "-", 
      RowBox[{"\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"7", " ", "t"}], "+", 
      RowBox[{"\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "+", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"7", " ", "t"}], "+", 
      RowBox[{"7", " ", "\[Pi]", " ", "x"}], "-", 
      RowBox[{"2", " ", "\[Beta]"}]}], "]"}], "-", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"7", " ", "t"}], "-", 
