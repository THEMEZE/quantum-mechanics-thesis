 CellChangeTimes->{3.4687677376137953`*^9, 3.468767936703848*^9}],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.4687682285487747`*^9, 3.468768234859787*^9}}],

Cell[TextData[{
 "Alice elects \"of her own free will\"\[LongDash]meaning ",
 StyleBox["in a way not predetermined of dictated by any of the events in her \
backward lightcone",
  FontColor->RGBColor[0, 0, 1]],
 "\[LongDash]to press the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]]],
 " button, which aligns her meters along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["a", "Input"], "i"], ",", 
     SubscriptBox[
      StyleBox["b", "Input"], "i"], ",", 
     SubscriptBox[
      StyleBox["c", "Input"], "i"]}]}], TraditionalForm]]],
 "}.  Her meters read "
}], "Text",
 CellChangeTimes->{{3.468607986001791*^9, 3.4686081343548193`*^9}, {
  3.4686088797724648`*^9, 3.468608899580928*^9}, {3.468609017450334*^9, 
  3.468609072260172*^9}, {3.468609254702297*^9, 3.4686092552497473`*^9}},
 FontSize->18],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Theta]", "i"], "=", 
  RowBox[{
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       SubscriptBox["\[Theta]", "ia"]},
      {
       SubscriptBox["\[Theta]", "ib"]},
      {
       SubscriptBox["\[Theta]", "ic"]}
     }], "\[NoBreak]", ")"}], "=", 
   RowBox[{
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0"},
       {"1"},
       {"1"}
      }], "\[NoBreak]", ")"}], " ", "else", " ", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"1"},
       {"0"},
       {"1"}
      }], "\[NoBreak]", ")"}], " ", "else", " ", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"1"},
       {"1"},
       {"0"}
      }], "\[NoBreak]", ")"}]}]}]}]], "Output",
 CellChangeTimes->{{3.4686090830498953`*^9, 3.468609246370961*^9}},
 FontSize->16],

Cell[TextData[{
 "Bob elects of his own free will to measure spin-squared in direction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["x", "Input"], "k"], ":", " ", "k"}], "=", "1"}], ",", "2", 
    ",", "\[Ellipsis]", ",", "33."}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " His selection cannot have been influenced by Alice's, nor can the response \
(",
 StyleBox["0 else 1", "Output",
  FontSize->16],
 ") of his meter have been influenced by the responses of Alice's meters."
}], "Text",
 CellChangeTimes->{{3.468609947735157*^9, 3.468610134664798*^9}},
 FontSize->18],

Cell[TextData[{
 "By the Kochen-Specker theorem we know that there exists at least one \
direction  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "Input"], TraditionalForm]]],
 " which is an element of two distinct triads  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox[
     RowBox[{"x", ",", "a", ",", "b"}], "Input"]}], TraditionalForm]]],
 "} and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox[
     RowBox[{"x", ",", "c", ",", "d"}], "Input"]}], TraditionalForm]]],
 "}, and that it is instructed by the conjectured contextual hidden variables \
to register 0 when a member of one triad, 1 when a member of the other. But \
if Bob selects  ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "Input"], TraditionalForm]]],
 "  his meter will read "
}], "Text",
 CellChangeTimes->{{3.4686101983097677`*^9, 3.468610215116192*^9}, {
   3.468610343700534*^9, 3.4686104202473907`*^9}, {3.468610481080823*^9, 
   3.4686105251326647`*^9}, 3.4686105648077307`*^9, {3.468610599321772*^9, 
   3.468610817783825*^9}, {3.468610858716324*^9, 3.468610878163932*^9}, {
   3.4686112184339533`*^9, 3.4686112366129436`*^9}, {3.4686113377398653`*^9, 
   3.468611340103002*^9}, {3.4686284403641567`*^9, 3.468628447355288*^9}},
 FontSize->18],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[Theta]", "0"], "[", "x", "]"}], "=", 
   RowBox[{"0", " ", "else", " ", "1"}]}], ",", " ", 
  RowBox[{"one", " ", "or", " ", "the", " ", "other"}]}]], "Output",
 FontSize->16],

Cell[TextData[{
 "So he is ",
 StyleBox["at risk of violating the twinning principle",
  FontVariations->{"Underline"->True}],
 ".\n\n",
 "Phrased another way, we must, by twinning, have"
}], "Text",
 CellChangeTimes->{
  3.468611246032792*^9, {3.4686113456421413`*^9, 3.468611348482345*^9}, 
   3.468628506097686*^9},
 FontSize->18],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Theta]", "i"], "=", 
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       SubscriptBox["\[Theta]", "0"], "[", 
       SubscriptBox["a", "i"], "]"}]},
     {
      RowBox[{
       SubscriptBox["\[Theta]", "0"], "[", 
       SubscriptBox["b", "i"], "]"}]},
     {
      RowBox[{
       SubscriptBox["\[Theta]", "0"], "[", 
       SubscriptBox["c", "i"], "]"}]}
    }], "\[NoBreak]", ")"}]}]], "Output",
 CellChangeTimes->{{3.468611366363072*^9, 3.4686114220406017`*^9}},
 FontSize->16],

Cell[TextData[{
 "But according to the Kochen-Specker theorem ",
 StyleBox["there is no function",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "0"], "[", "x", "]"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " that assigns compatable 0-1 values to simultaneously to all 33 Peres \
rays."
}], "Text",
 CellChangeTimes->{{3.4686114811608763`*^9, 3.468611620071301*^9}},
 FontSize->18],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.468611641261623*^9}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader"],

Cell[CellGroupData[{

Cell["Slide 19", "Section",
 CellChangeTimes->{{3.468612329470661*^9, 3.468612333580427*^9}},
 FontSize->18],

Cell[TextData[StyleBox["FAILURE OF DETERMINISM\[LongDash]ENFORCED FREE WILL?",
 
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.468612356611415*^9, 3.468612430134832*^9}},
 FontSize->24],

Cell[TextData[{
 "The Kochen-Specker theorem was seen to render the non-contextual hidden \
variable hypothesis untenable. And it has been shown by Conway/Kochen to \
render the contextual hidden variable hypothesis equally untenable (",
 StyleBox["at least for twinned spin-one particles, therefore generally?",
  FontColor->RGBColor[0, 0, 1]],
 ").  Conway/Kochen argue that those two hypotheses exhaust the \
possibilities, that no mechanism for exercising hidden deterministic control \
of quantum processes survives. ",
 StyleBox["The quantum world has been shown to be ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["indeterministic",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ". "
}], "Text",
 CellChangeTimes->{{3.468612485642701*^9, 3.468612722932589*^9}, {
   3.468612764450263*^9, 3.468612791720603*^9}, {3.4686129297276173`*^9, 
   3.468612930887752*^9}, {3.468612963845743*^9, 3.4686130754154263`*^9}, 
   3.468628545746757*^9},
 FontSize->18],

Cell[TextData[{
 "Therefore \"quantum systems do not know how they will respond to \
measurement until they have done so.\" Which echos Bohr's \"No quantum \
phenomenon is a phenomenon until it is a ",
 StyleBox["recorded",
  FontSlant->"Italic"],
 " phenomenon.\"\n\nAlice/Bob did not know which buttons they were going to \
press until\[LongDash]unforcedly/undeterministically\[LongDash]they did so. \
Which is what we mean when we say they acted from spontaneous exercise of \
free will. Conway & Kochen insist that ",
 StyleBox["for that same reason, and to that same extent, we must attribute \
\"free will\" to the particles themselves",
  FontColor->RGBColor[1, 0, 0]],
 ". Which is the upshot of their ",
 StyleBox["FREE WILL THEOREM",
  FontWeight->"Bold"],
 ".\n\n"
}], "Text",
 CellChangeTimes->{{3.468613215608938*^9, 3.468613268235194*^9}, {
  3.468613300308292*^9, 3.468613526955925*^9}, {3.468613645933421*^9, 
  3.468613650855505*^9}, {3.468615185551889*^9, 3.468615206127459*^9}, {
  3.468628594511909*^9, 3.4686286537598248`*^9}},
 FontSize->18],

Cell["", "Text"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader"],

Cell[CellGroupData[{

Cell["Slide 20", "Section",
 CellChangeTimes->{{3.468628674174049*^9, 3.468628695442462*^9}},
 FontSize->18],

Cell["COMMENTARY", "Text",
 CellChangeTimes->{{3.468628715633997*^9, 3.468628717419159*^9}},
 FontWeight->"Bold"],

Cell["\<\
Conway & Kochen do not suppose particles to be sentient\[LongDash]they have \
detached \"free will\" from \"mind,\" and therefore from all that \
philosophers have had, over the centuries, to say about \"the free will \
problem.\" \
\>", "Text",
 CellChangeTimes->{{3.468628753976342*^9, 3.46862883807362*^9}, {
  3.468709349019844*^9, 3.468709366091145*^9}, {3.468709398703545*^9, 
  3.468709425459499*^9}},
 FontSize->18],

Cell[TextData[{
 "Is the traditionally troublesome concept of \"free will\" so \
well-understood that its use by physicists can serve to clarify understanding \
of (say) the quantum mechanical two-slit experiment? Or ",
 StyleBox["any",
  FontSlant->"Italic"],
 " quantum phenomenon? "
}], "Text",
 CellChangeTimes->{{3.468628858563384*^9, 3.468628864394322*^9}, {
  3.468628895597731*^9, 3.468629039741081*^9}},
 FontSize->18],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hyperlink", "[", 
  RowBox[{
  "\"\<What Philosophers Say about Free Will\>\"", ",", 
   "\"\<http://plato.stanford.edu/entries/freewill/\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.468689896905003*^9, 3.468689935600492*^9}, 
   3.468690029236704*^9, {3.468690472684238*^9, 3.4686904767839537`*^9}},
 FontSize->16],

