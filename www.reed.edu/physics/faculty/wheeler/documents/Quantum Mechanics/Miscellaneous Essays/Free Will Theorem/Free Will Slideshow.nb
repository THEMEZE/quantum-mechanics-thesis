Cell[TextData[{
 "which\[LongDash]fairly complete up to May 2005\[LongDash]cites 10,340 \
papers! Foundational physics has become a crowded field!!\n\nThe ",
 StyleBox["simplifications that result from appeal to the quantum physics of \
spin-one particles",
  FontWeight->"Bold"],
 " (see below!) were first noted in unpublished work (1969) by Richard \
Friedberg at Columbia University, according to Max Jammer,  ",
 StyleBox["The Philosophy of Quantum Mechanics",
  FontSlant->"Italic"],
 " (1974), page 324."
}], "Text",
 CellChangeTimes->{{3.468705576813466*^9, 3.468705659049259*^9}, {
  3.468705712395707*^9, 3.468705730845852*^9}, {3.4687141448748817`*^9, 
  3.468714145713757*^9}},
 FontSize->18]
}, Open  ]]
}, Open  ]],

