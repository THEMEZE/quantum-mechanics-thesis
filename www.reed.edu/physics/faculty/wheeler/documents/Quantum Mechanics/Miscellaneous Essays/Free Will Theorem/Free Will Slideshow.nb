Cell[TextData[{
 "The ",
 StyleBox["\[FilledCircle]",
  FontColor->RGBColor[1, 0, 0]],
 " dots refer to center-of-face rays, the ",
 StyleBox["\[FilledCircle]",
  FontColor->RGBColor[0, 0, 1]],
 " dots to center-of-edge rays. All triads are represented by triangles (and ",
 StyleBox["vice versa",
  FontSlant->"Italic"],
 ")  except for the three ",
 StyleBox["\[FilledCircle]",
  FontColor->RGBColor[0, 0, 1]],
 "-",
 StyleBox["\[FilledCircle]",
  FontColor->RGBColor[1, 0, 0]],
 "-",
 StyleBox["\[FilledCircle] ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["triads.\n\nThe objective of ",
  FontColor->GrayLevel[0]],
 StyleBox["Peres' game",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" is to paint red one ray in every triad, subject to the constraint \
that (not just its companions in the triads of which it is a member, but) ",
  FontColor->GrayLevel[0]],
 StyleBox["every",
  FontVariations->{"Underline"->True},
  FontColor->GrayLevel[0]],
 StyleBox[" ray orthogonal to a red ray is painted black. Orthogonal rays \
cannot be both red.\n",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.456845024481943*^9, 3.4568450941404676`*^9}, {
  3.4568451454862337`*^9, 3.456845221046054*^9}, {3.456845263270631*^9, 
  3.456845266264678*^9}, {3.456845394085886*^9, 3.456845394349595*^9}, {
  3.456845731553474*^9, 3.456845772257924*^9}, {3.456845811083075*^9, 
  3.456845947721365*^9}, {3.456846011165081*^9, 3.456846019287053*^9}, {
  3.456847017097149*^9, 3.456847040675789*^9}, {3.457881321111177*^9, 
  3.4578813327848997`*^9}, {3.457881370094533*^9, 3.457881389164546*^9}},
 FontSize->18],

Cell["This looks like a solution:", "Text",
 CellChangeTimes->{{3.457881469922998*^9, 3.457881479247218*^9}, 
   3.4578815532304163`*^9},
 FontSize->18],

