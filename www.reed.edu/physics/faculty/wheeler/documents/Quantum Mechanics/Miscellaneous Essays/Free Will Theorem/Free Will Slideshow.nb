Cell["\<\
but to establish that failure is inevitable requires a more subtle line of \
argument.\
\>", "Text",
 CellChangeTimes->{{3.468771517036737*^9, 3.4687715627921467`*^9}, 
   3.4687792506789007`*^9},
 FontSize->18],

Cell[TextData[{
 "Peres uses a population of only 33 rays\[LongDash]16 orthogonal triads\
\[LongDash]to establish that ",
 StyleBox["such an assignment cannot be accomplished",
  FontWeight->"Bold"],
 ". From the following population of 33 rays"
}], "Text",
