Cell[TextData[{
 "Note that it makes no sense in a relativistic world to ask ",
 StyleBox["\"Who made the first measurement?\"",
  FontWeight->"Bold"],
 " Conway & Kochen take for granted what they call the \"causality \
principle\": ",
 StyleBox["effects cannot\[LongDash]in the opinion of any inertial observer\
\[LongDash]precede their causes",
  FontWeight->"Bold"],
 ".\n"
}], "Text",
 CellChangeTimes->{{3.4568707731481*^9, 3.4568707974682913`*^9}, {
   3.4568708601723537`*^9, 3.456870906437311*^9}, {3.45687095743851*^9, 
   3.45687098979916*^9}, {3.457217672353037*^9, 3.45721770888103*^9}, {
   3.457266538793689*^9, 3.457266541994137*^9}, {3.45726664286677*^9, 
   3.4572666701154957`*^9}, {3.468607909427538*^9, 3.468607947670067*^9}, 
   3.4686089843540688`*^9},
 FontSize->18],

Cell[BoxData[
 GraphicsBox[{
   {Hue[0.606, 1, 1], Opacity[0.5], 
    PolygonBox[{{-1, 3}, {8, -6}, {-10, -6}}]}, 
   {Hue[0.86, 1, 1], Opacity[0.5], 
    PolygonBox[{{1, 3}, {10, -6}, {-8, -6}}]}, 
   {Hue[0.168, 1, 1], Opacity[0.256], 
