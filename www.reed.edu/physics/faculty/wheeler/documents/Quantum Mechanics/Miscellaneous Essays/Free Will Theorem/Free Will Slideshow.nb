   3.457580337576458*^9, {3.4578248853157682`*^9, 3.4578248977774477`*^9}, 
   3.457833324097481*^9}],

Cell[TextData[{
 "\nAndrew Gleason (on the left) wrote his thesis under Mackey (1950), and in \
(1957) produced ",
 StyleBox["Gleason's theorem ",
  FontWeight->"Bold"],
 "(",
 StyleBox["\"one of most basic/important 20th Century contributions to \
quantum mechanics\"",
  FontColor->RGBColor[0, 0, 1]],
 "). Not directly concerned with hidden variable question, but sprang from \
the same von Neumann/Mackey quantum axiomatics that led von Neumann to his \
(fallacious) \"no-hidden variables theorem.\"\n\nBell recognized the \
importance of Gleason's theorem, of which he provided his own alternative \
proof.\n\n"
}], "Text",
 CellChangeTimes->{{3.468515633234192*^9, 3.468515659244912*^9}, {
  3.468519340191513*^9, 3.468519422318915*^9}, {3.468621811015841*^9, 
  3.4686218355144253`*^9}, {3.4686218676383047`*^9, 3.468621869405909*^9}, {
  3.468621983849277*^9, 3.46862198909704*^9}, {3.468704278835987*^9, 
  3.468704294452379*^9}},
 FontSize->18]
}, Open  ]]
}, Open  ]],

