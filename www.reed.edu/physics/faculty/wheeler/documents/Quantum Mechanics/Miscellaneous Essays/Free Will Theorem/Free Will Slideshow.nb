   "http://philosophy.ucsd.edu/faculty/wuthrich/PhilPhys/MenonTarun2009Man_\
FreeWillThm.pdf", "Hyperlink"]& ]], "Output",
 CellChangeTimes->{3.468690452418542*^9, 3.468694835691111*^9},
 FontSize->16]
}, Open  ]],

Cell["\<\

Philosophers (Hobbs, Hume, Poincar\[EAcute], \[Ellipsis]) have been at pains \
to separate \"free will\" from \"determinism,\" to carve a place for free \
will in a deterministic will. Whence the several flavors of \"compatibilism\":\
\>", "Text",
 CellChangeTimes->{{3.4687095363914223`*^9, 3.468709611278647*^9}, {
   3.46870997499275*^9, 3.4687100064358892`*^9}, {3.46871005133926*^9, 
   3.468710069715789*^9}, {3.468710159354191*^9, 3.468710162709701*^9}, 
   3.46871040755413*^9},
 FontSize->18],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hyperlink", "[", 
  RowBox[{
  "\"\<Compatibilism\>\"", ",", 
   "\"\<http://plato.stanford.edu/entries/compatibilism/\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.468710109590108*^9, 3.468710142181387*^9}},
 FontSize->16],

Cell[BoxData[
 TagBox[
  ButtonBox[
   PaneSelectorBox[{False->"\<\"Compatibilism\"\>", True->
    StyleBox["\<\"Compatibilism\"\>", "HyperlinkActive"]}, Dynamic[
     CurrentValue["MouseOver"]],
    BaseStyle->{"Hyperlink"},
    BaselinePosition->Baseline,
    FrameMargins->0,
    ImageSize->Automatic],
   BaseStyle->"Hyperlink",
   ButtonData->{
     URL["http://plato.stanford.edu/entries/compatibilism/"], None},
   ButtonNote->"http://plato.stanford.edu/entries/compatibilism/"],
  Annotation[#, "http://plato.stanford.edu/entries/compatibilism/", 
   "Hyperlink"]& ]], "Output",
 CellChangeTimes->{3.468710147492668*^9},
 FontSize->16]
}, Open  ]],

Cell["\<\
Such philosophers, having established that conceptual independence, would \
insist that indeterminism does not imply free will. One cannot, in \
particular, identify free will as a necessarily active agent in a random \
world.\
\>", "Text",
 CellChangeTimes->{{3.468710210672244*^9, 3.4687103712326393`*^9}},
 FontSize->18],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.468709457664282*^9},
 FontSize->18],

Cell[TextData[{
 "Conway & Kochen tacitly dismiss the possibility that Alice/Bob and their \
particles/equipment might be interlinked by ",
 StyleBox["tachyons",
  FontColor->RGBColor[0, 0, 1]],
 ". No problem if tachyons cannot convey information\[Ellipsis]as has been \
argued by those to assert the impossibility of \"tachyonic telephones\" \
(which would enable one to communicate/interact with one's past)."
}], "Text",
 CellChangeTimes->{{3.468629125832596*^9, 3.4686293183285637`*^9}, {
  3.4686293585255117`*^9, 3.46862937052509*^9}},
 FontSize->18],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hyperlink", "[", 
  RowBox[{
  "\"\<Tachyonic Telephones\>\"", ",", 
   "\"\<http://en.wikipedia.org/wiki/Tachyonic_antitelephone\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.468690178400621*^9, 3.468690226942377*^9}},
 FontSize->16],

Cell[BoxData[
 TagBox[
  ButtonBox[
   PaneSelectorBox[{False->"\<\"Tachyonic Telephones\"\>", True->
    StyleBox["\<\"Tachyonic Telephones\"\>", "HyperlinkActive"]}, Dynamic[
