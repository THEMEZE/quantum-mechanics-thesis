      SubscriptBox["s", "3"]}], ")"}]}]}], ";"}]}], "Output",
 CellChangeTimes->{{3.4568583281221037`*^9, 3.456858360210807*^9}, {
  3.4568584317090483`*^9, 3.456858448460647*^9}, {3.456858636876528*^9, 
  3.45685867391367*^9}, {3.456858977988162*^9, 3.456858980965252*^9}},
 FontSize->14],

