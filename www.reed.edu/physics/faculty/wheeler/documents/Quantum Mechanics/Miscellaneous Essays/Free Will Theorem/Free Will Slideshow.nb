Cell[CellGroupData[{

Cell["Slide 12", "Section",
 CellChangeTimes->{{3.468530958669992*^9, 3.468530962129201*^9}},
 FontSize->18],

Cell["PERES' PROOF OF THE KOCHEN-SPECKER THEOREM", "Text",
 CellChangeTimes->{{3.4685311002120256`*^9, 3.4685311363671227`*^9}},
 FontSize->24,
 FontWeight->"Bold"],

Cell[TextData[{
 "\[Ellipsis]exploits ",
 StyleBox["a",
  FontWeight->"Bold"],
 " ",
 StyleBox["remarkable property of spin-one particles",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.468531331132676*^9, 3.4685313622635593`*^9}},
 FontSize->18],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["s", "1"], "=", 
   RowBox[{"\[HBar]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "0", "0"},
       {"0", "0", 
        RowBox[{"-", "\[ImaginaryI]"}]},
       {"0", "\[ImaginaryI]", "0"}
      }], "\[NoBreak]", ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["s", "2"], "=", 
   RowBox[{"\[HBar]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "0", "\[ImaginaryI]"},
       {"0", "0", "0"},
       {
        RowBox[{"-", "\[ImaginaryI]"}], "0", "0"}
      }], "\[NoBreak]", ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["s", "3"], "=", 
   RowBox[{"\[HBar]", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", 
        RowBox[{"-", "\[ImaginaryI]"}], "0"},
       {"\[ImaginaryI]", "0", "0"},
       {"0", "0", "0"}
      }], "\[NoBreak]", ")"}]}]}], ";"}]}], "Output",
 CellChangeTimes->{{3.455396305180884*^9, 3.4553964665244102`*^9}, {
  3.4553965246829233`*^9, 3.4553965301313353`*^9}},
 FontSize->16],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    SubscriptBox["s", "1"], ",", 
    SubscriptBox["s", "2"]}], "]"}], "\[Equal]", 
  RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
   SubscriptBox["s", "3"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    SubscriptBox["s", "2"], ",", 
    SubscriptBox["s", "3"]}], "]"}], "\[Equal]", 
  RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
   SubscriptBox["s", "1"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    SubscriptBox["s", "3"], ",", 
    SubscriptBox["s", "1"]}], "]"}], "\[Equal]", 
  RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
   SubscriptBox["s", "2"]}]}]}], "Output",
 FontSize->16],

Cell[BoxData[
 RowBox[{
  RowBox[{"SS", "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["s", "1"], ".", 
     SubscriptBox["s", "1"]}], "+", 
    RowBox[{
     SubscriptBox["s", "2"], ".", 
     SubscriptBox["s", "2"]}], "+", 
    RowBox[{
     SubscriptBox["s", "3"], ".", 
     SubscriptBox["s", "3"]}]}]}], ";"}]], "Output",
 CellChangeTimes->{{3.45679661373365*^9, 3.456796676107293*^9}, 
   3.457831036054859*^9},
 FontSize->16],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{"SS", ",", 
    RowBox[{
     SubscriptBox["s", "1"], ".", 
     SubscriptBox["s", "1"]}]}], "]"}], "\[Equal]", 
  SubscriptBox["\[DoubleStruckCapitalO]", "3"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{"SS", ",", 
    RowBox[{
     SubscriptBox["s", "2"], ".", 
     SubscriptBox["s", "2"]}]}], "]"}], "\[Equal]", 
  SubscriptBox["\[DoubleStruckCapitalO]", "3"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{"SS", ",", 
    RowBox[{
     SubscriptBox["s", "3"], ".", 
     SubscriptBox["s", "3"]}]}], "]"}], "\[Equal]", 
  SubscriptBox["\[DoubleStruckCapitalO]", "3"]}]}], "Output",
 FontSize->16],

Cell[TextData[{
 "The squared spin matrices refer to a ",
 StyleBox["compatable triple of measurements",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.4578309271174793`*^9, 3.4578309366852417`*^9}},
 FontSize->18],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["s", "1"], ".", 
     SubscriptBox["s", "1"]}], ",", 
    RowBox[{
     SubscriptBox["s", "2"], ".", 
     SubscriptBox["s", "2"]}]}], "]"}], "\[Equal]", 
  SubscriptBox["\[DoubleStruckCapitalO]", "3"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["s", "2"], ".", 
     SubscriptBox["s", "2"]}], ",", 
    RowBox[{
     SubscriptBox["s", "3"], ".", 
     SubscriptBox["s", "3"]}]}], "]"}], "\[Equal]", 
  SubscriptBox["\[DoubleStruckCapitalO]", "3"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["s", "3"], ".", 
     SubscriptBox["s", "3"]}], ",", 
    RowBox[{
     SubscriptBox["s", "1"], ".", 
     SubscriptBox["s", "1"]}]}], "]"}], "\[Equal]", 
  SubscriptBox["\[DoubleStruckCapitalO]", "3"]}]}], "Output",
 CellChangeTimes->{{3.4567969450705976`*^9, 3.4567969790944347`*^9}},
 FontSize->16],

Cell[BoxData[{
 RowBox[{"Eigenvalues", "[", 
  RowBox[{
   SubscriptBox["s", "1"], ".", 
   SubscriptBox["s", "1"]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", 
  RowBox[{
   SubscriptBox["s", "2"], ".", 
   SubscriptBox["s", "2"]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", 
  RowBox[{
   SubscriptBox["s", "3"], ".", 
   SubscriptBox["s", "3"]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"0", ",", 
   SuperscriptBox["\[HBar]", "2"], ",", 
   SuperscriptBox["\[HBar]", "2"]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"0", ",", 
   SuperscriptBox["\[HBar]", "2"], ",", 
   SuperscriptBox["\[HBar]", "2"]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"0", ",", 
   SuperscriptBox["\[HBar]", "2"], ",", 
   SuperscriptBox["\[HBar]", "2"]}], "}"}]}], "Output",
 CellChangeTimes->{{3.457830755355256*^9, 3.457830756889369*^9}},
 FontSize->16],

Cell[BoxData[{
 RowBox[{"Eigenvalues", "[", "SS", "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", 
    SuperscriptBox["\[HBar]", "2"]}], ",", 
   RowBox[{"2", 
    SuperscriptBox["\[HBar]", "2"]}], ",", " ", 
   RowBox[{"2", 
    SuperscriptBox["\[HBar]", "2"]}]}], "}"}]}], "Output",
 FontSize->16],

Cell[TextData[{
 StyleBox["THE 101 RULE",
  FontSize->18,
  FontWeight->"Bold"],
 ": For spin-one particles, spin-squared measurements in three orthogonal \
directions always produce some permutation of {1, 0, 1} (in units where \
\[HBar] = 1).\n\n",
 StyleBox["\[Bullet] ", "Code"],
 "For spin one-half this reduces to a triviality:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "4"], "+", 
     FractionBox["1", "4"], "+", " ", 
     FractionBox["1", "4"]}], "=", " ", 
    FractionBox["3", "4"]}], TraditionalForm]]],
 " \n\n\[Bullet] For spin \[GreaterSlantEqual] ",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "2"], TraditionalForm]]],
 " such a result is impossible, because the spin-squared operators fail to \
commute.\n\nSo we will (with Peres) be exploiting ",
 StyleBox["a fact that pertains uniquely to (massy) spin-one particles",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.4578789272866383`*^9, 3.45787895180466*^9}, {
  3.457878984571311*^9, 3.457879473094027*^9}, {3.468531761478421*^9, 
  3.46853176865725*^9}, {3.468531839699913*^9, 3.468531839918332*^9}, {
  3.468531885215007*^9, 3.4685318861521597`*^9}},
 FontSize->16]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->"SlideShowHeader"],

Cell[CellGroupData[{

Cell["Slide 13", "Section",
 CellChangeTimes->{{3.468531931421386*^9, 3.46853193487169*^9}},
 FontSize->18],

Cell["\<\
You are a local realist, seek to write non-contextual instructions onto \
variables hidden within the spin-one particle that say how the particle is to \
respond\[LongDash]consistently with the 101 rule\[LongDash]to every possible \
triadic array of spin-squared meters (of which there are infinitely many).\
\>", "Text",
 CellChangeTimes->{3.468532003331064*^9, 3.4685321241834593`*^9},
 FontSize->18],

Cell["\<\

Here is a simple solution in 2D\
\>", "Text",
 CellChangeTimes->{{3.456842077667954*^9, 3.456842173318618*^9}, {
