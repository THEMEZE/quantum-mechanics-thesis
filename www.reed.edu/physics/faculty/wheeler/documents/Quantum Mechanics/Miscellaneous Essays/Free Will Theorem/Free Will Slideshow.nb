   3.4567592114591837`*^9}, {3.456759481037359*^9, 3.456759734506884*^9}, {
   3.45675976630079*^9, 3.456759791214304*^9}, {3.456759824559148*^9, 
   3.456759830535391*^9}, {3.456760043825665*^9, 3.456760063906001*^9}, {
   3.456760094276205*^9, 3.45676016942237*^9}, {3.4567602070774317`*^9, 
   3.456760248694229*^9}, {3.4567603259587*^9, 3.456760331127062*^9}, {
