Cell[CellGroupData[{

Cell["Slide 7", "Section",
 CellChangeTimes->{{3.468518759799735*^9, 3.468518763018742*^9}},
 FontSize->18],

Cell["KOCHEN-SPECKER THEOREM", "Text",
 CellChangeTimes->{{3.468508421671385*^9, 3.468508510140196*^9}, {
  3.4685097435803967`*^9, 3.468509747512114*^9}, {3.468512284506689*^9, 
  3.46851230255075*^9}, {3.4685184276376534`*^9, 3.468518442539344*^9}, {
  3.468518813362533*^9, 3.468518819597662*^9}},
 FontSize->24,
 FontWeight->"Bold"],

Cell[TextData[{
 StyleBox["1967", "Subsection",
  FontSize->18],
 StyleBox[": Simon Kochen & Ernst Specker publish \"The problem of hidden \
variables in quantum mechanics,\" Journal of Mathematics & Mechanics ",
  FontSize->18],
 StyleBox["17",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[", 59-87. The work had been completed in \
1963-64\[LongDash]simultaneously with but in ignorance of Bell's work.\n",
  FontSize->18],
 "\n\n",
