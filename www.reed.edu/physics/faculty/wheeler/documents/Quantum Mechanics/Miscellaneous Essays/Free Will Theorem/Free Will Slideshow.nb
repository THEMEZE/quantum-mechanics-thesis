  RowBox[{
  "\"\<A Philosopher on Conway-Kochen\>\"", ",", 
   "\"\<http://philosophy.ucsd.edu/faculty/wuthrich/PhilPhys/\
MenonTarun2009Man_FreeWillThm.pdf\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.468690322255916*^9, 3.46869032815154*^9}, {
  3.468690414894026*^9, 3.468690450604445*^9}},
