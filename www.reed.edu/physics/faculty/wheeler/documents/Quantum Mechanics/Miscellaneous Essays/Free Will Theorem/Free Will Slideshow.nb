Cell[TextData[{
 "in which we encounter {4 \[FilledSquare], 27 \[FilledSquare]} and {11 \
\[FilledSquare], 24 \[FilledSquare]}\[LongDash]orthogonal pairs of which both \
members are red, in violation of the rules. ",
 StyleBox["So it goes in every case",
  FontWeight->"Bold"],
 ".\n"
}], "Text",
 CellChangeTimes->{{3.456846964113318*^9, 3.456846986805682*^9}, {
   3.4568470638233147`*^9, 3.456847090059792*^9}, {3.456847215606575*^9, 
   3.456847244451153*^9}, {3.457196398291271*^9, 3.45719645314152*^9}, 
   3.457196516169466*^9, {3.457881871716196*^9, 3.4578818833695917`*^9}, {
   3.457926411435636*^9, 3.4579264116570253`*^9}, 3.4685327726742907`*^9},
 FontSize->18],

Cell[TextData[{
 StyleBox["UPSHOT OF THE KOCHEN-SPECKER-PERES THEOREM",
  FontWeight->"Bold"],
 ": It is impossible/inconsistent to require of a function"
}], "Text",
 CellChangeTimes->{{3.457216031526045*^9, 3.457216079760923*^9}, {
  3.457216284367489*^9, 3.45721630387057*^9}},
 FontSize->18],

Cell[BoxData[
 RowBox[{"\[Theta]", "[", 
  RowBox[{
   OverscriptBox["x", "\[RightVector]"], ",", 
   OverscriptBox["y", "\[RightVector]"], ",", 
   RowBox[{
    OverscriptBox["z", "\[RightVector]"], ";", 
    RowBox[{"non", "-", 
     RowBox[{"contextual", " ", "hidden", " ", "variables"}]}]}]}], 
  "]"}]], "Output",
 FontSize->16],

Cell["\<\
that it be a \"101 function\"\[LongDash]a function that yields \
\>", "Text",
 CellChangeTimes->{{3.457216215348338*^9, 3.457216225259369*^9}, {
  3.457279737150939*^9, 3.4572797697934303`*^9}, {3.4685355364318047`*^9, 
  3.468535559951083*^9}},
 FontSize->18],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"0", ",", "1", ",", "1"}], "}"}], " ", "else", " ", 
  RowBox[{"{", 
   RowBox[{"1", ",", "0", ",", "1"}], "}"}], "else", " ", 
  RowBox[{"{", 
   RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]], "Output",
 CellChangeTimes->{{3.457216246750268*^9, 3.4572162735797157`*^9}},
 FontSize->16],

Cell[TextData[{
 "for all orthogonal triadic arguments: ",
 StyleBox["no such function exists",
  FontColor->RGBColor[1, 0, 0]],
 ".\n\nThe Kochen-Specker-Peres proof that ",
 StyleBox["non-contextual hidden variables (for the system at hand, ",
  FontVariations->{"Underline"->True}],
 StyleBox["and therefore universally?",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[") cannot exist",
  FontVariations->{"Underline"->True}],
 " is ",
 StyleBox["non-statistical",
  FontWeight->"Bold"],
 ", and ",
 StyleBox["makes no assumption regarding the initial state of the spin-one \
particle",
  FontWeight->"Bold"],
 ", and in both respects represents an improvement upon Bell's proof of the \
same result.\n\n",
 StyleBox["The KS theorem ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["does not exclude the possibility of \"contextual hidden variables",
  
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[".\" This is a loop-hole that Conway & Kochen close ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["en route",
  FontSlant->"Italic",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" to their \"Free Will Theorem.\"",
  FontColor->RGBColor[1, 0, 0]],
 "   "
}], "Text",
 CellChangeTimes->{{3.4572163152933292`*^9, 3.457216370190589*^9}, {
  3.4579264354278584`*^9, 3.45792643562648*^9}, {3.468535765554002*^9, 
  3.468535769841743*^9}, {3.4685362500566187`*^9, 3.468536437902419*^9}, {
  3.4685368942926083`*^9, 3.468537016514325*^9}, {3.468623814881543*^9, 
  3.468623870217248*^9}},
 FontSize->18]
}, Open  ]]
}, Open  ]],

