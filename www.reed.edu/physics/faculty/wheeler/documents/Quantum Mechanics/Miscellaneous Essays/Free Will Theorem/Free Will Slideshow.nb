Cell["Slide 6", "Section",
 CellChangeTimes->{
  3.4685150542516613`*^9, {3.468515089985187*^9, 3.4685150907162743`*^9}},
 FontSize->18],

Cell["GLEASON'S THEOREM", "Text",
 CellChangeTimes->{
  3.4685186450182247`*^9, {3.4685187109643793`*^9, 3.4685187197621117`*^9}},
 FontSize->24,
 FontWeight->"Bold"],

Cell[TextData[{
 StyleBox["1957", "Subsection",
  FontSize->18],
 StyleBox[": George Mackey (1916-2006)\[LongDash]",
  FontSize->18],
 StyleBox["thesis advisor (1973) of Thomas Wieting",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["\[LongDash]did pioneering work on the mathematical/logical \
foundations of quantum mechanics: his ",
  FontSize->18],
 StyleBox["Mathematical Foundations of Quantum Mechanics",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[" was published in 1963.",
  FontSize->18]
}], "Text",
 CellChangeTimes->{3.4685155151770363`*^9},
 FontSize->16],

