Cell[CellGroupData[{

Cell["Slide 4", "Section",
 CellChangeTimes->{3.468512596885482*^9},
 FontSize->18],

Cell["DAVID BOHM, YAKIR AHRANOV", "Text",
 CellChangeTimes->{{3.468508421671385*^9, 3.468508510140196*^9}, {
  3.4685097435803967`*^9, 3.468509747512114*^9}, {3.468512284506689*^9, 
  3.46851230255075*^9}},
 FontSize->24,
 FontWeight->"Bold"],

Cell[TextData[{
 StyleBox["1951",
  FontWeight->"Bold"],
 ": Publishes ",
 StyleBox["Quantum Mechanics",
  FontSlant->"Italic"],
 ", Part 3 treats foundational problems, emphasizes importance of EPR problem."
}], "Text",
 CellChangeTimes->{{3.4685098741843967`*^9, 3.46850999220471*^9}, {
  3.468512265356654*^9, 3.468512274427723*^9}, {3.468512358770521*^9, 
  3.468512396693512*^9}, {3.4685124742208433`*^9, 3.468512523311015*^9}},
 FontSize->18],

Cell[TextData[{
 StyleBox["1957", "Subsection",
  FontSize->18],
 ": David Bohm & Yakir Aharonov publish \"Discussion of experimental proof \
for the paradox of Einstein, Rosen & Podolsky\" in Phys. \
Rev.\[LongDash]reformulate the EPR argument in terms of ",
 StyleBox["two spin one-half particles in an entangled singlet state",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{{3.4567604373620377`*^9, 3.456760441153119*^9}, {
  3.456760471166939*^9, 3.456760645261794*^9}},
 FontSize->18],

