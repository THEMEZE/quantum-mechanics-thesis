   RowBox[{
    SubscriptBox["S", "2"], ",", 
    SubscriptBox["S", "3"]}], "]"}], "\[Equal]", 
  RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
   SubscriptBox["S", "1"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Comm", "[", 
   RowBox[{
    SubscriptBox["S", "3"], ",", 
    SubscriptBox["S", "1"]}], "]"}], "\[Equal]", 
  RowBox[{"\[ImaginaryI]", " ", "\[HBar]", " ", 
   SubscriptBox["S", "2"]}]}]}], "Output",
 FontSize->14],

Cell[BoxData[{
 RowBox[{"Eigenvalues", "[", "SS", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", 
  SubscriptBox["S", "3"], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
  "6", ",", "6", ",", "6", ",", "6", ",", "6", ",", "2", ",", "2", ",", "2", 
   ",", "0"}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", 
   RowBox[{"-", "1"}], ",", 
   RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "0", ",", "0", ",", "0"}], 
  "}"}]}], "Output",
 CellChangeTimes->{{3.4568587434224577`*^9, 3.456858776088337*^9}, {
  3.456858828325471*^9, 3.4568588289096527`*^9}, {3.456859008409343*^9, 
  3.456859037367272*^9}, {3.457885067260137*^9, 3.457885081890675*^9}},
 FontSize->14],

Cell[TextData[{
 "Notice that ",
 StyleBox["0", "Input",
  FontSize->18],
 " is a shared eigenvalue (and the only non-degenerage eigenvalue of ",
 StyleBox["SS", "Input",
  FontSize->18],
 "). "
}], "Text",
 CellChangeTimes->{{3.456859720044621*^9, 3.4568597559497023`*^9}, {
   3.4568597884786158`*^9, 3.456859797974617*^9}, 3.457885135254068*^9, 
   3.468593276870335*^9},
 FontSize->18],

