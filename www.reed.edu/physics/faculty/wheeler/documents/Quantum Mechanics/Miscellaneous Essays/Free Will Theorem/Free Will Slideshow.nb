Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.468679775647182*^9}],

Cell[TextData[{
 StyleBox["Uses ",
  FontSize->18],
 StyleBox["two spin one-half particles in singlet state",
  FontSize->18,
  FontVariations->{"Underline"->True}],
 StyleBox[" (",
  FontSize->18],
 StyleBox["a la",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[" Bohm/Aharonov) and ",
  FontSize->18],
 StyleBox["spin measurements ",
  FontSize->18,
  FontVariations->{"Underline"->True}],
 StyleBox["in three non-colinear directions",
  FontSize->18,
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 StyleBox[". Hidden variable analysis leads (as Bell ingeniously \
demonstrates) to an inequality which ordinary quantum theory would in some \
cases violate, the implication being that\n\n\"",
  FontSize->18],
 StyleBox["No physical theory of local hidden variables can ever reproduce \
all of the predictions of quantum mechanics",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[".\"\n\nBell had identified von Neumann's elementary error, made \
lively again the possibility that hidden variables ",
  FontSize->18],
 StyleBox["might",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[" exist. Tended intuitively to favor that hypothesis, sought to \
establish that quantum mechanics",
  FontSize->18],
 StyleBox[" is",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[" a local theory\[LongDash]incomplete as it stands. But\[Ellipsis]\n\
\nExperimental work (1970s-80s), by Alain Aspect, Anton Zeilinger and others, \
established quite convincingly that (more workable generalizations of) Bell's \
inequality are in fact violated: ",
  FontSize->18],
 StyleBox["non-locality, spooky action at a distance are facts to be lived \
with",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[".\n\nBut experimentalists were kept busy for a decade or more \
attempting to close various subtle loopholes. Some of those have to do with \
the fact that ",
  FontSize->18],
 StyleBox["the ",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["objects on both sides of Bell's inequality are statistical \
averages",
  FontSize->18,
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[": any finite set of data might therefore be misleading",
  FontSize->18,
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[".",
  FontSize->18]
}], "Text",
 CellChangeTimes->{
  3.468513808949831*^9, {3.468513874606941*^9, 3.468513876834188*^9}, {
   3.468621491281271*^9, 3.4686215110820827`*^9}, {3.468703668683997*^9, 
   3.468703673193707*^9}, {3.4687037043544493`*^9, 3.468703718053303*^9}, {
   3.4687037797024393`*^9, 3.468703780446801*^9}, {3.468703883577701*^9, 
   3.4687038978518457`*^9}},
 FontSize->16]
}, Open  ]]
}, Open  ]],

