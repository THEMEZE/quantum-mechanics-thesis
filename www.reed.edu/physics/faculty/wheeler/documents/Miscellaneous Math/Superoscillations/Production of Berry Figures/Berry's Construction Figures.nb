Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", "=", "2.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Nu]", "=", "12.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Berry3a1", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"\[DoubleStruckCapitalB]", "[", 
         RowBox[{"x", ",", "\[Nu]", ",", "b"}], "]"}], "]"}], ",", 
       RowBox[{"Cos", "[", 
        RowBox[{"3", "x"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6.1"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "6.2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10"}], ",", "5"}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExactDataPoints", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox["n", "2"], ",", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"\[DoubleStruckCapitalB]", "[", 
          RowBox[{
           FractionBox["n", "2"], ",", "\[Nu]", ",", "b"}], "]"}], 
         RowBox[{"\[ScriptCapitalE]", "[", 
          RowBox[{
           FractionBox["n", "2"], ",", "\[Nu]", ",", "b"}], "]"}]}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "12"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Berry3a2", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"ExactDataPoints", ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"PointSize", "[", "Large", "]"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"Berry3a1", ",", "Berry3a2"}], "]"}]}], "Input",
