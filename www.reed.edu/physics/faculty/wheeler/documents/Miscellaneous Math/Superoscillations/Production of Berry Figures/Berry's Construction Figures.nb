Cell[TextData[{
 "Only for \[Xi] < 1 does \[ScriptCapitalK]  have a superoscillatory value > \
1, and that value is bounded in the case ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "max"], TraditionalForm]],ExpressionUUID->
  "94bc836c-64e0-4dd9-a02b-cc5e02e5f439"],
 " by 3, as shown. The red portion of this curve can be identified with the \
red portion of Figure 9."
}], "Text",
 CellChangeTimes->{{3.7305742609531612`*^9, 3.730574299774206*^9}, {
  3.730574404684346*^9, 3.730574437949133*^9}, {3.730576610605649*^9, 
