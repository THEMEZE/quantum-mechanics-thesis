Cell["\<\
Yet another demonstration of how abrupt  and extreme is the stratospheric \
ascent at the edge of the flat desert:\
\>", "Text",
 CellChangeTimes->{{3.730577872889838*^9, 3.730577920911291*^9}, {
  3.730578143438735*^9, 
  3.730578167466153*^9}},ExpressionUUID->"52c1a551-5c65-45a1-a67a-\
caa3da86bd9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Erf", "[", 
        RowBox[{"x", "+", 
         RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], "\[Equal]", 
      "10"}], ",", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Erf", "[", 
        RowBox[{"x", "+", 
         RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], "\[Equal]", 
      "100"}], ",", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Erf", "[", 
        RowBox[{"x", "+", 
         RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], "\[Equal]", 
      "1000"}], ",", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Erf", "[", 
        RowBox[{"x", "+", 
         RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], "\[Equal]", 
      "10000"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "50"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7294458440318813`*^9, 3.729445898267054*^9}, {
