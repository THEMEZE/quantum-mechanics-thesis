  3.7305722042080803`*^9},ExpressionUUID->"e48d7e4d-77d2-4762-b090-\
c802e4e2c0f6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Figure 10: \"Local wavenumber\" \[ScriptCapitalK] in the case b = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "max"], TraditionalForm]], "None",ExpressionUUID->
  "a65b0857-1585-43a2-ae20-8b6098c2cf79"]
}], "Subsection",
 CellChangeTimes->{{3.7305722136570787`*^9, 3.730572216457239*^9}, {
  3.730576524493547*^9, 
  3.7305765870206423`*^9}},ExpressionUUID->"22bbfd2b-2b00-4130-9040-\
266cec7a29e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalK]", "[", 
   RowBox[{"b_", ",", "\[Xi]_"}], "]"}], ":=", 
  RowBox[{"1", "+", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["b", "2"], 
    FractionBox[
     RowBox[{"1", "-", 
      SuperscriptBox["\[Xi]", "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["\[Xi]", "2"]}], ")"}], "2"]]}]}]}]], "Input",
 CellChangeTimes->{{3.730572411212133*^9, 
  3.7305724804957943`*^9}},ExpressionUUID->"6a6e27ca-95ca-48cb-b3d5-\
cd46994dcc26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"LocalWavenumberSegment", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalK]", "[", 
        RowBox[{"2", ",", "\[Xi]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Xi]", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "3"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"GridLines", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"{", "1", "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
       RowBox[{"Ticks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"LocalWavenumberComplete", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalK]", "[", 
        RowBox[{"2", ",", "\[Xi]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Xi]", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "3"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"GridLines", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"{", "1", "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Dashed", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"Ticks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", " ", 
    RowBox[{"LocalWavenumberSegment", ",", " ", "LocalWavenumberComplete"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.730572515655706*^9, 3.730572528057981*^9}, {
   3.730573187539175*^9, 3.730573313767974*^9}, {3.7305734100054502`*^9, 
