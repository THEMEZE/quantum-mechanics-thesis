Cell[TextData[{
 "In the flat parts of the top figure the real part of ",
 StyleBox["Erf[x+\[ImaginaryI]y]", "Input"],
 "is found never  to deviate by more than a few parts in a thousand from the \
value 1. In the bottom figure the flat portions of the imaginary part remain \
similarly close to the value 0. It is the flat parts of these figures that \
give rise to the condition b \[LessSlantEqual] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", 
     RowBox[{"max", " "}]], "=", "2."}], TraditionalForm]],ExpressionUUID->
  "4ebe2c87-64a0-4159-b112-fc537ce9c90d"]
}], "Text",
 CellChangeTimes->{{3.729444307249942*^9, 3.729444506970213*^9}, {
  3.73057698515209*^9, 
  3.730577047201437*^9}},ExpressionUUID->"26700394-42b8-4373-b107-\
bcf54503cb54"],

