Cell[CellGroupData[{

Cell["Figures 6", "Subsection",
 CellChangeTimes->{{3.7294541317222023`*^9, 3.7294541371649857`*^9}, 
   3.729537838361939*^9},ExpressionUUID->"de6f2b13-7290-433f-8158-\
23d7f24b956c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"X", "[", 
   RowBox[{"x_", ",", "\[Nu]_", ",", "b_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"2", " ", 
    SqrtBox["\[Nu]"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"ArcTan", "[", 
         FractionBox["x", 
          RowBox[{"2", " ", "\[Nu]"}]], "]"}]}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["b", "2"], "+", 
         FractionBox["x", 
          RowBox[{"2", " ", "\[Nu]"}]]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"ArcTan", "[", 
          FractionBox["x", 
           RowBox[{"2", " ", "\[Nu]"}]], "]"}]}], "]"}]}]}], ")"}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox[
       SuperscriptBox["x", "2"], 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Nu]", "2"]}]]}], ")"}], 
    RowBox[{"1", "/", "4"}]]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y", "[", 
   RowBox[{"x_", ",", "\[Nu]_", ",", "b_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"2", " ", 
    SqrtBox["\[Nu]"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox["b", "2"], "+", 
         FractionBox["x", 
          RowBox[{"2", " ", "\[Nu]"}]]}], ")"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"ArcTan", "[", 
          FractionBox["x", 
           RowBox[{"2", " ", "\[Nu]"}]], "]"}]}], "]"}]}], "-", 
      RowBox[{"Sin", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"ArcTan", "[", 
         FractionBox["x", 
          RowBox[{"2", " ", "\[Nu]"}]], "]"}]}], "]"}]}], ")"}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox[
       SuperscriptBox["x", "2"], 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Nu]", "2"]}]]}], ")"}], 
    RowBox[{"1", "/", "4"}]]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z", "[", 
   RowBox[{"x_", ",", "\[Nu]_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"X", "[", 
    RowBox[{"x", ",", "\[Nu]", ",", "b"}], "]"}], "+", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"Y", "[", 
     RowBox[{"x", ",", "\[Nu]", ",", "b"}], "]"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.7294542316523523`*^9, 3.72945425029743*^9}, {
  3.729454281886581*^9, 
  3.7294543902930527`*^9}},ExpressionUUID->"881635d6-73be-4527-ad9e-\
0cfef1bf9194"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalE]", "[", 
   RowBox[{"x_", ",", "\[Nu]_", ",", "b_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"Erf", "[", 
     RowBox[{"Z", "[", 
      RowBox[{"x", ",", "\[Nu]", ",", "b"}], "]"}], "]"}], "+", 
    RowBox[{"Erf", "[", 
     RowBox[{"Z", "[", 
      RowBox[{"x", ",", "\[Nu]", ",", 
       RowBox[{"-", "b"}]}], "]"}], "]"}]}], "2"]}]], "Input",
 CellChangeTimes->{{3.729454479336769*^9, 3.7294544822753963`*^9}, {
  3.729454518027128*^9, 
  3.7294545822279243`*^9}},ExpressionUUID->"7023b5c2-c1ad-47b8-842f-\
564160ec3993"],

