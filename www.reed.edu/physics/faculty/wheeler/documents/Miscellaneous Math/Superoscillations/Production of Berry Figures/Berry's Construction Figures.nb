Cell[TextData[{
 "The final figure, though qualititively similar to the others, cannot \
illustrate superoscillation because the assumption b = 2.5 > ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", "max"], "=", " ", "2"}], TraditionalForm]],
  ExpressionUUID->"073b70f4-36cf-4289-a15e-ebb882489789"],
 " introduces terms with wavenumber > 1 into its construction. "
}], "Text",
 CellChangeTimes->{{3.730576127270904*^9, 3.730576196619773*^9}, {
  3.7305762958148212`*^9, 3.730576369498904*^9}, {3.7305776228928413`*^9, 
  3.730577670160122*^9}},ExpressionUUID->"6de24f02-da13-4f46-bed8-\
cac251deba95"],

