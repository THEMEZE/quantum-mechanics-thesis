Cell[TextData[{
 "The null curves of real part (red) and imaginary part (blue) of ",
 StyleBox["Erf[x+\[ImaginaryI]y]", "Input"],
 ".  Orthogonality at points of intersection follows from analyticity (i.e., \
from the Cauchy-Riemann equations)."
}], "Text",
 CellChangeTimes->{{3.729441213011838*^9, 3.729441395888053*^9}, {
  3.730576857031196*^9, 
  3.730576859823493*^9}},ExpressionUUID->"78dd8cbe-1c64-4e79-8514-\
a026c016e6fa"],

