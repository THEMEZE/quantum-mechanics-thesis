  3.7295408382598257`*^9}},ExpressionUUID->"88596d1c-99b9-4f14-a2cf-\
ac62aac5b91c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalB]", "[", 
   RowBox[{"x_", ",", "\[Nu]_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"1", "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Xi]"}]}]]], 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{
       SuperscriptBox["b", "2"], "x", " ", "\[Xi]"}], 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["\[Xi]", "2"]}], ")"}]}]], "]"}], 
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", "x", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["b", "2"], 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["\[Xi]", "2"]}], ")"}]}]]}], ")"}]}], "]"}]}], "/.", 
   RowBox[{"\[Xi]", "\[Rule]", 
    FractionBox["x", 
     RowBox[{"2", "\[Nu]"}]]}]}]}]], "Input",ExpressionUUID->"29ac9fc7-e2c6-\
4e8a-aa7f-4b511402f617"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Nu]", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"\[DoubleStruckCapitalB]", "[", 
       RowBox[{"x", ",", "\[Nu]", ",", "b"}], "]"}], "]"}], ",", 
     RowBox[{"Cos", "[", 
      RowBox[{"x", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          SuperscriptBox["b", "2"], "2"]}], ")"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "20"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.729535189096528*^9},ExpressionUUID->"b0e6c9aa-8436-4018-bdcb-\
15b08bd28db6"],

