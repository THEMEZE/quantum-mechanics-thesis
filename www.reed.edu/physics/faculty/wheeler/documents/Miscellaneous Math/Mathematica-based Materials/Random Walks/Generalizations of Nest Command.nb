Cell[TextData[{
 "and discover that both take about 4 seconds. But the latter draws white \
curves where the ",
 StyleBox["UnitStep", "Input"],
 " discontinuity is encountered. So I elect to go with the functions ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["f", "i"], "[", 
   RowBox[{"x", ",", "y"}], "]"}]],
  CellChangeTimes->{{3.534789332075932*^9, 3.534789340324645*^9}}],
 ".\n\nIn support of a point made previously, range around on the 2D \
interval"
}], "Text",
 CellChangeTimes->{{3.534789183094531*^9, 3.534789358134832*^9}, {
  3.53478960411173*^9, 3.534789646571938*^9}, {3.5347899641394987`*^9, 
  3.534790028954604*^9}}],

