Cell[TextData[{
 "I consolidate those commands, modified now so as to produce 250-step walks \
with a single \[EnterKey]. \n\nREMARK: I found while preparing this command \
that, when I tried similarly to produce 300-step walks, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " complained that \"the RecursionLimit has been exceeded.\" I think I had \
hit upon a machine limitation; when changed all 300s and 301s to 250s and \
251s everything progressed as smoothly (and almost as quickly) as it did the \
previous 200-step walks. The execution time on my iMac is about 2 seconds."
}], "Text",
 CellChangeTimes->{{3.534441256740345*^9, 3.5344414508726473`*^9}, {
   3.534441501740692*^9, 3.5344416555794573`*^9}, {3.534442217977392*^9, 
   3.53444234795951*^9}, 3.534442685127577*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A250", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"{", "\[NoBreak]", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{"{", 
            RowBox[{"R1", ",", " ", "R2", ",", " ", "R3"}], "}"}], "]"}], ",",
           " ", 
          RowBox[{"RandomChoice", "[", 
           RowBox[{"{", 
            RowBox[{"B1", ",", " ", "B2", ",", " ", "B3"}], "}"}], "]"}]}], 
         "\[NoBreak]", "}"}], "}"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "1", ",", " ", "250"}], "}"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B250", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"0", "1"},
           {"1", "0"}
          }], "\[NoBreak]", ")"}], ",", "k"}], "]"}], ".", 
      RowBox[{
      "A250", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "250"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Steps250", "=", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
          "B250", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "250"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["a", "k"], "=", 
        RowBox[{
         RowBox[{
         "Steps250", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", 
         StyleBox["1",
          FontColor->RGBColor[1, 0, 0]], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        SubscriptBox["b", "k"], "=", 
        RowBox[{
         RowBox[{
         "Steps250", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", 
         StyleBox["2",
          FontColor->RGBColor[1, 0, 0]], "\[RightDoubleBracket]"}]}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "251"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HexagonalWalk250", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"S", "[", "k", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "251"}], "}"}]}], "]"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", " ", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", " ", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "30"}], ",", "30"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "30"}], ",", "30"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", "Red"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EndPoints250", "=", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
