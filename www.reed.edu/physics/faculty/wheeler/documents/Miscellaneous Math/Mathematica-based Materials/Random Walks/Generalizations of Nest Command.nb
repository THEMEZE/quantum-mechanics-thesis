Cell["\<\
and use those to modify the composite command that generated the preceding \
figure (here the suffix UB signals \"Uniformly Biased\") \
\>", "Text",
 CellChangeTimes->{{3.534546343644435*^9, 3.5345464303908577`*^9}, {
  3.5345465197901783`*^9, 3.53454652719084*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A250UB", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"{", "\[NoBreak]", 
         RowBox[{
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              SubscriptBox["w", "1"], ",", 
              SubscriptBox["w", "2"], ",", 
              SubscriptBox["w", "3"]}], "}"}], "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"R1", ",", " ", "R2", ",", " ", "R3"}], "}"}]}], "]"}], 
          ",", " ", 
          RowBox[{"RandomChoice", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              SubscriptBox["w", "1"], ",", 
              SubscriptBox["w", "2"], ",", 
              SubscriptBox["w", "3"]}], "}"}], "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"B1", ",", " ", "B2", ",", " ", "B3"}], "}"}]}], "]"}]}],
          "\[NoBreak]", "}"}], "}"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "1", ",", " ", "250"}], "}"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B250UB", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"0", "1"},
           {"1", "0"}
          }], "\[NoBreak]", ")"}], ",", "k"}], "]"}], ".", 
      RowBox[{
      "A250UB", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "250"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Steps250UB", "=", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
          "B250UB", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "250"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["a", "k"], "=", 
        RowBox[{
         RowBox[{
         "Steps250UB", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}],
          "\[LeftDoubleBracket]", 
         StyleBox["1",
          FontColor->RGBColor[1, 0, 0]], "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{
        SubscriptBox["b", "k"], "=", 
        RowBox[{
         RowBox[{
         "Steps250UB", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}],
          "\[LeftDoubleBracket]", 
         StyleBox["2",
          FontColor->RGBColor[1, 0, 0]], "\[RightDoubleBracket]"}]}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "251"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], "=", 
