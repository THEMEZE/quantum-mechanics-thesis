Cell["\<\
But lessons learned from that computational experience are irrelevant to the \
problem now at hand.\
\>", "Text",
 CellChangeTimes->{{3.534694272594592*^9, 3.534694273529579*^9}, {
  3.534694386747299*^9, 3.53469441474133*^9}}],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.5346944298893757`*^9, 3.5346944325712976`*^9}}],

Cell[TextData[{
 "My initial intention had been to lay down a scalar field ",
 StyleBox["\[Phi][x,y]", "Output"],
 " and to use its directional derivatives to assign local value to ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["w", "1"], ",", 
    SubscriptBox["w", "2"], ",", 
    SubscriptBox["w", "3"]}], "}"}]],
  CellChangeTimes->{{3.5346948080596027`*^9, 3.5346948190853577`*^9}}],
 ". I look by way of preparation to the problem of \[Ellipsis]  "
}], "Text",
 CellChangeTimes->{{3.5346945793742332`*^9, 3.53469462603426*^9}, {
  3.534694682614802*^9, 3.5346947621841307`*^9}, {3.534694796405753*^9, 
  3.534694801220245*^9}, {3.534694833029254*^9, 3.5346948674066257`*^9}, {
  3.53469490403194*^9, 3.5346949084632587`*^9}, {3.534694942408702*^9, 
  3.534694948576762*^9}, {3.53469499848517*^9, 3.534694999707349*^9}, {
  3.534695037753265*^9, 3.53469504680536*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Directional derivative construction", "Subsubsection",
 CellChangeTimes->{{3.5346950068787107`*^9, 3.53469501338516*^9}}],

Cell["For illustrative purposes, let", "Text",
 CellChangeTimes->{{3.534702791439299*^9, 3.534702804314872*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y", ",", "\[Phi]"}], "]"}]], "Input",
 CellChangeTimes->{{3.5347030711194897`*^9, 3.5347030769751596`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"6", "\[Pi]"}]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["y", "2"]}], ")"}], "3"], 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"]}], ")"}]}]]}]}]], "Input",
 CellChangeTimes->{{3.5347028896813517`*^9, 3.534702970513805*^9}}],

Cell["\<\
This scalar field is rotationally symmetric; in polar coordinates it becomes\
\>", "Text",
 CellChangeTimes->{{3.534703003374958*^9, 3.534703007303259*^9}, {
  3.53470314937669*^9, 3.5347031602627497`*^9}, {3.534703199474533*^9, 
  3.534703228126539*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
    RowBox[{"r", " ", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.534703015903965*^9, 3.534703042772291*^9}, {
  3.5347030988671722`*^9, 3.534703101922936*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     SuperscriptBox["r", "2"]}]], " ", 
   SuperscriptBox["r", "6"]}], 
  RowBox[{"6", " ", "\[Pi]"}]]], "Output",
 CellChangeTimes->{{3.534703089604006*^9, 3.534703103645919*^9}}]
}, Open  ]],

Cell["\<\
and I have\[LongDash]for no good reason\[LongDash]arrannged for it to be \
normalized:\
\>", "Text",
 CellChangeTimes->{{3.534703250669488*^9, 3.5347032791464863`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"2", "\[Pi]", " ", "r", " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        SuperscriptBox["r", "2"]}]], " ", 
      SuperscriptBox["r", "6"]}], 
     RowBox[{"6", " ", "\[Pi]"}]]}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.534695426512391*^9, 3.534695449354208*^9}, 
   3.5346954849843616`*^9, {3.534695590672709*^9, 3.534695594904621*^9}, {
   3.534695637885292*^9, 3.534695649265793*^9}, 3.534695681280258*^9, 
   3.53469580510039*^9, {3.534703115607629*^9, 3.5347031320167437`*^9}}],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{
  3.534695454487988*^9, 3.534695486560017*^9, {3.53469565858366*^9, 
   3.5346956856679907`*^9}, 3.534695812220703*^9, 3.5347031374552393`*^9}]
}, Open  ]],

Cell["\<\
By design, it depends very simply on its arguments.

Here follow various graphic representations of \[Phi] :\
\>", "Text",
 CellChangeTimes->{{3.534703301558001*^9, 3.5347033281111307`*^9}, {
  3.534705046964889*^9, 3.5347050797818737`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", " ", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       SuperscriptBox["r", "2"]}]], " ", 
     SuperscriptBox["r", "6"]}], 
    RowBox[{"6", " ", "\[Pi]"}]], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.53469529672276*^9, 3.534695415274103*^9}, {
  3.5346955004779043`*^9, 3.534695501238043*^9}, {3.534695716239945*^9, 
  3.534695797628398*^9}, {3.534703832977346*^9, 3.534703838141527*^9}}],

