Cell[CellGroupData[{

Cell["From directional derivatives to weights", "Subsubsection",
 CellChangeTimes->{{3.5347128101277733`*^9, 3.5347128300311813`*^9}}],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s weighted ",
 StyleBox["RandomChoice", "Input"],
 " command accepts any set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["n", "1"], ",", 
     SubscriptBox["n", "2"], ",", 
     SubscriptBox["n", "3"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "} of positive numbers as weights, in the sense that it automatically \
normalizes those numbers"
}], "Text",
 CellChangeTimes->{{3.534712846573682*^9, 3.534713005701936*^9}, 
   3.5347131219025097`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["w", "1"], ",", 
    SubscriptBox["w", "2"], ",", 
    SubscriptBox["w", "3"]}], "}"}], "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      SubscriptBox["n", "1"], 
      RowBox[{
       SubscriptBox["n", "1"], "+", 
       SubscriptBox["n", "2"], "+", 
       SubscriptBox["n", "3"]}]], ",", 
     FractionBox[
      SubscriptBox["n", "2"], 
      RowBox[{
       SubscriptBox["n", "1"], "+", 
       SubscriptBox["n", "2"], "+", 
       SubscriptBox["n", "3"]}]], ",", 
     FractionBox[
      SubscriptBox["n", "3"], 
      RowBox[{
       SubscriptBox["n", "1"], "+", 
       SubscriptBox["n", "2"], "+", 
       SubscriptBox["n", "3"]}]]}], "}"}], "\[RawEscape]"}]}]], "Input",
 CellChangeTimes->{{3.5347130154475107`*^9, 3.5347131009128437`*^9}}],

Cell["as I demonstrate:", "Text",
 CellChangeTimes->{{3.53471312673075*^9, 3.534713130600787*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"RandomChoice", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "10000"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.534610043059019*^9, 3.534610065465076*^9}, {
  3.5346101010351667`*^9, 3.53461013164472*^9}}],

Cell[CellGroupData[{

