Cell[TextData[{
 "and observe that ",
 StyleBox["always one and sometimes two (but never all) of the \"chopped \
directional derivatives",
  FontVariations->{"Underline"->True}],
 "\" ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SubscriptBox["f", "1"], ",", 
    SubscriptBox["f", "3"], ",", 
    SubscriptBox["f", "5"]}], "}"}]],
  CellChangeTimes->{{3.534790224408181*^9, 3.534790235596958*^9}},
  FontVariations->{"Underline"->False}],
 " ",
 StyleBox["is zero",
  FontVariations->{"Underline"->True}],
 " (though at {x = 5, y = 5} we encounter {0, 0.001, 0.001} which would have \
been\[LongDash]in the displayed precision\[LongDash]{0, 0, 0} but for the \
additive 0.001 that was folded into the definitions of the ",
 Cell[BoxData[
  SubscriptBox["f", "i"]],
  CellChangeTimes->{{3.534790617847481*^9, 3.534790620313408*^9}}],
 ")."
}], "Text",
 CellChangeTimes->{{3.534790131925082*^9, 3.534790135260466*^9}, {
  3.534790165959371*^9, 3.5347902198616257`*^9}, {3.534790253857379*^9, 
  3.5347902967888927`*^9}, {3.534790398483308*^9, 3.534790639615582*^9}}],

Cell["\<\
As a final demonstration of where we now stand, I construct (which takes \
about 5 seconds)\
\>", "Text",
 CellChangeTimes->{{3.5347907885242*^9, 3.53479080291955*^9}, {
  3.534790986026225*^9, 3.534790995139*^9}}],

