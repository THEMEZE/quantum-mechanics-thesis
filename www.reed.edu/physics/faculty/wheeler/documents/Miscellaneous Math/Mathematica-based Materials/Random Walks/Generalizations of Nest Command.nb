       RowBox[{"Blue", ",", " ", 
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"S", "[", "251", "]"}], "]"}]}], "}"}]}], "}"}], "]"}]}], 
