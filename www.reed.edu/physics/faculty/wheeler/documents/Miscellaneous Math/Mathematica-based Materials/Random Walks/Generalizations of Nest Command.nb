Cell["\<\
in some recent work involving random walksw on rectangular grids. But random \
walks on hexagonal grids (\"graphene\") have the property that the \
step-options alternate; the patterns is ABABABABA instead AAAAAAAAA. This \
circumstance motivates me to looks for a generalization of the nest command \
that produces composite functions of the form\
\>", "Text",
 CellChangeTimes->{{3.534182589971817*^9, 3.5341825981078873`*^9}, {
  3.534182652331456*^9, 3.534182940902416*^9}}],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"g", "[", 
   RowBox[{"f", "[", 
    RowBox[{"g", "[", 
     RowBox[{"f", "[", "x", "]"}], "]"}], "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.534182947066382*^9, 3.5341829747290697`*^9}}],

Cell["and, more generally, ", "Text",
 CellChangeTimes->{{3.534182984178974*^9, 3.534182988266708*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["f", "5"], "[", 
  RowBox[{
   SubscriptBox["f", "4"], "[", 
   RowBox[{
    SubscriptBox["f", "3"], "[", 
    RowBox[{
     SubscriptBox["f", "2"], "[", 
     RowBox[{
      SubscriptBox["f", "1"], "[", "x", "]"}], "]"}], "]"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.534183005159544*^9, 3.534183035118828*^9}}],

Cell["\<\
This problem\[LongDash]the problem of producing such constructs \
automatically/efficiently\[LongDash]gave me so much difficulty that I was \
motivated to write for advice to Patrick T. Tam, author of \"A Physicist's \
Guide to Mathematica\" [I wrote on the 23rd, have as yet received no reply]. \
Here I describe several elementary solutions or the problem thus posed. \
\>", "Text",
 CellChangeTimes->{{3.53418305992236*^9, 3.534183139059044*^9}, {
  3.5341831970222816`*^9, 3.5341832223231277`*^9}, {3.5341833456367493`*^9, 
  3.534183346809074*^9}, {3.534183979692309*^9, 3.534184129028103*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.5341841681540823`*^9}]
}, Open  ]],

