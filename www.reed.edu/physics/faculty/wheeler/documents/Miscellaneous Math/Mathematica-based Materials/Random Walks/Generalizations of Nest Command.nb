Cell[TextData[{
 "The problem here is that when the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "k"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " are produced by some tabulated set of definitions they are enclosed in a \
collective {   }, and so long as those remain in place the ",
 StyleBox["Composition", "Input"],
 " command does not work:"
}], "Text",
