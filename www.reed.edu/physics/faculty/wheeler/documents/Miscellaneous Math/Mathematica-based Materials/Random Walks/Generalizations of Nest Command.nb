Cell[TextData[{
 "on the tile (origin at P, the point of tangency). It is clear that, however \
the figure is oriented (twirled about the point of tangency), ",
 StyleBox["at least one and not more than two of the arrows will have \
negative slope",
  FontVariations->{"Underline"->True}],
 ", the only exception arising when P marks a local minimum, maximum or a \
saddle point, where all arrows have zero slope."
}], "Text",
 CellChangeTimes->{{3.5347859675060472`*^9, 3.534786002345602*^9}, {
  3.534786033260293*^9, 3.534786173098312*^9}, {3.534786230445425*^9, 
  3.534786278964477*^9}, {3.534786323625098*^9, 3.534786392351994*^9}}],

