 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"RandomChoice", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["f", "1"], "[", 
         RowBox[{"1.53", ",", 
          RowBox[{"-", "0.35"}]}], "]"}], ",", 
        RowBox[{
