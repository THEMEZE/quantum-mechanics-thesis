   TraditionalForm]],
  FormatType->"TraditionalForm"],
 " with weight ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "2"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", \[DoubleStruckCapitalT] with weight ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "3"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ".  To that end, command"
}], "Text",
 CellChangeTimes->{{3.534544784761359*^9, 3.534544893076323*^9}}],

