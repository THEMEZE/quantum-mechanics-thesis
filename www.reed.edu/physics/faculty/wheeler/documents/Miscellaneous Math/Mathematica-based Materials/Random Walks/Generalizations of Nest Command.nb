Cell[TextData[{
 "It is at this point that we depart from the procedure spelled out in \
\"Hexagonal Walks\", in this specific regard: we use a recursive construction \
to replace the use made in \"Hexagonal Walks\" of the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    UnderoverscriptBox["\[Sum]", 
     RowBox[{" ", 
      RowBox[{"j", "  ", "=", "1"}]}], 
     RowBox[{"  ", "k"}]], "InlineFormula"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ". Define "
}], "Text",
 CellChangeTimes->{{3.534360277825858*^9, 3.534360333177351*^9}, {
  3.534437491692981*^9, 3.53443756614394*^9}, {3.534437614602232*^9, 
  3.53443769318296*^9}}],

