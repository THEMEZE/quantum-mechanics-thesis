    RowBox[{"\[Phi]", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}], ",", 
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], " ", 
    RowBox[{"\[Phi]", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}]], "Input",
