    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "10000"}], "}"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.534790815224976*^9, 3.5347909626944027`*^9}}],

