Cell["\<\
We propose to compute directional derivatives of \[Phi] in directions defined \
by six unit vectors\
\>", "Text",
 CellChangeTimes->{{3.534708794350465*^9, 3.534708817058967*^9}, {
   3.5347095328185987`*^9, 3.5347095474922953`*^9}, 3.53470958160388*^9, 
   3.53470965223211*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    SubscriptBox["e", "k"], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Pi]", "6"]}], "+", 
        RowBox[{"k", " ", 
         FractionBox["\[Pi]", "3"]}]}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Pi]", "6"]}], "+", 
        RowBox[{"k", " ", 
         FractionBox["\[Pi]", "3"]}]}], "]"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "6"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.5347053359221373`*^9, 3.5347054720219927`*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      SqrtBox["3"], "2"], ",", 
     FractionBox["1", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SqrtBox["3"], "2"]}], ",", 
     FractionBox["1", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SqrtBox["3"], "2"]}], ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      SqrtBox["3"], "2"], ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.5347054770077868`*^9}]
}, Open  ]],

