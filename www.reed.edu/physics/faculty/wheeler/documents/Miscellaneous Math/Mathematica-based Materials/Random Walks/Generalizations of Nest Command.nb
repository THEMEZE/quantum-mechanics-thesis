Cell[TextData[{
 StyleBox["The weighted ",
  FontVariations->{"Underline"->True}],
 StyleBox["RandomChoice", "Input",
  FontVariations->{"Underline"->True}],
 StyleBox[" command fails",
  FontVariations->{"Underline"->True}],
 ", however, if either (1) any proposed weight is negative, or (2) the sum of \
the proposed weights is zero (rendering normalization impossible). \n\nAn \
obvious way to deal with these circumstances is (1) to associate zero weight \
with all negative directional derivatives, and (2) to write"
}], "Text",
 CellChangeTimes->{{3.534713584110126*^9, 3.5347136790319157`*^9}, {
  3.534713716199284*^9, 3.534713716389789*^9}, {3.534784566906316*^9, 
  3.534784572572899*^9}, {3.534787203514535*^9, 3.534787208325992*^9}, {
  3.53478775642397*^9, 3.5347877996119757`*^9}, {3.534787834680398*^9, 
  3.534787900566141*^9}, {3.534787935970402*^9, 3.53478794517881*^9}}],

Cell[BoxData[
 RowBox[{"weight", " ", "=", " ", 
  RowBox[{
   RowBox[{"directional", " ", "derivative"}], " ", "+", " ", 
   RowBox[{"small", " ", "positive", " ", "constant"}]}]}]], "Output",
 CellChangeTimes->{{3.534787950447637*^9, 3.534787969212831*^9}}],

Cell["\<\
whenever the directional derivative is \[GreaterSlantEqual]  0. To that end, \
we construct\
\>", "Text",
 CellChangeTimes->{{3.5347879881760283`*^9, 3.5347880729674807`*^9}}],

