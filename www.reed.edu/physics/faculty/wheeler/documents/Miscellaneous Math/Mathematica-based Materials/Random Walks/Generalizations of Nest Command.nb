 CellChangeTimes->{{3.5346100865969467`*^9, 3.534610137800331*^9}}]
}, Open  ]],

Cell["\<\
We expect b to occur twice as often as a, and c to occur three times as often \
as a, and in fact we have\
\>", "Text",
 CellChangeTimes->{{3.5347131825354958`*^9, 3.534713262908527*^9}}],

