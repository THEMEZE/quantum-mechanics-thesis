       RowBox[{
        RowBox[{
        "Steps200", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
        "\[LeftDoubleBracket]", 
        StyleBox["1",
         FontColor->RGBColor[1, 0, 0]], "\[RightDoubleBracket]"}]}], ",", 
      RowBox[{
       SubscriptBox["b", "k"], "=", 
       RowBox[{
        RowBox[{
        "Steps200", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], 
        "\[LeftDoubleBracket]", 
        StyleBox["2",
         FontColor->RGBColor[1, 0, 0]], "\[RightDoubleBracket]"}]}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "201"}], "}"}]}], "]"}], ";"}]], "Input",
