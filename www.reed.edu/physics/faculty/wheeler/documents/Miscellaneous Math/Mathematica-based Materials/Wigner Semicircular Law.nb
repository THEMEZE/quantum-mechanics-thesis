Cell["\<\
This, I now argue, conforms well to our theoretical expectation. We are \
reminded\
\>", "Text",
 CellChangeTimes->{{3.520178203523534*^9, 3.520178225623719*^9}, {
  3.5201782563097687`*^9, 3.520178258541369*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hyperlink", "[", 
  RowBox[{
  "\"\<Sums of Normally Distributed Numbers\>\"", ",", 
   "\"\<http://en.wikipedia.org/wiki/Sum_of_normally_distributed_random_\
variables\>\""}], "]"}]], "Input",
 CellChangeTimes->{{3.520172295961556*^9, 3.520172344342675*^9}}],

Cell[BoxData[
 TagBox[
  ButtonBox[
   PaneSelectorBox[{False->"\<\"Sums of Normally Distributed Numbers\"\>", 
    True->
    StyleBox["\<\"Sums of Normally Distributed Numbers\"\>", 
     "HyperlinkActive"]}, Dynamic[
     CurrentValue["MouseOver"]],
    BaseStyle->{"Hyperlink"},
    BaselinePosition->Baseline,
    FrameMargins->0,
    ImageSize->Automatic],
   BaseStyle->"Hyperlink",
   ButtonData->{
     URL["http://en.wikipedia.org/wiki/Sum_of_normally_distributed_random_\
variables"], None},
   ButtonNote->
    "http://en.wikipedia.org/wiki/Sum_of_normally_distributed_random_\
variables"],
  Annotation[#, 
   "http://en.wikipedia.org/wiki/Sum_of_normally_distributed_random_\
variables", "Hyperlink"]& ]], "Output",
 CellChangeTimes->{3.520172351278852*^9}]
}, Open  ]],

Cell[TextData[{
 "that if X and Y are independent random variable drawn from normal \
distributions with standard deviations ",
 Cell[BoxData[
  SubscriptBox["\[Sigma]", "1"]],
  CellChangeTimes->{
   3.5201097402638407`*^9, {3.5201784111206713`*^9, 
    3.5201784128251877`*^9}}],
 " and ",
 Cell[BoxData[
  SubscriptBox["\[Sigma]", "2"]],
  CellChangeTimes->{
   3.5201097402638407`*^9, {3.5201784111206713`*^9, 3.5201784128251877`*^9}, 
    3.520178449365285*^9}],
 " then we expect sums X + Y to be normally distributed with ",
 Cell[BoxData[
  RowBox[{"\[Sigma]", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Sigma]", "1"], "2"], "+", 
     SuperscriptBox[
      SubscriptBox["\[Sigma]", "2"], "2"]}]]}]],
  CellChangeTimes->{{3.520178547031982*^9, 3.520178574416395*^9}}],
 ", and therefore expect the averaged sums ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"X", "+", "Y"}], "2"]],
  CellChangeTimes->{{3.520178660760985*^9, 3.5201786695807943`*^9}}],
 "to be normally distributed with"
}], "Text",
 CellChangeTimes->{{3.5201783495715923`*^9, 3.5201784001248302`*^9}, {
  3.5201784401686563`*^9, 3.520178471960517*^9}, {3.520178517785705*^9, 
  3.520178529493311*^9}, {3.5201786092862864`*^9, 3.520178643830473*^9}, {
  3.5201786835555887`*^9, 3.520178696923295*^9}}],

Cell[BoxData[
 RowBox[{"\[Sigma]", "=", 
  FractionBox[
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Sigma]", "1"], "2"], "+", 
     SuperscriptBox[
      SubscriptBox["\[Sigma]", "2"], "2"]}]], "2"]}]], "DisplayFormula",
 CellChangeTimes->{{3.5201787243190823`*^9, 3.52017875137901*^9}}],

Cell["Which in the present instance becomes", "Text",
 CellChangeTimes->{{3.520178779286141*^9, 3.5201787925335407`*^9}}],

Cell[BoxData[
 RowBox[{"\[Sigma]", "=", 
  RowBox[{
   FractionBox[
    SqrtBox[
     RowBox[{"1", "+", "1"}]], "2"], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], "=", "0.707107"}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.5201788229972*^9, 3.5201789081634083`*^9}}],

Cell[TextData[{
 "\[LongDash]in good agreement with the observed \[Sigma] \[Rule] 0.706164. \
We conclude that ",
 StyleBox["the procedure described above does in fact produce symmetric \
matrices with normally (and identically) distributed matrix elements", 
  "Subsection",
  FontSize->12],
 "\[Ellipsis]the statistical independence of which is compromised only by the \
symmetry constraint."
}], "Text",
 CellChangeTimes->{{3.520178965483639*^9, 3.520178985122649*^9}, 
   3.5201790266643667`*^9, {3.520179062246077*^9, 3.520179211830309*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.520179250150798*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Eigenvalues of symmetric matrices with normally distributed random elements\
\>", "Subsection",
 CellChangeTimes->{{3.5201792974800262`*^9, 3.520179332629533*^9}}],

Cell[CellGroupData[{

Cell["Large population of small matrices", "Subsubsection",
 CellChangeTimes->{{3.520181178515827*^9, 3.520181188624138*^9}, {
  3.5201816334789143`*^9, 3.520181635998096*^9}}],

Cell["\<\
We look first to the eigenvalues generated collectively by a population of \
10,000 10 \[Times] 10 normally distributed symmetric matrices: at 10 \
eigenvalues/matrix, this will be a 100,000-element set of eigenvalues.\
\>", "Text",
 CellChangeTimes->{{3.5201793983777227`*^9, 3.520179482556678*^9}, {
  3.520179621664133*^9, 3.520179632172209*^9}, {3.5201796701472273`*^9, 
  3.520179725846511*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianEigenvalues10", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"\[DoubleStruckCapitalM]", "+", 
           RowBox[{"Transpose", "[", "\[DoubleStruckCapitalM]", "]"}]}], "2"],
          "/.", 
         RowBox[{"\[DoubleStruckCapitalM]", "->", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "1"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"10", ",", "10"}], "}"}]}], "]"}]}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "10000"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input"],

Cell["\<\
Those eigenvalues are found all to fall within the interval [- 6.60, + 6.60]:\
\
\>", "Text",
 CellChangeTimes->{{3.520179994710935*^9, 3.520180005029501*^9}, {
  3.520180096651709*^9, 3.5201801218791227`*^9}, {3.5201801925557117`*^9, 
  3.520180206145979*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Max", "[", "GaussianEigenvalues10", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Min", "[", "GaussianEigenvalues10", "]"}]}], "Input",
 CellChangeTimes->{{3.5201011509894943`*^9, 3.520101175210359*^9}}],

Cell[BoxData["6.592802853951719`"], "Output",
 CellChangeTimes->{3.520101178155444*^9, 3.520179769568473*^9}],

Cell[BoxData[
 RowBox[{"-", "6.273452482931573`"}]], "Output",
 CellChangeTimes->{3.520101178155444*^9, 3.520179769607169*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"GaussianEigenvalues10", ",", " ", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10"}], ",", "10"}], "}"}]}], ",", " ", 
   RowBox[{"GridLines", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "6.6"}], ",", "6.6"}], "}"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.520101188965259*^9, 3.520101207081409*^9}, {
  3.5201798464067*^9, 3.520179873456934*^9}}],

