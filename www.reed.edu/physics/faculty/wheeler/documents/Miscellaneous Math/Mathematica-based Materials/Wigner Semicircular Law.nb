Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.520216329260298*^9}],

Cell[TextData[{
 "The ",
 StyleBox["radius of the Wigner semicircle",
  FontVariations->{"Underline"->True}],
 " can be read as the ",
 StyleBox["expected (absolute) value of the largest eigenvalue",
  FontVariations->{"Underline"->True}],
 ". In the present instance (1000 \[Times] 1000 matrix with normally \
distributed matrix elements, standard deviation ",
 Cell[BoxData[
  RowBox[{"\[Sigma]", "=", 
   RowBox[{"1", "/", 
    SqrtBox["2"]}]}]],
  CellChangeTimes->{{3.520253757739856*^9, 3.520253773713719*^9}}],
 " ",
 "= 0.707107",
 ") we found"
}], "Text",
 CellChangeTimes->{{3.520253409597776*^9, 3.520253432267931*^9}, {
  3.520253493160471*^9, 3.520253520021215*^9}, {3.520253585518214*^9, 
  3.520253609668272*^9}, {3.520253645880101*^9, 3.520253654705123*^9}, {
  3.5202536880128927`*^9, 3.520253736001906*^9}, {3.520253795897838*^9, 
  3.520253796489963*^9}, {3.5202538670180893`*^9, 3.5202538986481113`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Wigner", " ", "radius"}], " ", "=", " ", 
  RowBox[{
   RowBox[{"largest", " ", "eigenvalue"}], "=", 
   "44.7472"}]}]], "DisplayFormula",
 CellChangeTimes->{{3.52025391235993*^9, 3.520253968772561*^9}}],

Cell["in which connection it is interesting to notice that", "Text",
 CellChangeTimes->{{3.520254027990981*^9, 3.520254050645944*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  SqrtBox[
   RowBox[{"2", "*", "1000"}]], "]"}]], "Input",
 CellChangeTimes->{{3.520254064520756*^9, 3.5202540909019136`*^9}}],

Cell[BoxData["44.721359549995796`"], "Output",
 CellChangeTimes->{3.5202540989673443`*^9}]
}, Open  ]],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.520254138825739*^9}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conclusions drawn from numerical data now in hand", "Subsection",
 CellChangeTimes->{{3.520254148339007*^9, 3.520254163398036*^9}}],

Cell[TextData[{
 "Let the elements of the N-dimensional square matrix \[DoubleStruckCapitalM] \
be normally distributed with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "M"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " = 1. Then\n"
}], "Text",
 CellChangeTimes->{{3.520254315644209*^9, 3.520254429174449*^9}, {
   3.520254698448081*^9, 3.5202547049638643`*^9}, 3.520254956149659*^9}],

Cell[TextData[{
 "\[Bullet] The elements of the N-dimensional symmetric matrix ",
 Cell[BoxData[
  RowBox[{"\[DoubleStruckCapitalS]", "=", 
   FractionBox[
    RowBox[{"\[DoubleStruckCapitalM]", "+", 
     SuperscriptBox["\[DoubleStruckCapitalM]", "transpose"]}], "2"]}]],
  CellChangeTimes->{{3.520254598109495*^9, 3.520254599355907*^9}}],
 " (\[DoubleStruckCapitalS]  is simply the ",
 StyleBox["symmetric part",
  FontVariations->{"Underline"->True}],
 " of \[DoubleStruckCapitalM]) are normally distributed with ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Sigma]", "S"], "=", 
   RowBox[{"1", "/", 
    SqrtBox["2"]}]}]],
  CellChangeTimes->{{3.520253757739856*^9, 3.520253773713719*^9}}],
 ". More generally, we have"
}], "Text",
 CellChangeTimes->{{3.520254508683535*^9, 3.5202545438978558`*^9}, {
  3.520254616772011*^9, 3.520254656326727*^9}, {3.520254714760846*^9, 
  3.520254755614476*^9}, {3.520262554660102*^9, 3.5202625788944283`*^9}}],

Cell[BoxData[
 RowBox[{
  SubscriptBox["\[Sigma]", "S"], "=", 
  RowBox[{
   FractionBox[
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[Sigma]", "M"], "2"], "+", 
      SuperscriptBox[
       SubscriptBox["\[Sigma]", "M"], "2"]}]], "2"], "=", 
   FractionBox[
    SubscriptBox["\[Sigma]", "M"], 
    SqrtBox["2"]]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.5202547638231*^9, 3.520254894557639*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.520254942843471*^9}],

Cell["\<\
\[Bullet] The eigenvalues of \[DoubleStruckCapitalS] can be expected to \
conform well to Wigner's Semicircular Law if N > about 1000, but for N \
\[LessLess] 1000 they conform to N-dependent \"Sombrero Laws\" for which we \
possess as yet no analytic description.\
\>", "Text",
 CellChangeTimes->{
  3.5202549906732693`*^9, {3.520255035890195*^9, 3.5202550932682*^9}, {
   3.520255192529298*^9, 3.5202552181494226`*^9}, {3.520255260907135*^9, 
   3.520255268121294*^9}, {3.520255334383894*^9, 3.520255370051265*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.5202554364308662`*^9}],

Cell[TextData[{
 "\[Bullet] The spectrum of \[DoubleStruckCapitalS] is\[LongDash]for N \
sufficiently large\[LongDash]bounded (exactly? in good approximation?) by ",
 Cell[BoxData[
  RowBox[{"\[PlusMinus]", 
   SqrtBox[
    RowBox[{"2", "N"}]]}]],
  CellChangeTimes->{{3.520256464879815*^9, 3.5202564669080048`*^9}}],
 "."
}], "Text",
 CellChangeTimes->{{3.5202554702725143`*^9, 3.520255486206772*^9}, {
  3.520256341642646*^9, 3.520256427893488*^9}, {3.520256508771781*^9, 
  3.520256512086947*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.520256535218474*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Effect of adjusting the value of \[Sigma]\
\>", "Subsection",
 CellChangeTimes->{{3.5202565456839743`*^9, 3.5202565564041643`*^9}}],

Cell["\<\
I look specifically the consequences of the adjustment \[Sigma] = 1 \
\[RightArrow] 2.\
\>", "Text",
 CellChangeTimes->{{3.520256578523883*^9, 3.520256601420573*^9}, {
  3.5202566416293373`*^9, 3.520256644946459*^9}}],

Cell["\<\
REMARK: I wish I had assigned a new name to this list. But it took so long to \
generate (on my home office IMac) that I refrain from that adjustment.\
\>", "Text",
 CellChangeTimes->{{3.520261199420271*^9, 3.52026132363583*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianEigenvalues1000", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"\[DoubleStruckCapitalM]", "+", 
           RowBox[{"Transpose", "[", "\[DoubleStruckCapitalM]", "]"}]}], "2"],
          "/.", 
         RowBox[{"\[DoubleStruckCapitalM]", "->", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "2"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"1000", ",", "1000"}], "}"}]}], "]"}]}]}], "]"}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "50"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.520256754908901*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Max", "[", "GaussianEigenvalues1000", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Min", "[", "GaussianEigenvalues1000", "]"}]}], "Input",
 CellChangeTimes->{{3.520101919754281*^9, 3.520101921655304*^9}, {
  3.5201865111698523`*^9, 3.520186512343006*^9}}],

