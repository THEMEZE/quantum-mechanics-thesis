Cell[CellGroupData[{

Cell["Construction of normally distributed symmetric matrices", "Subsection",
 CellChangeTimes->{{3.520106736829419*^9, 3.5201067658369303`*^9}}],

Cell["\<\
This is the resource I will use to randomize individual matrix elements: \
\>", "Text",
 CellChangeTimes->{{3.5201061168833942`*^9, 3.5201061185855837`*^9}, {
  3.5201061754251623`*^9, 3.520106210645076*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "NormalDistribution"}]], "Input",
 CellChangeTimes->{{3.520100275927473*^9, 3.520100282190508*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"NormalDistribution\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"\[Mu]\\\", \\\"TR\\\"], \\\",\\\", StyleBox[\\\"\[Sigma]\
\\\", \\\"TR\\\"]}], \\\"]\\\"}]\\) represents a normal (Gaussian) \
distribution with mean \[Mu] and standard deviation \
\[Sigma].\\n\\!\\(\\*RowBox[{\\\"NormalDistribution\\\", \\\"[\\\", \
\\\"]\\\"}]\\) represents a normal distribution with zero mean and unit \
standard deviation.\"\>", "MSG"], "\[NonBreakingSpace]", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NormalDistribution"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.520100283654739*^9},
 CellTags->"Info3520071483-3085981"]
}, Open  ]],

Cell[TextData[{
 "REMARK: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"standard", " ", "deviation"}], " ", "=", 
   SqrtBox["variance"]}]],
  CellChangeTimes->{{3.520175511786236*^9, 3.520175524357535*^9}}],
 ", and has the same units as the random variable."
}], "Text",
 CellChangeTimes->{{3.5201754850365477`*^9, 3.520175500758441*^9}, {
  3.5201755593092813`*^9, 3.520175594179543*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "PDF"}]], "Input",
 CellChangeTimes->{{3.5201003429941807`*^9, 3.520100345522602*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"PDF\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"dist\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"x\\\", \\\
\"TI\\\"]}], \\\"]\\\"}]\\) gives the probability density function for the \
symbolic distribution \\!\\(\\*StyleBox[\\\"dist\\\", \\\"TI\\\"]\\) \
evaluated at \\!\\(\\*StyleBox[\\\"x\\\", \\\"TI\\\"]\\).\\n\\!\\(\\*RowBox[{\
\\\"PDF\\\", \\\"[\\\", StyleBox[\\\"dist\\\", \\\"TI\\\"], \\\"]\\\"}]\\) \
gives the PDF as a pure function.\"\>", "MSG"], "\[NonBreakingSpace]", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/PDF"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.520100347265882*^9},
 CellTags->"Info3520071547-9773474"]
}, Open  ]],

