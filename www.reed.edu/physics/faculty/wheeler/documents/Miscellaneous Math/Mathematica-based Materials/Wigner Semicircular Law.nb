Cell[TextData[{
 "we see that the hat as pretty much lost its brims. The scatter is so \
plausibly semicircular that it becomes worth while to make the adjustments \
required to display density ",
 StyleBox["vs",
  FontSlant->"Italic"],
 ". eigen",
 StyleBox["value",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{{3.520189894314282*^9, 3.520189987556823*^9}, {
  3.520190023202591*^9, 3.520190065832285*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"BinProb1000", "[", "k_", "]"}], ":=", 
  RowBox[{
   FractionBox["GaussianEigenvalueCounts1000", "50000"], 
   "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}]}]], "Input",
 CellChangeTimes->{{3.5202124118881903`*^9, 3.520212472831965*^9}, {
   3.5202125089569387`*^9, 3.520212514120371*^9}, 3.520212672332631*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"BinProb1000", "[", "k", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "460"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.5202126873759336`*^9, 3.520212723451017*^9}}],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.520212727403583*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"BinWidth", "=", "0.2"}], ";"}]], "Input",
 CellChangeTimes->{{3.520212740473318*^9, 3.520212768892555*^9}, 
   3.5202128480887613`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"EigenvalueDensity1000", "[", "k_", "]"}], ":=", 
  FractionBox[
   RowBox[{"BinProb1000", "[", "k", "]"}], "0.2"]}]], "Input",
 CellChangeTimes->{{3.520212782390121*^9, 3.5202128419617367`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"EigenvalueDistribution1000", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "46.1"}], "+", 
        RowBox[{"0.2", "k"}]}], ",", 
       RowBox[{"EigenvalueDensity1000", "[", "k", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "460"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.520212920426931*^9, 3.5202130419737883`*^9}, 
   3.520213126582177*^9, 3.520213164253375*^9}],

