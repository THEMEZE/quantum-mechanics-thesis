Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.5201290789251337`*^9}],

Cell["\<\
I produce numerical evidence that the individual elements of matrices \
constructed in this way (I look specifically to a typical 200 \[Times] 200 \
matrix; i.e., to a list of 40,000 matrix elements) are in fact normally \
distributed\
\>", "Text",
 CellChangeTimes->{{3.520107896466289*^9, 3.520107956662431*^9}, {
  3.520107992679438*^9, 3.520108067335373*^9}, {3.520108101211442*^9, 
  3.5201081138984413`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"ListOfMatrixElements", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"\[DoubleStruckCapitalG]", "+", 
       RowBox[{"Transpose", "[", "\[DoubleStruckCapitalG]", "]"}]}], "2"], "/.", 
     RowBox[{"\[DoubleStruckCapitalG]", "->", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "1"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"200", ",", "200"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.520106451495414*^9, 3.520106508594632*^9}, {
  3.5201065668537827`*^9, 3.520106598658688*^9}, {3.520107183665288*^9, 
  3.520107187860146*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Length", "[", "ListOfMatrixElements", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Min", "[", "ListOfMatrixElements", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Max", "[", "ListOfMatrixElements", "]"}]}], "Input",
