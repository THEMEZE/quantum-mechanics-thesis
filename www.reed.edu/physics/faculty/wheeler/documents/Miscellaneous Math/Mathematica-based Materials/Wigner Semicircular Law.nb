Cell[TextData[{
 "REMARK: The herringbone pattern is a reflection simply of the \
matrix-by-matrix sequence in which ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " elects to deploy the elements of the eigenvalue set, and has become \
visible because of the reduced size of the present population of matrices. "
}], "Text",
 CellChangeTimes->{{3.520189639572915*^9, 3.5201898077279243`*^9}}],

Cell["\<\
Partitioning the interval into bins of width 0.20\[LongDash]of which there \
will be a total of \
\>", "Text",
 CellChangeTimes->{
  3.520188024103331*^9, {3.520188109993215*^9, 3.520188160674541*^9}, {
   3.520188529228758*^9, 3.5201885321558123`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 FractionBox[
  RowBox[{"46", "+", "46"}], ".2"]], "Input",
 CellChangeTimes->{{3.5201805223904657`*^9, 3.520180546504982*^9}, {
   3.520181300132587*^9, 3.520181308339576*^9}, {3.52018806833037*^9, 
   3.5201881038585567`*^9}, 3.520188412128879*^9, {3.520188477646944*^9, 
   3.520188515967208*^9}, {3.52018935643398*^9, 3.520189359270111*^9}}],

Cell[BoxData["460.`"], "Output",
 CellChangeTimes->{{3.520188096802397*^9, 3.520188104491267*^9}, 
   3.520188425749118*^9, 3.52018853814883*^9, 3.5201893673957777`*^9}]
}, Open  ]],

Cell["\<\
\[LongDash]we distribute the eigenvalues into their respective bins\
\>", "Text",
 CellChangeTimes->{3.520188174317465*^9, 3.520189380036347*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianEigenvalueCounts1000", "=", 
   RowBox[{"BinCounts", "[", 
    RowBox[{"GaussianEigenvalues1000", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "46"}], ",", "46", ",", ".2"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.52010129145603*^9, 3.5201013143226233`*^9}, {
