Cell["\<\
All of those numbers fall within the interval [-3, +3]. I partition the \
interval into 120 bins, each of width\
\>", "Text",
 CellChangeTimes->{{3.520175686271761*^9, 3.520175772648272*^9}, {
  3.5201758168099422`*^9, 3.5201758298613987`*^9}, {3.520177020921945*^9, 
  3.520177046605505*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BinWidth", "=", "0.05"}]], "Input",
 CellChangeTimes->{{3.520177000525793*^9, 3.5201770082263927`*^9}}],

Cell[BoxData["0.05`"], "Output",
 CellChangeTimes->{3.520177012522469*^9}]
}, Open  ]],

Cell["The bins have endpoints at ", "Text",
 CellChangeTimes->{3.520177052622631*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"BinBoundaries", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], "+", 
      RowBox[{".05", "j"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "120"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.520175835169836*^9, 3.520175892329421*^9}, 
   3.520175930847295*^9, 3.52017600851115*^9, {3.520176215883909*^9, 
   3.5201762338980513`*^9}, 3.5201763064812737`*^9}],

Cell["and midpoints at", "Text",
 CellChangeTimes->{{3.520175940953249*^9, 3.5201759444703827`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"BinCenters", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2.975"}], "+", 
      RowBox[{".05", "k"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "119"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.5201759505893583`*^9, 3.5201759521050673`*^9}, {
   3.520175982647338*^9, 3.520175991361561*^9}, {3.520176024407811*^9, 
   3.520176032389016*^9}, {3.520176068594409*^9, 3.520176073451008*^9}, {
   3.5201761911695023`*^9, 3.520176202834858*^9}, {3.520176242905149*^9, 
   3.5201762461211357`*^9}, 3.520176319168654*^9}],

Cell["\<\
We distribute the 40,000 matrix elements into their respective bins\
\>", "Text",
 CellChangeTimes->{{3.520176358249404*^9, 3.520176376325493*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "BinCounts"}]], "Input",
 CellChangeTimes->{{3.5201764151637497`*^9, 3.5201764205339108`*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"BinCounts\\\", \\\"[\\\", \
RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"x\\\", \
\\\"TI\\\"], StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\
\[Ellipsis]\\\", \\\"TR\\\"]}], \\\"}\\\"}], \\\"]\\\"}]\\) counts the number \
of elements \\!\\(\\*SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"i\\\", \\\"TI\\\"]]\\) whose values lie in successive integer \
bins.\\n\\!\\(\\*RowBox[{\\\"BinCounts\\\", \\\"[\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \
\\\"TI\\\"], StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"2\\\", \
\\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\"TR\\\"]}], \\\"}\\\
\"}], \\\",\\\", StyleBox[\\\"dx\\\", \\\"TI\\\"]}], \\\"]\\\"}]\\) counts \
the number of elements \\!\\(\\*SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"i\\\", \\\"TI\\\"]]\\) whose values lie in successive bins of \
width \\!\\(\\*StyleBox[\\\"dx\\\", \
\\\"TI\\\"]\\).\\n\\!\\(\\*RowBox[{\\\"BinCounts\\\", \\\"[\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \
\\\"TI\\\"], StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"2\\\", \
\\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\"TR\\\"]}], \\\"}\\\
\"}], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \
\\\"TI\\\"], StyleBox[\\\"min\\\", \\\"TI\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"max\\\", \
\\\"TI\\\"]], \\\",\\\", StyleBox[\\\"dx\\\", \\\"TI\\\"]}], \\\"}\\\"}]}], \
\\\"]\\\"}]\\) counts the number of \\!\\(\\*SubscriptBox[StyleBox[\\\"x\\\", \
\\\"TI\\\"], StyleBox[\\\"i\\\", \\\"TI\\\"]]\\) in successive bins of width \
\\!\\(\\*StyleBox[\\\"dx\\\", \\\"TI\\\"]\\) from \
\\!\\(\\*SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]]\\) to \\!\\(\\*SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]]\\). \\n\\!\\(\\*RowBox[{\\\"BinCounts\\\", \
\\\"[\\\", RowBox[{RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\
\"TR\\\"]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"b\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"b\\\", \\\"TI\\\"], \
StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\
\"TR\\\"]}], \\\"}\\\"}], \\\"}\\\"}]}], \\\"]\\\"}]\\) counts the number of \
\\!\\(\\*SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"i\\\", \\\
\"TI\\\"]]\\) in the intervals \\!\\(\\*RowBox[{RowBox[{\\\"[\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"b\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"b\\\", \\\"TI\\\"], \
StyleBox[\\\"2\\\", \\\"TR\\\"]]}]}], \\\")\\\"}]\\), \
\\!\\(\\*RowBox[{RowBox[{\\\"[\\\", RowBox[{SubscriptBox[StyleBox[\\\"b\\\", \
\\\"TI\\\"], StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"b\\\", \\\"TI\\\"], StyleBox[\\\"3\\\", \
\\\"TR\\\"]]}]}], \\\")\\\"}]\\), \\!\\(\\*StyleBox[\\\"\[Ellipsis]\\\", \
\\\"TR\\\"]\\). \\n\\!\\(\\*RowBox[{\\\"BinCounts\\\", \\\"[\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], \
StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\
\"TR\\\"]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"2\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], \
StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\
\"TR\\\"]}], \\\"}\\\"}], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \
\\\"TR\\\"]}], \\\"}\\\"}], \\\",\\\", StyleBox[\\\"xbins\\\", \\\"TI\\\"], \
\\\",\\\", StyleBox[\\\"ybins\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"\
\[Ellipsis]\\\", \\\"TR\\\"]}], \\\"]\\\"}]\\) gives an array of counts where \
the first index corresponds to \\!\\(\\*StyleBox[\\\"x\\\", \\\"TI\\\"]\\) \
bins, the second to \\!\\(\\*StyleBox[\\\"y\\\", \\\"TI\\\"]\\), and so on. \
\"\>", "MSG"], "\[NonBreakingSpace]", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/BinCounts"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.520176422236806*^9},
 CellTags->"Info3520147621-4592085"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"MatrixElementBinCounts", "=", 
   RowBox[{"BinCounts", "[", 
    RowBox[{"ListOfMatrixElements", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3", ",", ".05"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "MatrixElementBinCounts", "]"}]}], "Input",
 CellChangeTimes->{{3.5201068718458767`*^9, 3.52010695734647*^9}, {
   3.520107003179421*^9, 3.5201070036823483`*^9}, {3.520107046218261*^9, 
   3.520107047092082*^9}, {3.5201292308581038`*^9, 3.520129234214604*^9}, {
   3.520129305846764*^9, 3.520129316971019*^9}, 3.520176467545169*^9, {
   3.520176517813982*^9, 3.52017652092185*^9}, {3.520176584393437*^9, 
   3.520176590380784*^9}, 3.5201766385021*^9}],

Cell[BoxData["120"], "Output",
 CellChangeTimes->{
  3.5201070082880573`*^9, 3.520107053042573*^9, 3.52010721215799*^9, 
   3.5201292413237667`*^9, 3.520129318142642*^9, 3.520176530130537*^9, 
   3.52017659204939*^9, {3.520176629845735*^9, 3.520176639064774*^9}}]
}, Open  ]],

Cell["and verify that every matrix element has found a home:", "Text",
 CellChangeTimes->{{3.520176659327881*^9, 3.520176681907336*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", "MatrixElementBinCounts", "]"}]], "Input"],

Cell[BoxData["40000"], "Output",
 CellChangeTimes->{3.520176691398387*^9}]
}, Open  ]],

Cell[TextData[{
 "On this evidence, the probability that a matrix element will be found in \
the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "th"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " bin is"
}], "Text",
 CellChangeTimes->{{3.520176745514658*^9, 3.5201767842538233`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Prob", "[", "k_", "]"}], ":=", 
  FractionBox[
   RowBox[{
   "MatrixElementBinCounts", "\[LeftDoubleBracket]", "k", 
    "\[RightDoubleBracket]"}], "40000"]}]], "Input",
 CellChangeTimes->{{3.5201298855877943`*^9, 3.520129894073339*^9}, {
  3.5201299253908*^9, 3.520129940807357*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"Prob", "[", "k", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "120"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.520129952746044*^9, 3.520129977700925*^9}, {
  3.520176819586537*^9, 3.520176820151094*^9}}],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.520129981738203*^9, 3.520176822089023*^9}]
}, Open  ]],

Cell[TextData[{
 "and the ",
 StyleBox["probability density",
  FontVariations->{"Underline"->True}],
 " at the centerpoint of the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "th"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " bin is "
}], "Text",
 CellChangeTimes->{{3.52017690504891*^9, 3.520176932572318*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"ProbDensity", "[", "k_", "]"}], ":=", 
  FractionBox[
   RowBox[{"Prob", "[", "k", "]"}], "BinWidth"]}]], "Input",
 CellChangeTimes->{{3.520176955214312*^9, 3.520176967021215*^9}, {
  3.520177132420889*^9, 3.520177149708449*^9}}],

