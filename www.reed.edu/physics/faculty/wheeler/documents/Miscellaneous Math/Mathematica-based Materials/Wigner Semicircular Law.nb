Cell["\<\
and look for the normal distribution function that best conforms to that data:\
\>", "Text",
 CellChangeTimes->{{3.52017790352258*^9, 3.520177949271686*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindFit", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "3.025"}], "+", 
        RowBox[{".05", "k"}]}], ",", 
       RowBox[{"ProbDensity", "[", "k", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "120"}], "}"}]}], "]"}], ",", 
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"m", ",", "\[Sigma]"}], "]"}], ",", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"m", ",", "\[Sigma]"}], "}"}], ",", "x"}], "]"}]], "Input",
