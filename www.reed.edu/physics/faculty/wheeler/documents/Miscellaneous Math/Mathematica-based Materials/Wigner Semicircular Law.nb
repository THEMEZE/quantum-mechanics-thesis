Cell["\<\
Partitioning the interval into bins of width 0.05\[LongDash]of which there \
will be a total of \
\>", "Text",
 CellChangeTimes->{{3.520181225765972*^9, 3.520181281626137*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 FractionBox[
  RowBox[{"6.6", "+", "6.6"}], ".05"]], "Input",
 CellChangeTimes->{{3.5201805223904657`*^9, 3.520180546504982*^9}, {
  3.520181300132587*^9, 3.520181308339576*^9}}],

Cell[BoxData["264.`"], "Output",
 CellChangeTimes->{{3.5201805393338337`*^9, 3.5201805478873177`*^9}, 
   3.5201813179282713`*^9}]
}, Open  ]],

Cell["we distribute the eigenvalues into their respective bins", "Text",
 CellChangeTimes->{{3.520180301292617*^9, 3.5201804231250887`*^9}, {
  3.520181339555971*^9, 3.52018135003835*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianEigenvalueCounts10", "=", 
   RowBox[{"BinCounts", "[", 
    RowBox[{"GaussianEigenvalues10", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6.6"}], ",", "6.6", ",", ".05"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.52010129145603*^9, 3.5201013143226233`*^9}, {
  3.520180273658128*^9, 3.520180279506131*^9}}],

Cell[CellGroupData[{

