Cell[TextData[{
 "and this is the construction I will use to create populations of ",
 StyleBox["randomized real symmetric matrices",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 ":"
}], "Text",
 CellChangeTimes->{{3.520106254963605*^9, 3.520106315337006*^9}, {
  3.520106349897952*^9, 3.520106364765832*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalS]", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[DoubleStruckCapitalG]", "+", 
      RowBox[{"Transpose", "[", "\[DoubleStruckCapitalG]", "]"}]}], "2"], "/.", 
    RowBox[{"\[DoubleStruckCapitalG]", "->", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[DoubleStruckCapitalS]", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.520100722131502*^9, 3.520100755879039*^9}, {
  3.52010080463649*^9, 3.520100892802998*^9}}],

