 FractionBox["90.24", "45.26"]], "Input",
 CellChangeTimes->{{3.5202623123025837`*^9, 3.5202623392235537`*^9}, {
  3.520262373853565*^9, 3.520262382900468*^9}}],

Cell[BoxData["1.993813521873619`"], "Output",
 CellChangeTimes->{3.520262386211937*^9}]
}, Open  ]],

Cell[TextData[{
 "It appears plausible on this basis to speculate that the spectrum is \
bounded by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[PlusMinus]", "\[Sigma]"}], 
   SqrtBox[
    RowBox[{"2", "N"}]]}]],
  CellChangeTimes->{{3.520262493675042*^9, 3.52026249774546*^9}}],
 "."
}], "Text",
