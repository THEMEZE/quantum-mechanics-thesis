Cell["\<\
This distribution evidently speaks again of a well-defined curve, but one \
that is markedly less Gaussian, more nearly semicircular than before.\
\>", "Text",
 CellChangeTimes->{{3.520185091948126*^9, 3.520185205929838*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.5201852390601387`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Still smaller population of still larger matrices", "Subsubsection",
 CellChangeTimes->{{3.520185243799972*^9, 3.520185282820943*^9}}],

Cell["\<\
We look now to a (to keep the computation time down, only) 50-member \
population of 1000 \[Times] 1000 matrices, which will generate a reduced set \
of only 50,000 eigenvalues.\
\>", "Text",
 CellChangeTimes->{{3.520185399474392*^9, 3.520185420981176*^9}, {
  3.52018769043841*^9, 3.5201877675613203`*^9}, {3.52018861612044*^9, 
  3.520188632135511*^9}}],

Cell["\<\
REMARK: Execution of the following command takes several minutes.\
\>", "Text",
 CellChangeTimes->{{3.52019436390711*^9, 3.520194381671525*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianEigenvalues1000", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"\[DoubleStruckCapitalM]", "+", 
           RowBox[{"Transpose", "[", "\[DoubleStruckCapitalM]", "]"}]}], "2"],
          "/.", 
         RowBox[{"\[DoubleStruckCapitalM]", "->", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "1"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"1000", ",", "1000"}], "}"}]}], "]"}]}]}], "]"}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "50"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.520101853018299*^9, 3.520101868901388*^9}, {
   3.520185567183193*^9, 3.5201855849555902`*^9}, 3.520185870715685*^9, 
   3.5201869968710337`*^9, {3.520187076768547*^9, 3.520187080009989*^9}, {
   3.5201871900623426`*^9, 3.520187192154448*^9}, {3.520187226222349*^9, 
   3.520187296991432*^9}, {3.520187653292019*^9, 3.520187677268594*^9}, 
   3.520188607610889*^9}],

Cell[CellGroupData[{

