Cell["\<\
The distribution evidently speaks of a well-defined curve that is, however,  \
neither Gaussian nor semicircular.\
\>", "Text",
 CellChangeTimes->{{3.520181440379848*^9, 3.520181443496451*^9}, {
  3.520181534914948*^9, 3.5201815812009373`*^9}}],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{3.520181587273561*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Smaller population of larger matrices", "Subsubsection",
 CellChangeTimes->{{3.5201816025608587`*^9, 3.520181613015115*^9}}],

Cell["\<\
We look now to a 1000-member population of 100 \[Times] 100 matrices, which \
will again generate a set of 100,000 eigenvalues.\
\>", "Text",
 CellChangeTimes->{{3.5201816582119427`*^9, 3.5201817482304773`*^9}, {
  3.5201817790644484`*^9, 3.5201818455451202`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianEigenvalues100", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Chop", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"\[DoubleStruckCapitalM]", "+", 
           RowBox[{"Transpose", "[", "\[DoubleStruckCapitalM]", "]"}]}], "2"],
          "/.", 
         RowBox[{"\[DoubleStruckCapitalM]", "->", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "1"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"100", ",", "100"}], "}"}]}], "]"}]}]}], "]"}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "1000"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.520101853018299*^9, 3.520101868901388*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Max", "[", "GaussianEigenvalues100", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Min", "[", "GaussianEigenvalues100", "]"}]}], "Input",
 CellChangeTimes->{{3.520101919754281*^9, 3.520101921655304*^9}}],

Cell[BoxData["15.158663700529655`"], "Output",
 CellChangeTimes->{3.520101926558799*^9, 3.520181901481785*^9}],

Cell[BoxData[
 RowBox[{"-", "15.139933320713236`"}]], "Output",
 CellChangeTimes->{3.520101926558799*^9, 3.520181901489848*^9}]
}, Open  ]],

