        "8", ",", "9", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "8", ",", "13", ",", "21", ",", "34", ",", "55"}], 
       "}"}]}], "}"}]}], ",", 
   StyleBox[
    RowBox[{"AxesOrigin", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}],
    FontColor->RGBColor[1, 0, 0]]}], "]"}]], "Input",
