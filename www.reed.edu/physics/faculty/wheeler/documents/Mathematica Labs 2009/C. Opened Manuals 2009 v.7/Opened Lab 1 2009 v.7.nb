Cell["\<\
Adjustment of the numerics would, of course, result in different curves.  It \
is not immediately obvious why the present numerics (1, 7 & \[LongDash]17) \
generate 6-fold symmetry!\
\>", "Text",
 CellChangeTimes->{{3.3948435979841948`*^9, 3.3948436007778482`*^9}, {
  3.395953932394042*^9, 3.395953946219349*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394843609030545*^9, 3.394843609124502*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Third Example: Lissajous Figures", "Subsubsection",
 CellChangeTimes->{{3.3948436267993307`*^9, 3.3948436371928988`*^9}}],

Cell["\<\
The following construction is familiar to anyone who has ever played with an \
oscilloscope:\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "x", ",", "y"}], "]"}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"t_", ",", "a_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"a", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"\[Alpha]", " ", "t"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", 
   RowBox[{"t_", ",", "b_", ",", "\[Beta]_", ",", "\[Delta]_"}], "]"}], ":=", 
  
  RowBox[{"b", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{"\[Beta]", " ", "t"}], "+", "\[Delta]"}], "]"}]}]}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"t", ",", "2", ",", "2"}], "]"}], ",", 
      RowBox[{"y", "[", 
       RowBox[{"t", ",", "1", ",", "3.00", ",", 
        RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"16", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"t", ",", "2", ",", "2"}], "]"}], ",", 
     RowBox[{"y", "[", 
      RowBox[{"t", ",", "1", ",", 
       StyleBox["3.01",
        FontColor->RGBColor[0, 0, 1]], ",", 
       RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"16", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.3948437195546207`*^9, 3.3948437463013678`*^9}}],

