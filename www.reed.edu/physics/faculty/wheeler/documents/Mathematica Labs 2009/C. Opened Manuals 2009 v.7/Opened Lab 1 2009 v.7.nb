Cell["\<\
which reveals a slight departure from linearity at the ends. The mystery is \
explained when we command\
\>", "Text",
 CellChangeTimes->{{3.394839167586508*^9, 3.3948391920266047`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  StyleBox["Series",
   FontColor->RGBColor[1, 0, 0]], "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "+", 
    RowBox[{"ArcSin", "[", "x", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "15"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"2", " ", "x"}], "+", 
   FractionBox[
    SuperscriptBox["x", "5"], "12"], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["x", "7"]}], "45"], "+", 
   FractionBox[
    RowBox[{"5513", " ", 
     SuperscriptBox["x", "9"]}], "181440"], "+", 
   FractionBox[
    RowBox[{"2537", " ", 
     SuperscriptBox["x", "11"]}], "113400"], "+", 
   FractionBox[
    RowBox[{"4156001", " ", 
     SuperscriptBox["x", "13"]}], "239500800"], "+", 
   FractionBox[
    RowBox[{"285335441", " ", 
     SuperscriptBox["x", "15"]}], "20432412000"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "x", "]"}], "16"],
    SeriesData[$CellContext`x, 0, {}, 1, 16, 1],
    Editable->False]}],
  SeriesData[$CellContext`x, 0, {2, 0, 0, 0, 
    Rational[1, 12], 0, 
    Rational[2, 45], 0, 
    Rational[5513, 181440], 0, 
    Rational[2537, 113400], 0, 
    Rational[4156001, 239500800], 0, 
    Rational[285335441, 20432412000]}, 1, 16, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.394839210155319*^9}]
}, Open  ]],

Cell[TextData[{
 "and discover that\[LongDash]remarkably\[LongDash]the Maclaurin expansion \
has ",
 StyleBox["no terms of orders 2, 3, or 4",
  FontVariations->{"Underline"->True}],
 ". We made first-time use here of the following resource:"
}], "Text",
 CellChangeTimes->{{3.395947277163391*^9, 3.395947298695216*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", 
  StyleBox["Series",
   FontColor->RGBColor[1, 0, 0]]}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"Series\\\", \\\"[\\\", RowBox[{StyleBox[\
\\\"f\\\", \\\"TI\\\"], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{StyleBox[\\\"x\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"0\\\", \
\\\"TR\\\"]], \\\",\\\", StyleBox[\\\"n\\\", \\\"TI\\\"]}], \\\"}\\\"}]}], \\\
\"]\\\"}]\\) generates a power series expansion for \\!\\(\\*StyleBox[\\\"f\\\
\", \\\"TI\\\"]\\) about the point \\!\\(\\*RowBox[{StyleBox[\\\"x\\\", \
\\\"TI\\\"], \\\"=\\\", SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"0\\\", \\\"TR\\\"]]}]\\) to order \
\\!\\(\\*SuperscriptBox[RowBox[{\\\"(\\\", RowBox[{StyleBox[\\\"x\\\", \\\"TI\
\\\"], \\\"-\\\", SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"0\\\", \\\"TR\\\"]]}], \\\")\\\"}], StyleBox[\\\"n\\\", \\\"TI\\\
\"]]\\). \\n\\!\\(\\*RowBox[{\\\"Series\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"f\\\", \\\"TI\\\"], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{StyleBox[\\\"x\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"0\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"n\\\", \\\"TI\\\"], \
StyleBox[\\\"x\\\", \\\"TI\\\"]]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"{\\\", RowBox[{StyleBox[\\\"y\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], StyleBox[\\\"0\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"n\\\", \\\"TI\\\"], \
StyleBox[\\\"y\\\", \\\"TI\\\"]]}], \\\"}\\\"}]}], \\\"]\\\"}]\\) \
successively finds series expansions with respect to \
\\!\\(\\*StyleBox[\\\"x\\\", \\\"TI\\\"]\\), then \
\\!\\(\\*StyleBox[\\\"y\\\", \\\"TI\\\"]\\). \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Series"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.394839250279213*^9},
 CellTags->"Info3394814047-6229429"]
}, Open  ]],

Cell[TextData[{
 "The dangling ",
 StyleBox["O", "Output"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", "x", "]"}], "16"], TraditionalForm]]],
 StyleBox[" is an uninformative annoyance, but is easily  avoided: ", 
  "DisplayFormula"]
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], "+", 
     RowBox[{"ArcSin", "[", "x", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "15"}], "}"}]}], "]"}], 
  StyleBox["//",
   FontColor->RGBColor[1, 0, 0]], 
  StyleBox["Normal",
   FontColor->RGBColor[1, 0, 0]]}]], "Input",
 CellChangeTimes->{{3.394839324171137*^9, 3.394839324354602*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", "x"}], "+", 
  FractionBox[
   SuperscriptBox["x", "5"], "12"], "+", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["x", "7"]}], "45"], "+", 
  FractionBox[
   RowBox[{"5513", " ", 
    SuperscriptBox["x", "9"]}], "181440"], "+", 
  FractionBox[
   RowBox[{"2537", " ", 
    SuperscriptBox["x", "11"]}], "113400"], "+", 
  FractionBox[
   RowBox[{"4156001", " ", 
    SuperscriptBox["x", "13"]}], "239500800"], "+", 
  FractionBox[
   RowBox[{"285335441", " ", 
    SuperscriptBox["x", "15"]}], "20432412000"]}]], "Output",
 CellChangeTimes->{{3.3948393105521307`*^9, 3.3948393259943542`*^9}}]
}, Open  ]],

