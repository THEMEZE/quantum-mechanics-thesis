Cell[TextData[{
 StyleBox["Red", "Input"],
 ", ",
 StyleBox["Green", "Input"],
 " and ",
 StyleBox["Blue", "Input"],
 " are basic color attributes. For information about more refined degrees of \
color control, trace the ",
 StyleBox["\[RightSkeleton]",
  FontColor->RGBColor[0, 0, 1]],
 "s in"
}], "Text",
 CellChangeTimes->{{3.3959466544848413`*^9, 3.39594668059234*^9}, {
  3.395946716180147*^9, 3.3959468000290127`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"?", "RGBColor"}], "\[IndentingNewLine]", 
 RowBox[{"?", "Hue"}]}], "Input",
 CellChangeTimes->{{3.3959468092426643`*^9, 3.395946822435974*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"RGBColor\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"red\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"green\\\", \
\\\"TI\\\"], \\\",\\\", StyleBox[\\\"blue\\\", \\\"TI\\\"]}], \\\"]\\\"}]\\) \
is a graphics directive which specifies that objects which follow are to be \
displayed, if possible, in the color given. \
\\n\\!\\(\\*RowBox[{\\\"RGBColor\\\", \\\"[\\\", RowBox[{StyleBox[\\\"r\\\", \
\\\"TI\\\"], \\\",\\\", StyleBox[\\\"g\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\
\\\"b\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"a\\\", \\\"TI\\\"]}], \\\"]\\\
\"}]\\) specifies opacity \\!\\(\\*StyleBox[\\\"a\\\", \\\"TI\\\"]\\). \"\>", 
   "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/RGBColor"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.3959468453547287`*^9},
 CellTags->"Info3395921644-1021250"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"Hue\\\", \\\"[\\\", StyleBox[\\\"h\\\", \
\\\"TI\\\"], \\\"]\\\"}]\\) is a graphics directive which specifies that \
objects which follow are to be displayed, if possible, in a color \
corresponding to hue \\!\\(\\*StyleBox[\\\"h\\\", \\\"TI\\\"]\\). \
\\n\\!\\(\\*RowBox[{\\\"Hue\\\", \\\"[\\\", RowBox[{StyleBox[\\\"h\\\", \
\\\"TI\\\"], \\\",\\\", StyleBox[\\\"s\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\
\\\"b\\\", \\\"TI\\\"]}], \\\"]\\\"}]\\) specifies colors in terms of hue, \
saturation and brightness. \\n\\!\\(\\*RowBox[{\\\"Hue\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"h\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"s\\\", \
\\\"TI\\\"], \\\",\\\", StyleBox[\\\"b\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\
\\\"a\\\", \\\"TI\\\"]}], \\\"]\\\"}]\\) specifies opacity \\!\\(\\*StyleBox[\
\\\"a\\\", \\\"TI\\\"]\\). \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Hue"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.395946845916842*^9},
 CellTags->"Info3395921645-9582558"]
}, Open  ]]
}, Open  ]],

