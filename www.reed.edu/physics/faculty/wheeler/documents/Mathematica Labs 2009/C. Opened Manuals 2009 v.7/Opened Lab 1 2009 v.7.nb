Cell[TextData[{
 "The graph is remarkable for its unexpected ",
 StyleBox["linearity",
  FontSlant->"Italic"],
 ". To gain a sense of ",
 StyleBox["how",
  FontSlant->"Italic"],
 " linear it truly is, we might proceed as follows: we find the equation of \
the straight line that approximates the preceding curve in the neighborhood \
of its mid-section"
}], "Text",
 CellChangeTimes->{{3.3959481992814493`*^9, 3.395948247521491*^9}, {
  3.3959482785386953`*^9, 3.3959483299661093`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", "a", "]"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"a", "=", 
  RowBox[{
   RowBox[{"Sin", "[", ".5", "]"}], "+", 
   RowBox[{"ArcSin", "[", ".5", "]"}]}]}]], "Input"],

Cell[BoxData["1.003024314202502`"], "Output",
 CellChangeTimes->{3.394839082306423*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"linear", "[", "x_", "]"}], ":=", 
  RowBox[{
   FractionBox["a", ".5"], "x", "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Equation", " ", "of", " ", "a", " ", "straight", " ", "line", " ", 
     "passing", " ", "through", " ", "a", " ", "couple", " ", "of", " ", 
     "selected", " ", "points", " ", "on", " ", "the", " ", "curve"}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.394838952333075*^9, 3.3948389918855*^9}}],

Cell[TextData[{
 StyleBox["NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 " the technique used to attach an explanatory remark to the definition."
}], "Text",
 CellChangeTimes->{{3.3948390198071003`*^9, 3.394839053183514*^9}}],

Cell[TextData[{
 "and then ",
 StyleBox["superimpose",
  FontWeight->"Bold"],
 " the curve and line:"
}], "Text",
 CellChangeTimes->{{3.395948338961814*^9, 3.3959483623798847`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    StyleBox["{",
     FontColor->RGBColor[1, 0, 0]], 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], "+", 
      RowBox[{"ArcSin", "[", "x", "]"}]}], ",", 
     RowBox[{"linear", "[", "x", "]"}]}], 
    StyleBox["}",
     FontColor->RGBColor[1, 0, 0]]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "0.85"}], ",", "0.85"}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", " ", 
   RowBox[{"FrameTicks", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.8"}], ",", "0.8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.394839070167983*^9, 3.3948391114800653`*^9}}],

