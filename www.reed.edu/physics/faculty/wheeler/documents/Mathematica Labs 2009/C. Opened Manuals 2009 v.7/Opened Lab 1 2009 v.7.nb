Cell[CellGroupData[{

Cell["Example: Eigenstates of a Particle in a Triangular Box", "Subsubsection",
 CellChangeTimes->{{3.3949006839779863`*^9, 3.394900735365864*^9}}],

Cell["\<\
Several years ago I had occasion (\"2-dimensional 'particle-in-a-box' \
problems in quantum mechanics\" (1997)) to study the quantum mechanics of \
particles confined to the interior of polygonal boxes of various favorable \
shapes.  The 45-45-90 box led to eigenfunctions of a form which I first \
describe and then plot:\
\>", "Text",
 CellChangeTimes->{{3.394900783394182*^9, 3.39490082966826*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"m", ",", "n", ",", "x", ",", "y"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boxfunction", "[", 
   RowBox[{"x_", ",", "y_", ",", "m_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"m", " ", "\[Pi]", " ", "x"}], "]"}], 
    RowBox[{"Sin", "[", 
     RowBox[{"n", " ", "\[Pi]", " ", "y"}], "]"}]}], "-", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"n", " ", "\[Pi]", " ", "x"}], "]"}], 
    RowBox[{"Sin", "[", 
     RowBox[{"m", " ", "\[Pi]", " ", "y"}], "]"}]}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groundstate", "=", 
   RowBox[{
    RowBox[{
     StyleBox["ContourPlot",
      FontColor->GrayLevel[0]], "[", 
     RowBox[{
      RowBox[{"boxfunction", "[", 
       RowBox[{"x", ",", "y", ",", 
        StyleBox["1",
         FontColor->RGBColor[0, 0, 1]], ",", 
        StyleBox["2",
         FontColor->RGBColor[0, 0, 1]]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "//", "Timing"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"excitedstate", "=", 
   RowBox[{
    RowBox[{
     StyleBox["ContourPlot",
      FontColor->GrayLevel[0]], "[", 
     RowBox[{
      RowBox[{"boxfunction", "[", 
       RowBox[{"x", ",", "y", ",", 
        StyleBox["2",
         FontColor->RGBColor[1, 0, 0]], ",", 
        StyleBox["3",
         FontColor->RGBColor[1, 0, 0]]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "//", "Timing"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"highlyexcitedstate", "=", 
  RowBox[{
   RowBox[{
    StyleBox["ContourPlot",
     FontColor->GrayLevel[0]], "[", 
    RowBox[{
     RowBox[{"boxfunction", "[", 
      RowBox[{"x", ",", "y", ",", 
       StyleBox["11",
        FontColor->RGBColor[1, 0, 0]], ",", 
       StyleBox["15",
        FontColor->RGBColor[1, 0, 0]]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "//", 
   "Timing"}]}]}], "Input",
 CellChangeTimes->{{3.394900908457801*^9, 3.394900911250101*^9}, {
  3.394900966906063*^9, 3.3949010055156803`*^9}, {3.3949011196665697`*^9, 
  3.394901135183569*^9}, {3.3949012168244333`*^9, 3.3949012232826357`*^9}, {
  3.394901272347909*^9, 3.3949013161561747`*^9}}],

