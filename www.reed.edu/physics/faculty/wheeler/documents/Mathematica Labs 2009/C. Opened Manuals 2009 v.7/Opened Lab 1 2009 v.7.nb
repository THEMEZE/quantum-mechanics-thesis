Cell[TextData[{
 "Notice that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has no trouble at all with the asymptotic infinities."
}], "Text",
 CellChangeTimes->{{3.394828721681036*^9, 3.3948288064814663`*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394828806634111*^9, 3.394828806642281*^9}}],

Cell["\<\
We look now to a few basic elaborations of the preceding command. First we \
place the ticks\[LongDash]what are \"ticks\"?\
\>", "Text",
 CellChangeTimes->{{3.3948288082128*^9, 3.394828829931869*^9}, 
   3.39482890095114*^9, {3.39482927936838*^9, 3.3948293059152193`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Ticks"}]], "Input",
 CellChangeTimes->{{3.394828920830749*^9, 3.394828922408271*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"Ticks is an option for graphics functions that specifies tick \
marks for axes. \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Ticks"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.394829328213951*^9},
 CellTags->"Info3394804127-1411188"]
}, Open  ]],

Cell["\<\
\[LongDash]at trigonometrically more natural positions:\
\>", "Text",
 CellChangeTimes->{{3.394829346354748*^9, 3.394829361475958*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Tan", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "20"}], "}"}], ",", " ", 
   RowBox[{"Ticks", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Pi]", ",", 
        RowBox[{"2", "\[Pi]"}], ",", 
        RowBox[{"3", "\[Pi]"}], ",", 
        RowBox[{"4", "\[Pi]"}], ",", 
        RowBox[{"5", "\[Pi]"}], ",", 
        RowBox[{"6", "\[Pi]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "4"}], ",", 
        RowBox[{"-", "2"}], ",", "2", ",", "4"}], "}"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.394828412807159*^9, 3.394828527672235*^9}}],

