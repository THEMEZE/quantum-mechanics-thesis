Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    StyleBox["{",
     FontColor->RGBColor[1, 0, 0]], 
    RowBox[{
     RowBox[{"sechsquared", "[", "x", "]"}], ",", " ", 
