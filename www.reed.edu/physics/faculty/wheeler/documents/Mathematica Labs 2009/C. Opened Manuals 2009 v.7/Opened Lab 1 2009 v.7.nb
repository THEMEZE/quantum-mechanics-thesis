}, Open  ]],

Cell["Next we increase the \"thickness\" of the curves:", "Text",
 CellChangeTimes->{{3.3948293800302134`*^9, 3.394829417180669*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"?", "Thickness"}], "\[IndentingNewLine]", 
 RowBox[{"?", "AbsoluteThickness"}]}], "Input",
 CellChangeTimes->{{3.394829435668871*^9, 3.394829459251482*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"Thickness\\\", \\\"[\\\", StyleBox[\\\"r\
\\\", \\\"TI\\\"], \\\"]\\\"}]\\) is a graphics directive which specifies \
that lines which follow are to be drawn with thickness \
\\!\\(\\*StyleBox[\\\"r\\\", \\\"TI\\\"]\\). The thickness \\!\\(\\*StyleBox[\
\\\"r\\\", \\\"TI\\\"]\\) is given as a fraction of the total width of the \
graphic. \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Thickness"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.39482946485938*^9},
 CellTags->"Info3394804264-6340409"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"AbsoluteThickness\\\", \\\"[\\\", \
StyleBox[\\\"d\\\", \\\"TI\\\"], \\\"]\\\"}]\\) is a graphics directive which \
specifies that lines which follow are to be drawn with absolute thickness \\!\
\\(\\*StyleBox[\\\"d\\\", \\\"TI\\\"]\\). \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/AbsoluteThickness"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.394829465299769*^9},
 CellTags->"Info3394804265-7801828"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 StyleBox["NOTE",
  FontWeight->"Bold"],
 ": Absolute thickness is measured in printer's points: one point = one 72nd \
of an inch."
}], "Text",
 CellChangeTimes->{{3.394829495591321*^9, 3.3948295584712048`*^9}}],

