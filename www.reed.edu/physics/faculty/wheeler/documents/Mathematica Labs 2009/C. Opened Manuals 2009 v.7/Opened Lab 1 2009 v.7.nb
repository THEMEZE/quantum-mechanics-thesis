Cell[TextData[{
 StyleBox["Now something absolutely amazing\[LongDash]new to v.6",
  FontSize->18,
  FontColor->RGBColor[1, 0, 0]],
 ": place the cursor on the figure, it turns into a pair of arrows, chasing \
one another around an ellipse. ",
 StyleBox["Drag",
  FontWeight->"Bold"],
 " that modified cursor around and the figure revolves, so that ",
 StyleBox["you can few the plotted surface from all angles, from above and \
below",
  FontVariations->{"Underline"->True}],
 "! "
}], "Text",
 CellChangeTimes->{{3.394845570087714*^9, 3.394845592014916*^9}, {
  3.3948456497065887`*^9, 3.394845857762722*^9}, {3.394845978854289*^9, 
  3.394845981369267*^9}}],

