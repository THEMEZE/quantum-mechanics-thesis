Cell["", "Text",
 CellChangeTimes->{{3.3949023580264473`*^9, 3.394902358060338*^9}}],

Cell["", "Text"],

Cell[TextData[{
 "In ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6 has been enabled also to plot the ",
 StyleBox["solutions of equations in two variables",
  FontWeight->"Bold"],
 ". In previous versions of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " this important capability was assigned to the (now obsolete) command ",
 StyleBox["ImplicitPlot", "Input"],
 ", which was activated only by importation of a standard package, and never \
worked very well (was slow, often led to computer crashes)."
}], "Text",
 CellChangeTimes->{{3.394899481866839*^9, 3.394899482956088*^9}, {
  3.394899737876563*^9, 3.394899744415694*^9}, {3.394900322145051*^9, 
