Cell[TextData[{
 "The Gaussian with that same mean (which is to say: is centered at ",
 StyleBox["x",
  FontSlant->"Italic"],
 " = 0) and variance \[Sigma] is defined"
}], "Text",
 CellChangeTimes->{{3.394840206400525*^9, 3.3948402334966803`*^9}, {
  3.395948449921692*^9, 3.395948527734826*^9}, {3.395948570951048*^9, 
  3.395948571991188*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaussian", "[", 
   RowBox[{"x_", ",", "\[Sigma]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"\[Sigma]", 
     SqrtBox[
      RowBox[{"2", "\[Pi]"}]]}]], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["x", "\[Sigma]"], ")"}], "2"]}], "]"}]}]}]], "Input"],

Cell["We want to compare the preceding figure with", "Text",
 CellChangeTimes->{{3.394840268726954*^9, 3.394840287055039*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"gaussian", "[", 
