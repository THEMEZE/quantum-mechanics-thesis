Cell[CellGroupData[{

Cell["Second Example: Epicycles", "Subsubsection",
 CellChangeTimes->{{3.3948431063297462`*^9, 3.39484311418589*^9}}],

Cell[TextData[{
 "The following is taken from Stan Wagon's discussion of an idea developed by \
Norton Starr (Amherst College): A wheel of given radius turns with given \
angular velocity. Pinned at its circumference is a second wheel of given \
radius that turns with given angular velocity.  And pinned to its \
circumference is a third wheel\[Ellipsis]",
 StyleBox["etc",
  FontSlant->"Italic"],
 ". We are interested in the motion of a point marked on the circumference of \
the last wheel.  In a specific instance, Wagon was led thus to the following \
command/figure:  "
}], "Text",
 CellChangeTimes->{{3.394843218822551*^9, 3.394843241193863*^9}, {
  3.394843498792512*^9, 3.394843502133762*^9}, {3.394843532775881*^9, 
  3.394843562064315*^9}, {3.3959538222566433`*^9, 3.3959538860560503`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "}"}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"7", "\[Theta]"}], "]"}], ",", 
       RowBox[{"Sin", "[", 
        RowBox[{"7", "\[Theta]"}], "]"}]}], "}"}]}], "+", 
    RowBox[{
     FractionBox["1", "3"], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "17"}], "\[Theta]"}], "+", 
         FractionBox["\[Pi]", "2"]}], "]"}], ",", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "17"}], "\[Theta]"}], "+", 
         FractionBox["\[Pi]", "2"]}], "]"}]}], "}"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.3948434351470747`*^9, 3.394843438923478*^9}}],

