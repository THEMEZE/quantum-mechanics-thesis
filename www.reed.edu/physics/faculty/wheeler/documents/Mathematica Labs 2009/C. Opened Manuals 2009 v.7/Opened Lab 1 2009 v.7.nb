Cell[CellGroupData[{

Cell["2D Projections of 3D Surfaces", "Subsection",
 CellChangeTimes->{{3.394897206202486*^9, 3.394897255405077*^9}, {
  3.394897290514863*^9, 3.3948972953820343`*^9}},
 FontSize->24,
 FontColor->RGBColor[1, 0, 0]],

Cell[TextData[{
 "Though my subtitle might be interpreted to refer to the screen display of a \
3-dimensional surface, such as we have just been viewing, what I have in mind \
is more like the relation of a topographic map to the 3D model of a mountain \
range. In this connection, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides two distinct resources: ",
 StyleBox["DensityPlot", "Input"],
 " and ",
 StyleBox["ContourPlot", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.394897597355847*^9, 3.394897745722207*^9}, {
  3.395954626193655*^9, 3.395954635028664*^9}}],

Cell[TextData[{
 "We have already had occasion to consider how ",
 StyleBox["Plot3D", "Input"],
 " displays the function:"
}], "Text",
 CellChangeTimes->{{3.394897836569853*^9, 3.394897875009775*^9}, 
   3.39489796269425*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     RowBox[{"3", 
      SuperscriptBox["y", "2"]}]}], ")"}], 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"], "-", 
     SuperscriptBox["y", "2"]}]]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]], "Input"],

