Cell["\<\
Then we construct a line indicating the direction in which the charged \
particle has been assumed to be accelerating:\
\>", "Text",
 CellChangeTimes->{3.394850768179624*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"acceleration", "=", 
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"Boxed", "\[Rule]", "False"}]}], " ", "]"}]}]], "Input",
 CellChangeTimes->{3.39485079546841*^9, 3.394850884247061*^9, 
  3.394850925297892*^9}],

Cell[BoxData[
 Graphics3DBox[
  {RGBColor[1, 0, 0], AbsoluteThickness[2], 
   Line3DBox[{{0, 0, 0}, {0, 0, 1}}]},
  Boxed->False]], "Output",
 CellChangeTimes->{3.3948508025634527`*^9, 3.394850889096099*^9, 
  3.394850926693428*^9}]
}, Open  ]],

Cell["And finally we superimpose the two figures:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"{", 
