Cell[TextData[{
 "Use the mouse to make the arrow point to one of the contour lines: ",
 StyleBox["a little box then announces the value that the function assumes on \
that contour",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{{3.3949022539842854`*^9, 3.394902307085062*^9}}],

Cell[TextData[{
 StyleBox["ContourPlot", "Input"],
 " has comes with many options. Below I show the effect of exercising a \
couple of them:"
}], "Text",
 CellChangeTimes->{{3.394899326361305*^9, 3.394899375586495*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", " ", 
   RowBox[{"ContourShading", "\[Rule]", "None"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.394898688315868*^9, 3.394898721427561*^9}, {
  3.394899031163476*^9, 3.394899039758317*^9}}],

