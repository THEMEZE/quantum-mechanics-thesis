Cell[CellGroupData[{

Cell[TextData[StyleBox["Filled Plots",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.394839496727326*^9, 3.394839500022666*^9}}],

Cell[TextData[{
 "Go to ",
 StyleBox["Help > Documentation Center",
  FontWeight->"Bold"],
 ", launch a search for ",
 StyleBox["ref/Plot",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" (which will take you back to a tutorial notebook you have already \
seen), scroll down the page a short distance and encounter examples of \
several kinds of \"filled plots.\" Here follows an example of the utility of \
that device, taken from some of my own work.",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.394839645834878*^9, 3.394839693400504*^9}, {
  3.394839724902948*^9, 3.3948397632576113`*^9}, {3.394839797427682*^9, 
  3.39483990940168*^9}}],

Cell[TextData[{
 "In ",
 StyleBox["Gaussian Wavepackets",
  FontSlant->"Italic"],
 " (1998) I had occasion to notice that the following function"
}], "Text",
 CellChangeTimes->{3.3948399425418053`*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"sechsquared", "[", "x_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], 
   SuperscriptBox[
    RowBox[{"Sech", "[", "x", "]"}], "2"]}]}]], "Input"],

Cell["\<\
has all the properties required of a probability distribution: it is \
everywhere non-negative, and\
\>", "Text",
 CellChangeTimes->{{3.394840002030102*^9, 3.3948400122212553`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
  RowBox[{
   RowBox[{"sechsquared", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Input"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.3948400309233294`*^9}]
}, Open  ]],

Cell["Moreover", "Text",
 CellChangeTimes->{{3.3948400463850946`*^9, 3.394840047453497*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
  RowBox[{"x", " ", 
   RowBox[{"sechsquared", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"sechsquared", "[", "x", "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]}], "Input",
 CellChangeTimes->{{3.394840070502406*^9, 3.3948400709862003`*^9}}],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.394840077455984*^9}],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[Pi]", "2"], "12"]], "Output",
 CellChangeTimes->{3.394840081299034*^9}]
}, Open  ]],

Cell["and when plotted it looks very Gaussian (very \"normal\"):", "Text",
 CellChangeTimes->{{3.394840095928616*^9, 3.394840113303424*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"sechsquared", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{3.3948401300392027`*^9, 3.394840305052806*^9}],

