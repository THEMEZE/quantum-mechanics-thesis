Cell[CellGroupData[{

Cell["\<\
Second Example: Sector of a Spherical Shell\
\>", "Subsubsection",
 CellChangeTimes->{{3.394895860927656*^9, 3.394895900844433*^9}}],

Cell["\<\
It takes two parameters to identify the points on a surface; here we use \
co-latitude \[Theta] and longitude \[Phi] to parameterize the points on the \
surface of a sphere:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"\[Phi]_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", "\[Theta]", "]"}], 
   RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", 
   RowBox[{"\[Phi]_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", "\[Theta]", "]"}], 
   RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "[", 
   RowBox[{"\[Phi]_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"\[Phi]", ",", "\[Theta]"}], "]"}], ",", 
     RowBox[{"y", "[", 
      RowBox[{"\[Phi]", ",", "\[Theta]"}], "]"}], ",", 
     RowBox[{"z", "[", 
      RowBox[{"\[Phi]", ",", "\[Theta]"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", "0", ",", 
     FractionBox[
      RowBox[{"3", "\[Pi]"}], "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", 
     FractionBox["\[Pi]", "20"], ",", 
     FractionBox[
      RowBox[{"19", "\[Pi]"}], "20"]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Boxed", "\[Rule]", "False"}], ",", " ", 
   RowBox[{"Axes", "\[Rule]", "None"}]}], "]"}]], "Input",
 CellChangeTimes->{3.394895957277834*^9}],

