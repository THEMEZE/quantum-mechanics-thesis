Cell[CellGroupData[{

Cell["Third Example: Torus", "Subsubsection",
 CellChangeTimes->{{3.394896046189559*^9, 3.394896054585688*^9}}],

Cell["Here is a variant of the same basic idea:", "Text",
 CellChangeTimes->{{3.394896105164908*^9, 3.394896113483686*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y", ",", "z", ",", "u", ",", "v"}], "]"}]], "Input",
 CellChangeTimes->{{3.394896613115643*^9, 3.394896620159246*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394896847726944*^9, 3.394896847744501*^9}}],

Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold"],
 ": The fact that ",
 StyleBox["u", "Input",
  FontColor->RGBColor[0, 0, 1]],
 " and ",
 StyleBox["v", "Input",
  FontColor->RGBColor[0, 0, 1]],
 " were blue before we entered the ",
 StyleBox["Clear", "Input"],
 " command indicated that they were already clear. After execution of the \
command ",
 StyleBox["all",
  FontSlant->"Italic"],
 " the variables in question became blue (= clear)."
}], "Text",
 CellChangeTimes->{{3.3948966572507772`*^9, 3.394896761132084*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394896842484704*^9, 3.394896842499308*^9}}],

Cell["We can, if we wish, consider", "Text",
 CellChangeTimes->{{3.394896857768684*^9, 3.394896866245894*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Cos", "[", "u", "]"}], 
   RowBox[{"(", 
    RowBox[{"2", "+", 
     RowBox[{"Cos", "[", "v", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", 
   RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", "u", "]"}], 
   RowBox[{"(", 
    RowBox[{"2", "+", 
     RowBox[{"Cos", "[", "v", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z", "[", 
   RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
  RowBox[{"Sin", "[", "v", "]"}]}]}], "Input",
 CellChangeTimes->{{3.3948968817833033`*^9, 3.394896966403304*^9}}],

Cell[TextData[{
 "to be components of a ",
 StyleBox["single vector-valued function of two parameters",
  FontVariations->{"Underline"->True}],
 ":"
}], "Text",
 CellChangeTimes->{{3.394896985893136*^9, 3.3948970130310173`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPhi]", "[", 
   RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", 
     RowBox[{"u", ",", "v"}], "]"}], ",", 
    RowBox[{"y", "[", 
     RowBox[{"u", ",", "v"}], "]"}], ",", 
    RowBox[{"z", "[", 
     RowBox[{"u", ",", "v"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.3948970359908657`*^9, 3.394897063208787*^9}}],

Cell[TextData[{
 "We ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to show all the positions that such a vector can assume:"
}], "Text",
 CellChangeTimes->{{3.394897133161379*^9, 3.394897150393635*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{
   RowBox[{"\[CapitalPhi]", "[", 
    RowBox[{"u", ",", "v"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "6"]}], "\[Pi]"}], ",", 
     RowBox[{
      FractionBox["3", "2"], "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"v", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Boxed", "\[Rule]", "False"}], ",", " ", 
   RowBox[{"Axes", "\[Rule]", "None"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.394897102276475*^9, 3.394897105741041*^9}}],

