Cell[TextData[{
 "Use the mouse to give ",
 StyleBox["that",
  FontSlant->"Italic"],
 " a spin!"
}], "Text",
 CellChangeTimes->{{3.3948505206660337`*^9, 3.394850533511326*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394850583588994*^9, 3.394850583677494*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["A Physical Example: Larmor Radiation Pattern", "Subsubsection",
 CellChangeTimes->{{3.3948506129439077`*^9, 3.3948506301197443`*^9}}],

Cell[TextData[{
 "The directional dependence of the radiation emitted by an accelerated \
charge is (in non-relativistic approximation) given by Joseph Larmor's ",
 StyleBox["\"sine squared\" law",
  FontColor->RGBColor[0, 0, 1]],
 " (see Griffiths, ",
 StyleBox["Introduction to Electrodynamics",
  FontSlant->"Italic"],
 " \[Section]9.2.3",
 ").  First we plot the distribution"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"larmor", "=", 
  RowBox[{"SphericalPlot3D", "[", 
   RowBox[{
    StyleBox[
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"],
     FontColor->RGBColor[0, 0, 1]], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Boxed", "\[Rule]", "False"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.394850700525008*^9, 3.394850716217264*^9}}],

