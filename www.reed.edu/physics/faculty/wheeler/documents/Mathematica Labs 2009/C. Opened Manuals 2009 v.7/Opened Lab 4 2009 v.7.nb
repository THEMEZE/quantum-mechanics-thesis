Cell["", "Text",
 CellChangeTimes->{{3.395329201830695*^9, 3.395329201837913*^9}}],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Harmonically Forced Damped Oscillator",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395329339584045*^9, 3.395329349378481*^9}}],

Cell["In the absence of damping (and also of forcing) we had", "Text",
 CellChangeTimes->{{3.39532978440613*^9, 3.395329805360896*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", "t", "]"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{
          SuperscriptBox["3", "2"], 
          RowBox[{"x", "[", "t", "]"}]}]}], "\[Equal]", 
        StyleBox["0",
         FontColor->RGBColor[0, 0, 1]]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], ",", 
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.395329435675*^9, 3.395329462884391*^9}}],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"3", " ", "t"}], "]"}]], "Output",
 CellChangeTimes->{3.4444840752613373`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UnforcedUndampedPeriod", "=", 
  RowBox[{
   FractionBox[
    RowBox[{"2", "\[Pi]"}], "3"], "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.3953299092789307`*^9, 3.395329960349579*^9}, {
  3.395330007092299*^9, 3.395330019520838*^9}}],

Cell[BoxData["2.0943951023931953`"], "Output",
 CellChangeTimes->{3.444484077954887*^9}]
}, Open  ]],

Cell["\<\
In the presence of weak damping (still no forcing) the adjusted motion became\
\
\>", "Text",
 CellChangeTimes->{{3.395329838688846*^9, 3.395329882241043*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", "t", "]"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "+", 
         RowBox[{
          SuperscriptBox["3", "2"], 
          RowBox[{"x", "[", "t", "]"}]}]}], "\[Equal]", 
        StyleBox["0",
         FontColor->RGBColor[0, 0, 1]]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], ",", 
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]], "Input"],

Cell[BoxData[
 FractionBox[
  RowBox[{"6", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "t"}], "/", "2"}]], " ", 
   RowBox[{"Sin", "[", 
    FractionBox[
     RowBox[{
      SqrtBox["35"], " ", "t"}], "2"], "]"}]}], 
  SqrtBox["35"]]], "Output",
 CellChangeTimes->{3.444484081024137*^9}]
}, Open  ]],

Cell["\<\
Since the motion is has become non-periodic, the \"period\" concept is \
replaced by \"time between zero crossings,\" and it is in that sense that we \
have\
\>", "Text",
 CellChangeTimes->{{3.395330119021488*^9, 3.395330152365611*^9}, {
  3.3953301880880623`*^9, 3.395330258531064*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UnforcedDampedPeriod", "=", 
  RowBox[{
   FractionBox[
    RowBox[{"2", "\[Pi]"}], 
    FractionBox[
     RowBox[{
      SqrtBox["35"], " "}], "2"]], "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.395330049844182*^9, 3.395330076610998*^9}}],

Cell[BoxData["2.1241043182442114`"], "Output",
 CellChangeTimes->{3.4444840900348682`*^9}]
}, Open  ]],

Cell["\<\
which is slightly prolonged, as is evident in the following figure:\
\>", "Text",
 CellChangeTimes->{{3.395330289384005*^9, 3.3953303116023903`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"3", " ", "t"}], "]"}], ",", 
     FractionBox[
      RowBox[{"6", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "2"}]], " ", 
       RowBox[{"Sin", "[", 
        FractionBox[
         RowBox[{
          SqrtBox["35"], " ", "t"}], "2"], "]"}]}], 
      SqrtBox["35"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.395329680026431*^9, 3.395329713326899*^9}}],

