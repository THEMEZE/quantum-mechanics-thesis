 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"18", "+", "C1"}]], "\[Equal]", "\[Omega]0"}], ",", "C1"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"C1", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "18"}], "+", 
     SuperscriptBox["\[Omega]0", "2"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.444485504509206*^9}]
}, Open  ]],

Cell["So we have", "Text",
 CellChangeTimes->{{3.395358091547947*^9, 3.395358092888878*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Theta]", "[", 
  RowBox[{"t", ",", 
   RowBox[{
    RowBox[{"-", "18"}], "+", 
    SuperscriptBox["\[Omega]0", "2"]}], ",", "0"}], "]"}]], "Input",
 CellChangeTimes->{{3.39535356028137*^9, 3.395353560669428*^9}, 
   3.395353674238175*^9, 3.395353750570212*^9}],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"JacobiAmplitude", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["t", "2"], " ", 
       SuperscriptBox["\[Omega]0", "2"]}]]}], ",", 
    FractionBox["36", 
     SuperscriptBox["\[Omega]0", "2"]]}], "]"}]}]], "Output",
 CellChangeTimes->{3.44448550719512*^9}]
}, Open  ]],

Cell["\<\
and are led to introduce the following description of angular motion as a \
function of initial angular velocity:\
\>", "Text",
 CellChangeTimes->{{3.395358124612712*^9, 3.395358162907084*^9}, {
  3.396060170328518*^9, 3.3960601892569427`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]", "[", 
   RowBox[{"t_", ",", "\[Omega]0_"}], "]"}], ":=", 
  RowBox[{"2", " ", 
   RowBox[{"JacobiAmplitude", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", "\[Omega]0", " ", "t"}], ",", 
     FractionBox["36", 
      SuperscriptBox["\[Omega]0", "2"]]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.395353822553278*^9, 3.395353875595207*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Theta]", "[", 
  RowBox[{"t", ",", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Theta]", "[", 
  RowBox[{"t", ",", 
   RowBox[{"10", "/", "3"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"\[Theta]", "[", 
  RowBox[{"t", ",", 
   RowBox[{"11", "/", "3"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.395353918385522*^9, 3.3953539891077213`*^9}}],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"JacobiAmplitude", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"3", " ", "t"}], "2"], ",", "4"}], "]"}]}]], "Output",
 CellChangeTimes->{3.444485514496554*^9}],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"JacobiAmplitude", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"5", " ", "t"}], "3"], ",", 
    FractionBox["81", "25"]}], "]"}]}]], "Output",
 CellChangeTimes->{3.444485514543627*^9}],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"JacobiAmplitude", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"11", " ", "t"}], "6"], ",", 
    FractionBox["324", "121"]}], "]"}]}]], "Output",
 CellChangeTimes->{3.4444855145925713`*^9}]
}, Open  ]],

Cell["", "Text",
 CellChangeTimes->{{3.395358269302395*^9, 3.395358269312757*^9}}],

Cell[TextData[{
 StyleBox["CURIOUS FACT",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": We had to struggle a bit to obtain this description of the pendular \
motion that conforms to our stated initial conditions. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 4, which was used to produce the first edition of this manual, led \
spontaneously and immediately to our final result, with no struggle at all. \
",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "5 was\[LongDash]as ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6 now is\[LongDash]for all of its virtues, in some respects \"too smart,\" \
or at least annoyingly fussy: it detects\[LongDash]and forces the user to \
identify and resolve\[LongDash]ambiguities that earlier versions of the \
software were content to ignore. "
}], "Text",
 CellChangeTimes->{{3.395358285464839*^9, 3.395358288956395*^9}, {
  3.3953583446008377`*^9, 3.395358519535006*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395358574381597*^9, 3.3953585744460382`*^9}}],

Cell[TextData[{
 "Using the result now in hand to construct the following figure [REMARK: I \
do not understand why ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6 takes much longer to produce a figure very much inferior to that \
produced by earlier versions of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "]"
}], "Text",
 CellChangeTimes->{{3.395358588207933*^9, 3.395358621498413*^9}, {
  3.3953594521236877`*^9, 3.395359504237873*^9}, {3.395359544760404*^9, 
  3.395359689697246*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", "[", 
      RowBox[{"t", ",", "3"}], "]"}], ",", 
     RowBox[{"\[Theta]", "[", 
      RowBox[{"t", ",", 
       RowBox[{"10", "/", "3"}]}], "]"}], ",", 
     RowBox[{"\[Theta]", "[", 
      RowBox[{"t", ",", 
       RowBox[{"11", "/", "3"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "8"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "Green", "}"}], ",", 
      RowBox[{"{", "Blue", "}"}], ",", 
      RowBox[{"{", "Red", "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", "\"\<angle\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.395359328671075*^9, 3.395359383708028*^9}, {
  3.396060269921001*^9, 3.396060290235797*^9}, {3.396060341864675*^9, 
  3.3960603780315447`*^9}}],

