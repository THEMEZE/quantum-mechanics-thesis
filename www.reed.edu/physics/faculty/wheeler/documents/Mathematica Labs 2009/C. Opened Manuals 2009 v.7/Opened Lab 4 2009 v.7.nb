Cell[TextData[{
 "makes vividly evident how the red solution \"threads through\" the slope \
field, and it becomes obvious what the solution that passes through ",
 StyleBox["any",
  FontSlant->"Italic"],
 " specified point would look like."
}], "Text",
 CellChangeTimes->{{3.395236550132224*^9, 3.395236578377379*^9}}],

Cell["\<\
Variants of the idea just illustrated are of very widespread utility, and \
often help one to grasp the qualitative essentials of complex situations.\
\>", "Text",
 CellChangeTimes->{3.395236602606353*^9}],

Cell["", "Text",
 CellChangeTimes->{{3.395236653878405*^9, 3.3952366538827267`*^9}}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Limited Growth: The \"Logistic Model\"", "Subsection",
 CellChangeTimes->{{3.395236665306566*^9, 3.395236680277029*^9}},
 FontColor->RGBColor[1, 0, 0]],

Cell["Modify the right side of the preceding ODE so as to have", "Text"],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"P", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{"P", "[", "t", "]"}], 
    RowBox[{"(", 
     RowBox[{"5", "-", 
      RowBox[{"P", "[", "t", "]"}]}], ")"}]}]}], "Output",
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"P", "[", "0", "]"}], "=", "1"}], "Output",
  FontColor->GrayLevel[0.500008]]}], "Input"],

Cell["From", "Text",
 CellChangeTimes->{{3.3952397985257397`*^9, 3.395239819929325*^9}}],

