 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"t_", ",", "v_", ",", "\[Theta]_", ",", "g_"}], "]"}], ":=", 
  RowBox[{"t", " ", "v", " ", 
   RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", 
   RowBox[{"t_", ",", "v_", ",", "\[Theta]_", ",", "g_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "g"}], " ", 
      SuperscriptBox["t", "2"]}], "+", 
     RowBox[{"2", " ", "t", " ", "v", " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{3.395375777434924*^9}],

