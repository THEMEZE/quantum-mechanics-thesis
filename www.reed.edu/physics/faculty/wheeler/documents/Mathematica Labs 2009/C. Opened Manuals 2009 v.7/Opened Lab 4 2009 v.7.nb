Cell[TextData[{
 "We ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to solve the equation of motion (which is an ODE of now ",
 StyleBox["second",
  FontSlant->"Italic"],
 " order), subject to the prescribed initial conditions:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OscillatorMotion", "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["3", "2"]}], 
          RowBox[{"x", "[", "t", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], 
      ",", 
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.395266254640072*^9, 3.395266261894189*^9}}],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"3", " ", "t"}], "]"}]], "Output",
 CellChangeTimes->{3.444483860523457*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["OscillatorMotion"], "Input"],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"3", " ", "t"}], "]"}]], "Output",
 CellChangeTimes->{3.444483868853629*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "t_", "]"}], ":=", "OscillatorMotion"}]], "Input",
 CellChangeTimes->{{3.395378819444467*^9, 3.395378834147501*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f", "[", "t", "]"}]], "Input",
 CellChangeTimes->{{3.395378846886148*^9, 3.395378848462358*^9}}],

Cell[BoxData[
 RowBox[{"Sin", "[", 
  RowBox[{"3", " ", "t"}], "]"}]], "Output",
 CellChangeTimes->{3.444483879029237*^9}]
}, Open  ]],

Cell["\<\
There are several ways to display that information; the most obvious is to \
simply plot it\
\>", "Text"],

