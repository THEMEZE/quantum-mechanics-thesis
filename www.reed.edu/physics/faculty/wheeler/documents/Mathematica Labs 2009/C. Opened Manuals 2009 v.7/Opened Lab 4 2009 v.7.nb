Cell[TextData[{
 "A little quick experimentation enables us to discovery of the (approximate) \
least value of initial velocity that is sufficient to cause the pendulum to \
(barely) go ",
 StyleBox["twice",
  FontSlant->"Italic"],
 " over the top:"
}], "Text",
 CellChangeTimes->{{3.395365316419302*^9, 3.39536540874395*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"twiceover1", "=", 
  RowBox[{
   RowBox[{"\[Theta]", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["3", "2"], 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "\[Equal]", "13.89"}]}],
        "}"}], ",", 
      RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  TagBox[
