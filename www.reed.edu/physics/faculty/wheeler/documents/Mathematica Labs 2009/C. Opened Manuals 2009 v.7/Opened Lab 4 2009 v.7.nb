Cell[TextData[{
 "Or we might ",
 StyleBox["animate",
  FontSlant->"Italic"],
 " the preceding diagram:"
}], "Text",
 CellChangeTimes->{{3.395266775728168*^9, 3.395266777517277*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"OscillatorMovie", "[", "t_", "]"}], ":=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"zigzag", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Sin", "[", 
            RowBox[{"3", "t"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}], ",", "40", ",", ".05"}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"PointSize", "[", ".075", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Sin", "[", 
             RowBox[{"3", "t"}], "]"}]}], "}"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GrayLevel", "[", ".7", "]"}], ",", 
         RowBox[{"Rectangle", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", ".5"}], ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{".5", ",", "2.2"}], "}"}]}], "]"}]}], "}"}]}], "}"}], 
     "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "\[Rule]", 
     RowBox[{"StyleForm", "[", 
      RowBox[{
      "\"\<Animated Simple Harmonic Oscillator\>\"", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"FontFamily", "\[Rule]", "\"\<Times-Bold\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"FontSize", "\[Rule]", "16"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Axes", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
    RowBox[{"AxesStyle", "\[Rule]", 
     RowBox[{"GrayLevel", "[", ".5", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Ticks", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2.2"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.395378618037994*^9, 3.395378624221896*^9}, {
   3.395378874612544*^9, 3.3953788806527147`*^9}, {3.395753687667366*^9, 
   3.395753692908093*^9}, 3.39575390664919*^9, {3.396057059758771*^9, 
   3.396057059953436*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"OscillatorMovie", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", 
      RowBox[{"\[Pi]", "/", "3"}]}]}], "}"}], ",", " ", 
   RowBox[{"AnimationRunning", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.395378754573307*^9, {3.3953789214967117`*^9, 3.395378926133766*^9}, {
   3.396056329382107*^9, 3.39605634601798*^9}, 3.396056434494137*^9, {
   3.396056804439105*^9, 3.396056816971449*^9}}],

