Cell[TextData[{
 StyleBox["INSTRUCTIONS",
  FontWeight->"Bold"],
 ": Hit the Play button to see the movie. You get better \
resolution\[LongDash]particularly in opening scene\[LongDash]if you use the \
slider to advance the film."
}], "Text",
 CellChangeTimes->{{3.3960591537156553`*^9, 3.396059265628003*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395328770989881*^9, 3.39532877099444*^9}}],

Cell["", "Text"],

Cell[TextData[{
 "Looking specifically to the energetics of the motion\[LongDash]",
 StyleBox["i.e",
  FontSlant->"Italic"],
 "., to"
}], "Text",
 CellChangeTimes->{{3.3953239576003*^9, 3.395323983523963*^9}, {
  3.395753314572658*^9, 3.395753350232143*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{"energy", "=", 
   RowBox[{
    RowBox[{"m", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", "velocity", ")"}], "2"], "2"]}], "+", 
    RowBox[{"m", " ", 
     SuperscriptBox["\[Omega]", "2"], 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", "displacement", ")"}], "2"], "2"]}]}]}], "Output",
  FontColor->GrayLevel[0.5]]], "Input",
 CellChangeTimes->{{3.3957531775825567`*^9, 3.395753280131077*^9}}],

Cell["\[LongDash]we proceed as follows:", "Text",
 CellChangeTimes->{{3.395753332874241*^9, 3.395753339503193*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dampedenergy", "[", "t_", "]"}], ":=", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"dampedmomentum", "[", "t", "]"}], "2"], "2"], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["3", "2"], 
     SuperscriptBox[
      RowBox[{"dampedposition", "[", "t", "]"}], "2"]}], 
    "2"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"undampedenergy", "[", "t_", "]"}], ":=", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"undampedmomentum", "[", "t", "]"}], "2"], "2"], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["3", "2"], 
     SuperscriptBox[
      RowBox[{"undampedposition", "[", "t", "]"}], "2"]}], "2"]}]}]}], "Input",\

 CellChangeTimes->{{3.395323339564728*^9, 3.395323461045886*^9}, {
  3.39532363009343*^9, 3.3953236579778967`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dampedenergy", "[", "t", "]"}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"undampedenergy", "[", "t", "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.395323495510682*^9, 3.3953235421804733`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["9", "70"]}], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", "t"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "36"}], "+", 
    RowBox[{"Cos", "[", 
     RowBox[{
      SqrtBox["35"], " ", "t"}], "]"}], "+", 
    RowBox[{
     SqrtBox["35"], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{
       SqrtBox["35"], " ", "t"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.444484064527677*^9}],

Cell[BoxData[
 FractionBox["9", "2"]], "Output",
 CellChangeTimes->{3.444484064569516*^9}]
}, Open  ]],

