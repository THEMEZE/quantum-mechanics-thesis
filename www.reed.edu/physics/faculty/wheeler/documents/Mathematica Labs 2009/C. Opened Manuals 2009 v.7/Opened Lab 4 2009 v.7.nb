Cell[CellGroupData[{

Cell["\<\
Obtaining/Displaying Solutions of Ordinary Differential  Equations\
\>", "Section",
 CellChangeTimes->{{3.395184160768964*^9, 3.395184174408791*^9}, {
  3.395190470255616*^9, 3.395190478912826*^9}, {3.395329163172098*^9, 
  3.395329175514009*^9}}],

Cell[TextData[{
 "Many problems in physics\[LongDash]as also elsewhere in the pure/applied \
mathematics of the last three centuries\[LongDash]assume this form: ",
 StyleBox["Find the ",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["x(t) ",
  FontSlant->"Italic",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["which, in collaboration with its derivatives, satisfies an \
equation of the form",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" ",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellChangeTimes->{{3.395190498492792*^9, 3.3951905019118557`*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"x", "''"}], "[", "t", "]"}], ",", "..."}], "]"}], "\[Equal]", 
   "0"}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 StyleBox["together with prescribed initial/boundary conditions",
  FontColor->RGBColor[1, 0, 0]],
 ". Newton's 2nd Law provides the classic case in point: it presents the ",
 StyleBox["problem of dynamical motion ",
  FontSlant->"Italic"],
 "as the problem of solving",
 StyleBox[" ",
  FontSlant->"Italic"],
 "  "
}], "Text"],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}]}], "\[Equal]", 
   RowBox[{"F", "[", 
    RowBox[{"x", "[", "t", "]"}], "]"}]}], "Output",
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"Initial", " ", 
   RowBox[{"conditions", ":", " ", 
    RowBox[{
     RowBox[{"x", "[", 
      SubscriptBox["t", "0"], "]"}], "\[Equal]", 
     RowBox[{
      SubscriptBox["x", "0"], "  ", "and", "   ", 
      RowBox[{
       RowBox[{"x", "'"}], "[", 
       SubscriptBox["t", "0"], "]"}]}], "\[Equal]", 
     SubscriptBox["v", "0"]}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]}], "Input"],

Cell["or, more generally, of solving", "Text"],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}]}], "\[Equal]", 
   RowBox[{
    SubscriptBox["F", "x"], "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"y", "[", "y", "]"}], ",", 
     RowBox[{"z", "[", "t", "]"}]}], "]"}]}],
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"y", "''"}], "[", "t", "]"}]}], "\[Equal]", 
   RowBox[{
    SubscriptBox["F", "y"], "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"y", "[", "y", "]"}], ",", 
     RowBox[{"z", "[", "t", "]"}]}], "]"}]}],
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"z", "''"}], "[", "t", "]"}]}], "\[Equal]", 
   RowBox[{
    SubscriptBox["F", "z"], "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"y", "[", "y", "]"}], ",", 
     RowBox[{"z", "[", "t", "]"}]}], "]"}]}],
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"Six", " ", "initial", " ", "conditions", " ", "required"}],
  FontColor->GrayLevel[0.500008]]}], "Output"],

Cell[TextData[{
 "which comprise a ",
 StyleBox["coupled system",
  FontColor->RGBColor[0, 0, 1]],
 " of 2nd order ODEs."
}], "Text",
 CellChangeTimes->{{3.395190729540411*^9, 3.3951907295761538`*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395190729721243*^9, 3.395190729729018*^9}}],

Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": Such equations are called ",
 StyleBox["ordinary",
  FontSlant->"Italic"],
 " differential equations (ODEs) because the unknown functions are functions \
of a single independent variable, so only ordinary derivatives are \
encountered. \"Fields\" are functions of several independent variables; in \
field theory one therefore encounters partial derivatives, and is led to the \
theory of ",
 StyleBox["partial",
  FontSlant->"Italic"],
 " differential equations (PDEs) \[Ellipsis] which traditionally has been \
thought of as a different subject altogether (and much more difficult), but \
which ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " equips one to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"approach\[LongDash]numerically", ",", " ", 
    RowBox[{"if", " ", "not", " ", "analytically\[LongDash]"}]}], 
   TraditionalForm]]],
 "with almost equal ease."
}], "Text",
 CellChangeTimes->{{3.395190741866523*^9, 3.395190810163685*^9}, {
  3.395190841787994*^9, 3.3951910312711973`*^9}, {3.3960506338241796`*^9, 
  3.396050667133704*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3951912200792313`*^9, 3.3951912200818157`*^9}}],

Cell[TextData[{
 "\tThe ODE literature presents a bewildering collection of tricks devised by \
generations of mathematicians to solve ODEs of this or that specialized type. \
Most of those tricks pertain exclusively to ODEs that can be ",
 StyleBox["solved in terms of named functions ",
  FontSlant->"Italic"],
 "(many \"named functions\"",
 StyleBox[" arose from",
  FontSlant->"Italic"],
 " the theory of ODEs). But many/most of the ODEs encountered in realistic \
physical situations elude the network of known tricks: such equations must be \
solved numerically. The situation is further complicated by the circumstance \
that it is difficult, even with a virtuoso command of the tricks, to know in \
advance whether or not the particular ODE in hand can be brought to such a \
form that it yields to some trick. Today all is changed, simplified, because\
\[Ellipsis] ",
 StyleBox[" ",
  FontSlant->"Italic"],
 " "
}], "Text"],

Cell[TextData[{
 StyleBox["\[Bullet] Mathematica",
  FontSlant->"Italic"],
 " knows all the tricks."
}], "Text"],

Cell[TextData[{
 StyleBox["\[Bullet] Mathematica",
  FontSlant->"Italic"],
 " permits a simple, ",
 StyleBox["unified approach",
  FontSlant->"Italic"],
 " to the solution of ODEs."
}], "Text"],

Cell["", "Text",
 CellChangeTimes->{{3.395191229460252*^9, 3.3951912295796413`*^9}}],

Cell["The commands", "Text",
 CellChangeTimes->{{3.3951912414728203`*^9, 3.3951912439698257`*^9}}],

Cell[CellGroupData[{

