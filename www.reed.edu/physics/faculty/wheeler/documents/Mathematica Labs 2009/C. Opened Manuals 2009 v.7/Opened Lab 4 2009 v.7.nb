 CellChangeTimes->{3.444483385302187*^9}]
}, Open  ]],

Cell["\<\
Returning now to our first example, to reproduce the solution we have \
extracted by hand Stan Wagon presents\
\>", "Text",
 CellChangeTimes->{{3.395233445377432*^9, 3.3952334863539047`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HisSolution", "=", 
  RowBox[{
   RowBox[{"P", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"P", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"a", " ", 
        RowBox[{"P", "[", "t", "]"}]}]}], ",", 
      RowBox[{"P", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.3952334996681337`*^9, 3.395233503682975*^9}, 
   3.395233558374075*^9}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"a", " ", "t"}]], " ", 
  RowBox[{"C", "[", "1", "]"}]}]], "Output",
 CellChangeTimes->{3.444483391822475*^9}]
}, Open  ]],

