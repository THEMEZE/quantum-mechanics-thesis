Cell[TextData[StyleBox["Ballistics",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395375287125454*^9, 3.395375298411731*^9}}],

Cell[TextData[{
 "Consider the ",
 StyleBox["motion of a thrown mass point",
  FontColor->RGBColor[0, 0, 1]],
 "; immediately"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], ",", 
    RowBox[{"y", "[", "t", "]"}]}], "}"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox[
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", "0"}],
        FontColor->GrayLevel[0]], 
       StyleBox[",",
        FontColor->GrayLevel[0]], 
       StyleBox[
        RowBox[{
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"-", "g"}]}],
        FontColor->GrayLevel[0]], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", 
        RowBox[{"v", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "0", "]"}], "\[Equal]", 
        RowBox[{"v", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", " ", "t"}], "]"}], 
   "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"t", " ", "v", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "g"}], " ", 
       SuperscriptBox["t", "2"]}], "+", 
      RowBox[{"2", " ", "t", " ", "v", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], "}"}]], "Output",\

 CellChangeTimes->{3.4444858801243467`*^9}]
}, Open  ]],

Cell["\<\
This, of course, is physics learned in the second week of an introductory \
course.  If\[LongDash]after defining\
\>", "Text",
 CellChangeTimes->{{3.395375860433116*^9, 3.395375868154978*^9}, {
  3.395377130919537*^9, 3.3953771470577507`*^9}}],

