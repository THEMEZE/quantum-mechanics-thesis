  "\[LeftDoubleBracket]", "1", 
  "\[RightDoubleBracket]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"tom", ",", " ", "dick", ",", " ", "harry"}], "}"}], 
  "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "Input",
 CellChangeTimes->{{3.395233044183054*^9, 3.395233057069037*^9}}],

