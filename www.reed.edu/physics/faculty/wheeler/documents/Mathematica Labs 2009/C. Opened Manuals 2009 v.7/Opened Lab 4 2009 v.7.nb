  AspectRatio->NCache[GoldenRatio^(-1), 0.6180339887498948],
  Axes->True,
  AxesLabel->{
    FormBox["\"\[Theta]\"", TraditionalForm], 
    FormBox["\"potential energy\"", TraditionalForm]},
  AxesOrigin->{0, 0},
  PlotRange->
   NCache[{{Rational[-9, 2] Pi, Rational[9, 2] Pi}, {0, 
     5}}, {{-14.137166941154069`, 14.137166941154069`}, {0, 5}}],
  PlotRangeClipping->True,
  PlotRangePadding->{
    Scaled[0.02], Automatic},
  Ticks->{{{
      NCache[(-4) Pi, -12.566370614359172`], 
      FormBox[
       RowBox[{
         RowBox[{"-", "4"}], " ", "\[Pi]"}], TraditionalForm]}, {
      NCache[(-2) Pi, -6.283185307179586], 
      FormBox[
       RowBox[{
         RowBox[{"-", "2"}], " ", "\[Pi]"}], TraditionalForm]}, {0, 
      FormBox["0", TraditionalForm]}, {
      NCache[2 Pi, 6.283185307179586], 
      FormBox[
       RowBox[{"2", " ", "\[Pi]"}], TraditionalForm]}, {
      NCache[4 Pi, 12.566370614359172`], 
      FormBox[
       RowBox[{"4", " ", "\[Pi]"}], TraditionalForm]}}, Automatic}]], "Output",\

 CellChangeTimes->{3.444484180118866*^9}]
}, Open  ]],

Cell[TextData[{
 "The pendulum moves ",
 StyleBox["harmonically only in the small-angle regime",
  FontColor->RGBColor[0, 0, 1]],
 " where the red and blue curves are indistinguishable."
}], "Text",
 CellChangeTimes->{{3.395347606114801*^9, 3.395347614445455*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3960599424968643`*^9, 3.396059942512788*^9}}],

Cell[TextData[{
 "The equation of motion of a simple undamped pendulum reads (here we suspend \
our assumption that m = g = a = 1, which would have entailed",
 StyleBox[" ", "Output"],
 StyleBox[Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[Omega]", "2"], "=", "1"}]], "Output",
  CellChangeTimes->{{3.39536240832911*^9, 3.395362417129634*^9}}], "Output"],
 ")"
}], "Text",
 CellChangeTimes->{
  3.3953496616768827`*^9, {3.395362310845172*^9, 3.3953623507387457`*^9}, {
   3.395362390742944*^9, 3.3953624274595213`*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "(here  ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["\[Omega]", "2"], "\[Congruent]", 
   RowBox[{"g", "/", "m"}]}]]],
 ") which by"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "6"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], " ", "\[Theta]"}]}], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], " ", 
     SuperscriptBox["\[Theta]", "3"]}], "6"], "-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], " ", 
     SuperscriptBox["\[Theta]", "5"]}], "120"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Theta]", "]"}], "7"],
    SeriesData[$CellContext`\[Theta], 0, {}, 1, 7, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Theta], 
   0, {-$CellContext`\[Omega]^2, 0, Rational[1, 6] $CellContext`\[Omega]^2, 0,
     Rational[-1, 120] $CellContext`\[Omega]^2}, 1, 7, 1],
  Editable->False]], "Output",
 CellChangeTimes->{3.4444841909126053`*^9}]
}, Open  ]],

Cell[TextData[{
 "is seen to be a ",
 StyleBox["nonlinear",
  FontColor->RGBColor[1, 0, 0]],
 " 2nd-order ODE. We are therefore not surprised that, when asked to solve \
the equation (in which, for the illusrative purposes of this discussion, I \
will set \[Omega]\[LongEqual]3), ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " responds cryptically/disappointingly and finally not at all:"
}], "Text",
 CellChangeTimes->{{3.395362474268304*^9, 3.3953625058722982`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]", "[", "t", "]"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["3", "2"]}], 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], 
      "}"}], ",", 
     RowBox[{"\[Theta]", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "::", "\<\"ifun\"\>"}], 
  RowBox[{
  ":", " "}], "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"Inverse functions are being \
used by \\\\\\\"\\\", \
\\\"MT\\\"]\\)\[NoBreak]\\!\\(\\*StyleBox[\\!\\(Solve\\), \\\"MT\\\"]\\)\
\[NoBreak]\\!\\(\\*StyleBox[\\\"\\\\\\\", so some solutions may not be found; \
use Reduce for complete solution information.\\\\\\\"\\\", \\\"MT\\\"]\\) \\!\
\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", \
ButtonFrame->None, ButtonData:>\\\"paclet:ref/message/Solve/ifun\\\", \
ButtonNote -> \\\"Solve::ifun\\\"]\\)\"\>"}]], "Message", "MSG",
 CellChangeTimes->{3.444484199119927*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "::", "\<\"bvfail\"\>"}], 
  RowBox[{
