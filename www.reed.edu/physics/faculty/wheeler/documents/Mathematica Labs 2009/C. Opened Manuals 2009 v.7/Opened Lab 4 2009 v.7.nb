Cell["\<\
Note that the pendulum hesitates as it approaches the top of its arc. This \
shows up in the following figure as a kink (why?).\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g6", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{"dampedpendulum8121", ",", 
       RowBox[{"D", "[", 
        RowBox[{"dampedpendulum8121", ",", "t"}], "]"}]}], "}"}], "]"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "\[Rule]", "300"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Ticks", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "\[Pi]"}], ",", 
         RowBox[{"-", "\[Pi]"}], ",", "0", ",", "\[Pi]", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "None"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "\"\<\[Theta]dot\>\""}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.395364583414734*^9}],

