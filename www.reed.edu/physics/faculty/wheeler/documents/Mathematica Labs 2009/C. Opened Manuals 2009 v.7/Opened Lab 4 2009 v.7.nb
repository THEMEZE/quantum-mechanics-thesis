Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Exponential Population Growth Resumed: the ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["Slope Field",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" Concept",
  FontColor->RGBColor[0, 0, 1]]
}], "Subsubsection",
 CellChangeTimes->{{3.395233992759542*^9, 3.3952340130063066`*^9}}],

Cell["The equation", "Text"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"y", "'"}], "[", "x", "]"}], "\[Equal]", 
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "tells us that ",
 StyleBox["y[x]", "Input"],
 " describes a curve with the property that when it passes through the point \
(",
 StyleBox["x,y",
  FontSlant->"Italic"],
 ") has slope ",
 StyleBox["f[x,y]", "Input"],
 ".  If we planted unit vectors with the prescribed slopes on the (",
 StyleBox["x,y",
  FontSlant->"Italic"],
 ")-plane we could obtain ",
 StyleBox["y[x]", "Input"],
 " by simply \"threading through\" that field of vectors.  I illustrate the \
idea as it relates to the exponential growth model   "
}], "Text",
 CellChangeTimes->{
  3.3952343918555813`*^9, {3.396051068669464*^9, 3.3960510694761343`*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"P", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{"P", "[", "t", "]"}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "The critical resouce here is the command ",
 StyleBox["VectorFieldPlot", "Input"],
 ", access to which is provided by a standard package which we now import: "
}], "Text",
 CellChangeTimes->{{3.395234490713478*^9, 3.395234499725869*^9}, {
   3.3952345606838093`*^9, 3.395234610834655*^9}, 3.396051096168392*^9}],

