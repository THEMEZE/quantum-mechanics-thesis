Cell[CellGroupData[{

Cell["Phase Space Methods", "Section",
 CellChangeTimes->{{3.3953185842340813`*^9, 3.395318590326541*^9}}],

Cell[TextData[{
 "Any 2nd-order equation of motion (describing motion of a particle in \
one-dimensional space) can be converted into a ",
 StyleBox["pair of 1st-order equations",
  FontVariations->{"Underline"->True}],
 " which describe the motion of an abstract point in two-dimensional \"phase \
space,\" and that is for many purposes often the most powerfully informative \
way to proceed. We touch here on the idea that lies at the heart of ",
 StyleBox["Hamiltonian mechanics",
  FontWeight->"Bold"],
 ", which we now illustrate as it pertains to damped oscillators. "
}], "Text",
 CellChangeTimes->{{3.3953185974723253`*^9, 3.395318637576991*^9}, {
   3.395318693317432*^9, 3.395318808643198*^9}, {3.395318855579327*^9, 
   3.3953189253013897`*^9}, {3.395318959609045*^9, 3.395318964901504*^9}, 
   3.395319035649193*^9, {3.395319127899096*^9, 3.395319130930552*^9}, {
   3.395319181976781*^9, 3.3953193729880047`*^9}}],

Cell["The damped oscillator equation", "Text",
 CellChangeTimes->{{3.3953194029318857`*^9, 3.395319411350102*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "m", " ", "b", " ", 
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
    RowBox[{"m", " ", 
     SuperscriptBox["\[Omega]", "2"], 
     RowBox[{"x", "[", "t", "]"}]}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Output"],

Cell["\<\
is readily recovered from the following pair of 1st-order equations:\
\>", "Text",
 CellChangeTimes->{{3.3953195651610403`*^9, 3.395319630188936*^9}}],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     StyleBox[
      StyleBox["p", "Output",
       FontColor->GrayLevel[0.500008]], "Output",
      FontColor->GrayLevel[0.500008]], "[", "t", "]"}], "/", "m"}]}], "Output",
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox[
   StyleBox[
    RowBox[{
     RowBox[{
      StyleBox[
       StyleBox[
        StyleBox["p", "Output",
         FontColor->GrayLevel[0.500008]], "Output",
        FontColor->GrayLevel[0.500008]], "Output",
       FontColor->GrayLevel[0.500008]], "'"}], "[", "t", "]"}], "Output"],
   FontColor->GrayLevel[0.500008]], 
  StyleBox[
   StyleBox["\[Equal]", "Output"],
   FontColor->GrayLevel[0.500008]], 
  RowBox[{
   StyleBox[
    StyleBox[
     RowBox[{
      RowBox[{"-", "2"}], "b", " ", 
      RowBox[{
       StyleBox[
        StyleBox["p", "Output",
         FontColor->GrayLevel[0.500008]],
        FontColor->GrayLevel[0.500008]], "[", "t", "]"}]}], "Output"],
    FontColor->GrayLevel[0.500008]], 
   StyleBox[
    StyleBox["-", "Output"],
    FontColor->GrayLevel[0.500008]], 
   RowBox[{
    StyleBox["m", "Output",
     FontColor->GrayLevel[0.5]], 
    StyleBox[" ", "Output",
     FontColor->GrayLevel[0.5]], 
    StyleBox[
     SuperscriptBox["\[Omega]", "2"], "Output",
     FontColor->GrayLevel[0.5]], 
    StyleBox[
     StyleBox[
      RowBox[{"x", "[", "t", "]"}], "Output"],
     FontColor->GrayLevel[0.500008]]}]}]}]}], "Input",
 CellChangeTimes->{{3.3953196693446827`*^9, 3.3953197095107613`*^9}, {
  3.3953198557764797`*^9, 3.39531986359921*^9}, {3.395319920704624*^9, 
  3.395319943944283*^9}}],

Cell["\<\
If we particularize as before, setting m = 1 and \[Omega] = 3, we have\
\>", "Text",
 CellChangeTimes->{{3.395321290960414*^9, 3.395321306589428*^9}, {
  3.395321394095945*^9, 3.395321422938014*^9}}],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    StyleBox[
     StyleBox["p", "Output",
      FontColor->GrayLevel[0.500008]], "Output",
     FontColor->GrayLevel[0.500008]], "[", "t", "]"}]}], "Output",
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox[
   StyleBox[
    RowBox[{
     RowBox[{
      StyleBox[
       StyleBox[
        StyleBox["p", "Output",
         FontColor->GrayLevel[0.500008]], "Output",
        FontColor->GrayLevel[0.500008]],
       FontColor->GrayLevel[0.500008]], "'"}], "[", "t", "]"}], "Output"],
   FontColor->GrayLevel[0.500008]], 
  StyleBox[
   StyleBox["\[Equal]", "Output"],
   FontColor->GrayLevel[0.500008]], 
  RowBox[{
   StyleBox[
    StyleBox[
     RowBox[{
      RowBox[{"-", "2"}], "b", " ", 
      RowBox[{
       StyleBox[
        StyleBox["p", "Output",
         FontColor->GrayLevel[0.500008]],
        FontColor->GrayLevel[0.500008]], "[", "t", "]"}]}], "Output"],
    FontColor->GrayLevel[0.500008]], 
   StyleBox[
    StyleBox["-", "Output"],
    FontColor->GrayLevel[0.500008]], 
   RowBox[{
    StyleBox[
     SuperscriptBox["3", "2"], "Output",
     FontColor->GrayLevel[0.5]], 
    StyleBox[
     StyleBox[
      RowBox[{"x", "[", "t", "]"}], "Output"],
     FontColor->GrayLevel[0.500008]]}]}]}]}], "Input",
 CellChangeTimes->{{3.3953196693446827`*^9, 3.3953197095107613`*^9}, {
  3.3953198557764797`*^9, 3.39531986359921*^9}, {3.395319920704624*^9, 
  3.395319943944283*^9}, {3.395321446416306*^9, 3.395321452847403*^9}}],

Cell["Look to the motion that results when (as before) we set ", "Text",
 CellChangeTimes->{{3.395321509183723*^9, 3.3953215478914347`*^9}}],

Cell[BoxData[{
 StyleBox[
  RowBox[{"b", "=", 
   RowBox[{"1", "/", "2"}]}], "Output",
  FontColor->GrayLevel[0.5]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "=", "0"}], "Output",
  FontColor->GrayLevel[0.5]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"p", "[", "0", "]"}], "=", "3"}], "Output",
  FontColor->GrayLevel[0.5]]}], "Input",
 CellChangeTimes->{{3.395321559573021*^9, 3.395321587206683*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"DampedPosition", ",", " ", "DampedMomentum"}], "}"}], "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"p", "[", "t", "]"}]}], "}"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"p", "[", "t", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"p", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           FractionBox["1", "2"], " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["3", "2"], 
           RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{"p", "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", 
        RowBox[{"p", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}], 
    "]"}]}]}]], "Input",
