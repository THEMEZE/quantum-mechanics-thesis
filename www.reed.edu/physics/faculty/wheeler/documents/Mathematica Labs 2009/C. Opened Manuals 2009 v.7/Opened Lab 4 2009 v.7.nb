Cell[TextData[{
 "suggests that panetary data\[LongDash]since it extends back for millennia, \
and is taken with instruments of very high accuracy\[LongDash]can be used to \
establish that ",
 StyleBox["Newton's 2nd-power law is ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["very accurately",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" a 2nd-power law",
  FontColor->RGBColor[0, 0, 1]],
 ", else orbits might be expected to precess enough to come into conflict \
with observational data.\n\n",
 StyleBox["REMARK",
  FontWeight->"Bold"],
 ": Planetary evidence does not preclude the possibility that Newton's \
2nd-power law stands in need of adjustment at distances much smaller/larger \
than those characteristic of the solar system. In recent years physicists \
have had reason to consider both possibilities, and at present neither has \
been altogether excluded. "
}], "Text",
 CellChangeTimes->{{3.3953990382389383`*^9, 3.395399083755932*^9}, {
   3.3953994553914757`*^9, 3.395399469118341*^9}, 3.395399551429496*^9}],

Cell["", "Text",
 CellChangeTimes->{{3.395397817157523*^9, 3.395397817176462*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395397817294726*^9, 3.395397817313794*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Initial Conditions Replaced by Endpoint Conditions",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395399567677256*^9, 3.39539958767275*^9}}],

Cell[TextData[{
 "We are in the habit of specifying orbits by stipulating ",
 StyleBox["initial",
  FontColor->RGBColor[0, 0, 1]],
 " conditions, but in advanced mechanics one develops (in connection with the \
way certain \"variational principles\" are phrased) an interest in \
orbits/trajectories that conform to stipulated ",
 StyleBox["endpoint conditions; ",
  FontColor->RGBColor[0, 0, 1]],
 "indeed, a right fielder has something resembling endpoint conditions in \
mind when he throws the ball, as does the quarterback when he throws a pass. \
Here I want only to point out that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " takes endpoint conditions in easy stride.  "
}], "Text",
 CellChangeTimes->{{3.395399667076033*^9, 3.395399685492313*^9}, {
  3.3953997310164022`*^9, 3.39539974421014*^9}}],

Cell["\<\
Look, by way of illustration, to the familiar harmonic oscillator:\
\>", "Text",
 CellChangeTimes->{3.3953997911380787`*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[Omega]", "2"]}], " ", 
       RowBox[{"x", "[", "t", "]"}]}]}], ",", 
     RowBox[{
      StyleBox[
       RowBox[{"x", "[", "0", "]"}],
       FontColor->GrayLevel[0]], 
      StyleBox["\[Equal]",
       FontColor->GrayLevel[0]], "a"}], ",", " ", 
     StyleBox[
      RowBox[{
       RowBox[{"x", "[", "T", "]"}], "\[Equal]", "b"}],
      FontColor->GrayLevel[0]]}], "}"}], ",", 
   RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.395399828372154*^9, 3.3953998551108437`*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"t", " ", "\[Omega]"}], "]"}]}], "-", 
     RowBox[{"a", " ", 
      RowBox[{"Cot", "[", 
       RowBox[{"T", " ", "\[Omega]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"t", " ", "\[Omega]"}], "]"}]}], "+", 
     RowBox[{"b", " ", 
      RowBox[{"Csc", "[", 
       RowBox[{"T", " ", "\[Omega]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"t", " ", "\[Omega]"}], "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.444486005442865*^9}]
}, Open  ]],

Cell[TextData[{
 "Here the ",
 StyleBox["side conditions",
  FontColor->RGBColor[1, 0, 0]],
 " have clearly the nature of ",
 StyleBox["endpoint ",
  FontSlant->"Italic"],
 "conditions",
 "."
}], "Text"],

Cell["", "Text",
 CellChangeTimes->{{3.395402784666594*^9, 3.395402784679419*^9}}],

Cell[TextData[{
 "We resort once again to graphical techniques to display what we have \
accomplished: we hold fixed the values of the parameters ",
 StyleBox["(T, a, b)", "Output"],
 " that serve to locate the specified endpoints while incrementing the sole \
remaining parameter ",
 StyleBox["(\[Omega])", "Output"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3953978174866743`*^9, 3.39539781756465*^9}, {
  3.3953999071284237`*^9, 3.3953999192629623`*^9}, {3.39540282354809*^9, 
  3.395402862321797*^9}, {3.395402894145426*^9, 3.395402986314975*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"endpointpositions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Point", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", ".5"}], "}"}], "]"}], ",", 
     RowBox[{"Point", "[", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["7", "4"], ",", 
        RowBox[{"-", "1"}]}], "}"}], "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.3954008681322308`*^9, 3.395400879343552*^9}, {
   3.395400917933281*^9, 3.3954010078711452`*^9}, 3.395402651293885*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"endpointimages", "=", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Red", ",", 
      "endpointpositions"}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.395402357419729*^9, 3.3954023974921503`*^9}, {
  3.396061038328978*^9, 3.396061038747396*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", 
   RowBox[{"t_", ",", "T_", ",", "a_", ",", "b_", ",", "\[Omega]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"a", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"t", " ", "\[Omega]"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "a"}], " ", 
       RowBox[{"Cot", "[", 
        RowBox[{"T", " ", "\[Omega]"}], "]"}]}], "+", 
      RowBox[{"b", " ", 
       RowBox[{"Csc", "[", 
        RowBox[{"T", " ", "\[Omega]"}], "]"}]}]}], ")"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"t", " ", "\[Omega]"}], "]"}]}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"connectingorbits", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"t", ",", 
         FractionBox["7", "4"], ",", ".5", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"2", "\[Pi]"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"x", "[", 
        RowBox[{"t", ",", 
         FractionBox["7", "4"], ",", ".5", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{
          RowBox[{"2", "\[Pi]"}], "+", ".1"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"x", "[", 
        RowBox[{"t", ",", 
         FractionBox["7", "4"], ",", ".5", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{
          RowBox[{"2", "\[Pi]"}], "+", ".2"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"x", "[", 
        RowBox[{"t", ",", 
         FractionBox["7", "4"], ",", ".5", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{
          RowBox[{"2", "\[Pi]"}], "+", ".3"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"x", "[", 
        RowBox[{"t", ",", 
         FractionBox["7", "4"], ",", ".5", ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{
          RowBox[{"2", "\[Pi]"}], "+", ".4"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       FractionBox["7", "4"]}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", ".2"}], ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Ticks", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1.75", "}"}], ",", 
        RowBox[{"{", ".5", "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"time", ",", "displacement"}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.39540006620861*^9, 3.395402734260779*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"connectingorbits", ",", "endpointimages"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.3954025400178623`*^9, 3.395402562852192*^9}, 
   3.395402594172876*^9}],

