Cell[TextData[{
 StyleBox["INSTRUCTION",
  FontWeight->"Bold"],
 ": Run as a movie."
}], "Text",
 CellChangeTimes->{{3.395752782775694*^9, 3.395752798593767*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3957528103685293`*^9, 3.395752810442605*^9}}],

Cell[TextData[{
 "This is an amusing creation, but raises ",
 StyleBox["a philosophical point",
  FontColor->GrayLevel[0]],
 ":"
}], "Text"],

Cell[TextData[{
 "It is gratifying to find that our animations \"reproduce the real world,\" \
but to the extent that they do so they teach us little more than we would \
learn by simply looking at the world itself. Previous modes of graphical \
display\[LongDash]though more \"diagramatic,\" and though they may require \
some interpretive practice\[LongDash]speak more clearly/informatively to what \
is going on, teach us ",
 StyleBox["how",
  FontSlant->"Italic"],
 " to look at the real world. This much is, in any event clear:",
 StyleBox[" When you have solved a differential equation your work is \
typically only half done; you have yet to ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["devise the best way, in the particular instance, to make your \
result intelligible",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[". ",
  FontColor->RGBColor[0, 0, 1]],
 "Strings of data\[LongDash]produced maybe this way"
}], "Text"],

