Cell[CellGroupData[{

Cell[TextData[StyleBox["Overdamped Case",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395277598919413*^9, 3.395277605318973*^9}}],

Cell[TextData[{
 "We look to the case ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SuperscriptBox["b", "2"], "Output"], 
   StyleBox["=", "Output"], 
   RowBox[{
    SuperscriptBox[
     StyleBox["4", "Output"], "2"], 
    StyleBox[">", "Output"], 
    StyleBox[" ", "Output"], 
    StyleBox[
     SuperscriptBox["\[Omega]", "2"], "Output"]}]}]],
  CellChangeTimes->{{3.395276890855276*^9, 3.395276955047406*^9}}],
 "."
}], "Text",
 CellChangeTimes->{{3.3952776675515137`*^9, 3.3952776744502172`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OverdampedOscillation", "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           RowBox[{"(", 
            StyleBox["4",
             FontColor->RGBColor[1, 0, 0]], ")"}], " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["3", "2"], 
           RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], 
      ",", 
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.395275039666728*^9, 3.395275070775942*^9}, {
   3.395275391400922*^9, 3.395275418696684*^9}, {3.3952754933704*^9, 
   3.395275503102516*^9}, {3.395277483670287*^9, 3.395277493383089*^9}, {
   3.395277720412587*^9, 3.3952777324484653`*^9}, 3.395277798335064*^9}],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"3", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "4"}], "-", 
          SqrtBox["7"]}], ")"}], " ", "t"}]], "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "4"}], "+", 
          SqrtBox["7"]}], ")"}], " ", "t"}]]}], ")"}]}], 
   RowBox[{"2", " ", 
    SqrtBox["7"]}]]}]], "Output",
 CellChangeTimes->{3.444483953075799*^9}]
}, Open  ]],

Cell["\<\
This expression is assembled from exponentials that die at two different \
rates, on fast, the other slow:\
\>", "Text",
 CellChangeTimes->{{3.395277943965555*^9, 3.3952779698119707`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "4"}], "-", 
      SqrtBox["7"]}], ")"}], ",", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "4"}], "+", 
      SqrtBox["7"]}], ")"}]}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.3952778592710257`*^9, 3.395277888997819*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "6.645751311064591`"}], ",", 
   RowBox[{"-", "1.3542486889354093`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.444483956203985*^9}]
}, Open  ]],

Cell[CellGroupData[{

