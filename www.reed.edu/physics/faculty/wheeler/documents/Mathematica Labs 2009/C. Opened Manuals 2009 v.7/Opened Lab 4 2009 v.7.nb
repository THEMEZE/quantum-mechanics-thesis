Cell["+", "Text",
 CellChangeTimes->{3.4444858621721983`*^9}],

Cell[TextData[{
 "may be all you need in some few cases, but graphical display is often your \
most powerful resource.  It is a resource which ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " permits you to manage with unprecedented power and efficiency."
}], "Text",
 CellChangeTimes->{3.395375316840645*^9}],

