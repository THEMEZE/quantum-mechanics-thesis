Cell["", "Text",
 CellChangeTimes->{{3.3952734575692377`*^9, 3.3952734576343*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Damped Harmonic Oscillator",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395273481457304*^9, 3.395273488897553*^9}}],

Cell[TextData[{
 "The standard model of a ",
 StyleBox["damped",
  FontColor->RGBColor[0, 0, 1]],
 " oscillator can be described"
}], "Text"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "m", " ", "b", " ", 
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
    RowBox[{"m", " ", 
     SuperscriptBox["\[Omega]", "2"], 
     RowBox[{"x", "[", "t", "]"}]}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "where ",
 StyleBox["b", "Input"],
 " is the \"damping coefficient.\" Looking to the general solution (with some \
not-quite-general initial conditions)"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DampedOscillatorMotion", "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "b", " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["\[Omega]", "2"], 
           RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "v"}]}], "}"}], 
      ",", 
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.3952736686138067`*^9, 3.395273678681081*^9}, {
  3.3952737314596357`*^9, 3.395273736238254*^9}}],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "b"}], "-", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["b", "2"], "-", 
            SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]], "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "b"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["b", "2"], "-", 
            SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]]}], ")"}], " ", 
    "v"}], 
   RowBox[{"2", " ", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["b", "2"], "-", 
      SuperscriptBox["\[Omega]", "2"]}]]}]]}]], "Output",
 CellChangeTimes->{3.444483929118897*^9}]
}, Open  ]],

Cell[TextData[{
 "we see that cases with ",
 StyleBox["strong damping",
  FontWeight->"Bold"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "2"], ">", 
    SuperscriptBox["\[Omega]", "2"]}], TraditionalForm]]],
 ") are qualitatively distinct from those with ",
 StyleBox["weak damping",
  FontWeight->"Bold"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "2"], "<", 
    SuperscriptBox["\[Omega]", "2"]}], TraditionalForm]]],
 "), and that the ",
 StyleBox["critical case",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["b", "2"], "=", 
    SuperscriptBox["\[Omega]", "2"]}], TraditionalForm]]],
 " separates the two regimes. To illustrate the point, we (simply to reduce \
the number of free variables) set \[Omega] = v = 3 and look serially to \
typical instances of each of those characteristic types of damped oscillator \
motion:"
}], "Text",
 CellChangeTimes->{{3.395273882868951*^9, 3.395273884027075*^9}, {
  3.395276614216083*^9, 3.395276627199069*^9}, {3.3952766673844967`*^9, 
  3.395276695647697*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3952767094501543`*^9, 3.3952767094564333`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Underdamped Case ",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395276734826544*^9, 3.39527674274502*^9}, {
  3.3952767992102413`*^9, 3.395276816546988*^9}}],

Cell[TextData[{
 "We look to the case ",
 Cell[BoxData[
  StyleBox[
   RowBox[{
    SuperscriptBox["b", "2"], "=", 
    RowBox[{
     RowBox[{"1", "/", "4"}], "\[LessLess]", " ", 
     SuperscriptBox["\[Omega]", "2"]}]}], "Output"]],
  CellChangeTimes->{{3.395276890855276*^9, 3.395276955047406*^9}}],
 ". While we could specialize/simplify the general result already in hand"
}], "Text",
 CellChangeTimes->{{3.395276856611413*^9, 3.395276885115758*^9}, {
  3.3952769663648653`*^9, 3.395277001495634*^9}, {3.3952773500986013`*^9, 
  3.395277381467511*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ExpToTrig", "[", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"t", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "b"}], "-", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["b", "2"], "-", 
              SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]], "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"t", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "b"}], "+", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["b", "2"], "-", 
              SuperscriptBox["\[Omega]", "2"]}]]}], ")"}]}]]}], ")"}], " ", 
      "v"}], 
     RowBox[{"2", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["b", "2"], "-", 
        SuperscriptBox["\[Omega]", "2"]}]]}]], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b", "\[Rule]", 
       RowBox[{"1", "/", "2"}]}], ",", " ", 
      RowBox[{"\[Omega]", "\[Rule]", "3"}], ",", 
      RowBox[{"v", "\[Rule]", "3"}]}], "}"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.3952770322360287`*^9, 3.395277045849206*^9}, {
  3.3952771343167686`*^9, 3.395277208041676*^9}}],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"6", " ", 
    RowBox[{"Sin", "[", 
     FractionBox[
      RowBox[{
       SqrtBox["35"], " ", "t"}], "2"], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       FractionBox["t", "2"], "]"}], "-", 
      RowBox[{"Sinh", "[", 
       FractionBox["t", "2"], "]"}]}], ")"}]}], 
   SqrtBox["35"]]}]], "Output",
 CellChangeTimes->{3.444483937467403*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TrigToExp", "[", 
  RowBox[{
   RowBox[{"Cosh", "[", 
    FractionBox["t", "2"], "]"}], "-", 
   RowBox[{"Sinh", "[", 
    FractionBox["t", "2"], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.395277302167633*^9, 3.395277324445342*^9}}],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{
   RowBox[{"-", "t"}], "/", "2"}]]], "Output",
 CellChangeTimes->{3.4444839407369328`*^9}]
}, Open  ]],

Cell["\<\
it is simpler to back up and solve the particularized differential equation:\
\>", "Text",
 CellChangeTimes->{{3.395277386938191*^9, 3.3952774490841303`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UnderdampedOscillation", "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           RowBox[{"(", 
            StyleBox[
             RowBox[{"1", "/", "2"}],
             FontColor->RGBColor[1, 0, 0]], ")"}], " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["3", "2"], 
           RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], 
      ",", 
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.395275039666728*^9, 3.395275070775942*^9}, {
  3.395275391400922*^9, 3.395275418696684*^9}, {3.3952754933704*^9, 
  3.395275503102516*^9}, {3.395277483670287*^9, 3.395277493383089*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{"6", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "t"}], "/", "2"}]], " ", 
   RowBox[{"Sin", "[", 
    FractionBox[
     RowBox[{
      SqrtBox["35"], " ", "t"}], "2"], "]"}]}], 
  SqrtBox["35"]]], "Output",
 CellChangeTimes->{3.444483943918215*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"6", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "2"}]], " ", 
       RowBox[{"Sin", "[", 
        FractionBox[
         RowBox[{
          SqrtBox["35"], " ", "t"}], "2"], "]"}]}], 
      SqrtBox["35"]], ",", 
     FractionBox[
      RowBox[{"6", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "t"}], "/", "2"}]]}], 
      SqrtBox["35"]], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"6", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "t"}], "/", "2"}]], " "}], 
       SqrtBox["35"]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", 
        RowBox[{"Thickness", "[", ".005", "]"}]}], "}"}], ",", "Blue", ",", 
      "Blue"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.395275304379697*^9, 3.395275324984984*^9}, {
  3.395275446891212*^9, 3.3952754618643513`*^9}, {3.395275526541144*^9, 
