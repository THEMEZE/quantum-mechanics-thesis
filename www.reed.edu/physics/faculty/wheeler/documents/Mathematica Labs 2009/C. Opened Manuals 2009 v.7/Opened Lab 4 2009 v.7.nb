Cell["The  general solution of our exponential growth equation is ", "Text",
 CellChangeTimes->{{3.395235866928925*^9, 3.395235906956448*^9}, {
   3.395236024984931*^9, 3.395236029664908*^9}, {3.395236117312999*^9, 
   3.395236136921206*^9}, 3.396051110675727*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"P", "[", 
   RowBox[{"t_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"k", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "t"}]]}]}]], "Input",
 CellChangeTimes->{{3.395236146644212*^9, 3.3952361824858303`*^9}}],

