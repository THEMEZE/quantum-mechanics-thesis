Cell["\<\
We see that, after initial transcients have damped out, the motion acquires \
the frequency/period of the forcing function, but is shifted in phase.\
\>", "Text",
 CellChangeTimes->{{3.395331146584311*^9, 3.395331211190757*^9}, {
  3.395344999694482*^9, 3.39534500320725*^9}}],

Cell[TextData[{
 "Let us suppose now that the angular frequency is ",
 StyleBox["adjustable",
  FontWeight->"Bold"],
 " (call it ",
 StyleBox["\[CapitalOmega]", "Input"],
 "):"
}], "Text",
 CellChangeTimes->{{3.3960595220887537`*^9, 3.396059566815399*^9}}],

