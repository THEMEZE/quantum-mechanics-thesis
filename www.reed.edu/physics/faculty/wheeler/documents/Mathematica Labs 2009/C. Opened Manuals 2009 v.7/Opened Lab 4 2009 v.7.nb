       RowBox[{"cos", " ", "\[Theta]"}]}], ")"}]}], "=", 
    RowBox[{"m", " ", 
     SuperscriptBox[
      StyleBox["\[Omega]", "Output",
       FontColor->GrayLevel[0.5]], "2"], 
     SuperscriptBox["a", "2"], 
