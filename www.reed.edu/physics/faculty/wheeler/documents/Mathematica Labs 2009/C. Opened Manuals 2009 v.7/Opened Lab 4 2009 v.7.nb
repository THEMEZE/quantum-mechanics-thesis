Cell[TextData[{
 "we see that the population grows if ",
 StyleBox["P <",
  FontSlant->"Italic"],
 " 5, holds steady at ",
 StyleBox["P",
  FontSlant->"Italic"],
 " = 5, diminishes if ",
 StyleBox["P",
  FontSlant->"Italic"],
 " > 5. Proceeding"
}], "Text",
 CellChangeTimes->{{3.395239870208864*^9, 3.395239871385579*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"logistic", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "'"}], "[", "t", "]"}], "-", 
    RowBox[{
     RowBox[{"p", "[", "t", "]"}], 
     RowBox[{"(", 
      RowBox[{"5", "-", 
       RowBox[{"p", "[", "t", "]"}]}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.395239917035488*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"p", "[", "t", "]"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"logistic", "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"p", "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
     RowBox[{"p", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]], "Input"],

