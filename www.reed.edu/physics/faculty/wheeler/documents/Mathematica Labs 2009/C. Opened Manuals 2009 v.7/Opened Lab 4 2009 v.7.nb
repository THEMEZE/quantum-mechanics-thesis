        RowBox[{"-", "\[Pi]"}], ",", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], "\[Pi]"}], ",", "0", ",", 
        RowBox[{
         FractionBox["1", "2"], "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Time", ",", " ", "Angle"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{3.395364353083713*^9}],

