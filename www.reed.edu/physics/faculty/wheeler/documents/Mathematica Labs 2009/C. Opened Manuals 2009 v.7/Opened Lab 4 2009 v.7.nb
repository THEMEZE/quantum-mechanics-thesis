    RowBox[{"Ticks", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "\[Pi]"}], ",", 
         RowBox[{"-", "\[Pi]"}], ",", "0", ",", "\[Pi]", ",", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "None"}], "}"}]}], ",", 
