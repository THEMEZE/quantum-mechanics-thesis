Cell["", "Text",
 CellChangeTimes->{{3.3952402551468563`*^9, 3.395240255150985*^9}}],

Cell["", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Harmonic Oscillator",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395240355153399*^9, 3.3952403586526947`*^9}}],

Cell["The equation of physical interest reads", "Text"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"m", " ", 
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}]}], "=", 
   RowBox[{
    RowBox[{"-", "m"}], " ", 
    SuperscriptBox["\[Omega]", "2"], 
    RowBox[{"x", "[", "t", "]"}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell["\<\
and in the typical special case to which I will restrict my attention (set \
the m = 1 and set  \[Omega]  = 3) assumes the form\
\>", "Text",
 CellChangeTimes->{{3.3952654438156357`*^9, 3.3952655611851807`*^9}, {
  3.396056215497539*^9, 3.396056236268014*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "''"}], "[", "t", "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["3", "2"]}], 
    RowBox[{"x", "[", "t", "]"}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell["\<\
We declare an interest in motion that arises from the initial conditions \
\>", "Text"],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "=", "0"}], "Output",
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "=", "1"}], "Output",
  FontColor->GrayLevel[0.500008]]}], "Input"],

Cell[TextData[{
 "It is from Abell & Braselton (",
 StyleBox["Differential Equations with Mathematica",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 " (1997), page 240) that I have borrowed the commands that (after the \
adjustments required by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6) produce the following ",
 StyleBox["diagram of a mass attached to a spring",
  FontColor->RGBColor[0, 0, 1]],
 ":"
}], "Text",
 CellChangeTimes->{{3.395265680421906*^9, 3.395265681179051*^9}, {
  3.3952657897740917`*^9, 3.395265801992033*^9}, {3.395265864139595*^9, 
  3.395265930633589*^9}}],

Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold"],
 ": There is much of vaue to be learned from the following commands \
(concerning which Abell & Braselton supply explanatory remarks), but today is \
not the day\[Ellipsis]and soon the logic of the commands  will anyway be \
clear to you."
}], "Text",
 CellChangeTimes->{{3.395266029124832*^9, 3.3952661702206917`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"zigzag", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"c_", ",", "d_"}], "}"}], ",", "n_", ",", "\[Epsilon]_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"length", ",", " ", "points", ",", " ", "pairs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"length", "=", 
      RowBox[{"d", "-", "b"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"b", "+", 
         FractionBox[
          RowBox[{"i", " ", "length"}], "n"]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pairs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "+", 
           RowBox[{"\[Epsilon]", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "i"]}]}], ",", " ", 
          RowBox[{
          "points", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"PrependTo", "[", 
      RowBox[{"pairs", ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}]}], "]"}], ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pairs", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", "d"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Line", "[", "pairs", "]"}]}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"typicalposition", "=", 
   RowBox[{"3", "/", "4"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"zigzag", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "typicalposition"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", "40", ",", ".05"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PointSize", "[", ".075", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "typicalposition"}], "}"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{".1", ",", ".75"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{".3", ",", ".75"}], "}"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{".2", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{".2", ",", ".2"}], "}"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Arrowheads", "[", ".03", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Arrow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{".2", ",", ".375"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{".2", ",", ".75"}], "}"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<x\>\"", ",", 
        RowBox[{"{", 
         RowBox[{".205", ",", ".3"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", ".7", "]"}], ",", 
        RowBox[{"Rectangle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", ".5"}], ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{".5", ",", "2.2"}], "}"}]}], "]"}]}], "}"}]}], "}"}], 
    "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StyleForm", "[", 
     RowBox[{"\"\<Simple Harmonic Oscillator\>\"", ",", "\[IndentingNewLine]", 
      RowBox[{"FontFamily", "\[Rule]", "\"\<Times-Bold\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FontSize", "\[Rule]", "16"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Axes", "\[Rule]", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesStyle", "\[Rule]", 
    RowBox[{"GrayLevel", "[", ".5", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Ticks", "\[Rule]", "None"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2.2"}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.395240527426034*^9, {3.3952423048884697`*^9, 3.395242318233458*^9}, {
   3.3952423767989883`*^9, 3.3952423937323*^9}, {3.3952424435368958`*^9, 
   3.395242554228931*^9}, {3.395242592480364*^9, 3.3952426050847178`*^9}, {
   3.396057081297572*^9, 3.39605708149732*^9}}],

Cell[BoxData[
 GraphicsBox[{
   LineBox[NCache[{{0, Rational[3, 4]}, {-0.05, Rational[25, 32]}, {
      0.05, Rational[13, 16]}, {-0.05, Rational[27, 32]}, {
