         Typeset`skipInitDone$$}, "Body" :> 
      Plot[{3 (E^((-$CellContext`b$$) $CellContext`t) 
          Sin[(9 - $CellContext`b$$^2)^Rational[1, 2] $CellContext`t]/(
           9 - $CellContext`b$$^2)^Rational[1, 2]), 
         3 (E^((-$CellContext`b$$) $CellContext`t)/(9 - $CellContext`b$$^2)^
          Rational[1, 2]), (-3) (
          E^((-$CellContext`b$$) $CellContext`t)/(9 - $CellContext`b$$^2)^
          Rational[1, 2])}, {$CellContext`t, 0, 10}, PlotRange -> {-1, 1}, 
        PlotStyle -> {{Red, 
           Thickness[0.005]}, {Blue}, {Blue}}], 
      "Specifications" :> {{{$CellContext`b$$, 
