Cell[CellGroupData[{

Cell[TextData[StyleBox["Critically Damped Case",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.39527815261036*^9, 3.395278173289322*^9}}],

Cell[TextData[{
 "We look finally to the case ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SuperscriptBox["b", "2"], "Output"], 
   StyleBox["=", "Output"], 
   RowBox[{
    SuperscriptBox[
     StyleBox["3", "Output"], "2"], 
    StyleBox["=", "Output"], 
    StyleBox[" ", "Output"], 
    StyleBox[
     SuperscriptBox["\[Omega]", "2"], "Output"]}]}]],
  CellChangeTimes->{{3.395276890855276*^9, 3.395276955047406*^9}}],
 "."
}], "Text",
 CellChangeTimes->{{3.395278219980521*^9, 3.395278229604184*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CriticallyDampedOscillation", "=", 
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           RowBox[{"(", 
            StyleBox["3",
             FontColor->RGBColor[1, 0, 0]], ")"}], " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["3", "2"], 
           RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], 
      ",", 
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.395275039666728*^9, 3.395275070775942*^9}, {
   3.395275391400922*^9, 3.395275418696684*^9}, {3.3952754933704*^9, 
   3.395275503102516*^9}, {3.395277483670287*^9, 3.395277493383089*^9}, {
   3.395277720412587*^9, 3.3952777324484653`*^9}, 3.395277798335064*^9, {
   3.3952782640278893`*^9, 3.39527827488984*^9}}],

Cell[BoxData[
 RowBox[{"3", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "3"}], " ", "t"}]], " ", "t"}]], "Output",
 CellChangeTimes->{3.4444839663026257`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"3", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "3"}], " ", "t"}]], " ", "t"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"Thickness", "[", ".005", "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.395278368901873*^9, 3.395278387671576*^9}, {
  3.396057158421616*^9, 3.396057158749959*^9}}],

