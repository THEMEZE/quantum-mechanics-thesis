Cell[CellGroupData[{

Cell["\<\
 A Short Digression\[LongDash]Stan Wagon's Extraction Trick\
\>", "Subsubsection",
 CellChangeTimes->{{3.3951920256015663`*^9, 3.395192052168885*^9}, {
  3.395233882057539*^9, 3.395233894819919*^9}},
 FontColor->RGBColor[0, 0, 1]],

Cell[TextData[{
 "Stan Wagon describes (on 295 of his ",
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox[" in Action",
  FontColor->GrayLevel[0]],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "nd"], " ", "edition", " ", "1999"}], 
   TraditionalForm]]],
 ")) a better procedure, that makes use of the ",
 StyleBox["ReplaceAll", "Input"],
 " and ",
 StyleBox["First", "Input"],
 " commands. ",
 StyleBox["ReplaceAll", "Input"],
 " (denoted ",
 StyleBox["/.", "Input"],
 ") we have already encountered, and works like this:"
}], "Text",
 CellChangeTimes->{
  3.395232546391554*^9, {3.395232715269247*^9, 3.395232729026951*^9}, {
   3.395232780986175*^9, 3.395232829493638*^9}, {3.3952328652460613`*^9, 
   3.3952328712812557`*^9}, {3.395232906273493*^9, 3.395232938131465*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", "+", 
   SuperscriptBox["x", "2"]}], "/.", 
  RowBox[{"x", "\[Rule]", "tom"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"a", ",", "b", ",", "x", ",", 
    FractionBox["1", 
     RowBox[{"1", "+", "x"}]], ",", "c"}], "}"}], "/.", 
  RowBox[{"x", "\[Rule]", " ", "dick"}]}]}], "Input",
 CellChangeTimes->{{3.395232970877007*^9, 3.395232971440042*^9}}],

Cell[BoxData[
 RowBox[{"1", "+", 
  SuperscriptBox["tom", "2"]}]], "Output",
 CellChangeTimes->{3.444483376534968*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"a", ",", "b", ",", "dick", ",", 
   FractionBox["1", 
    RowBox[{"1", "+", "dick"}]], ",", "c"}], "}"}]], "Output",
 CellChangeTimes->{3.444483376543488*^9}]
}, Open  ]],

Cell[TextData[{
 StyleBox["First", "Input"],
 " is equivalent to the post-command ",
 StyleBox["\[LeftDoubleBracket]1\[RightDoubleBracket]", "Input"],
 "; both act to pluck the first element from a list:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"First", "[", 
  RowBox[{"{", 
   RowBox[{"tom", ",", " ", "dick", ",", " ", "harry"}], "}"}], 
