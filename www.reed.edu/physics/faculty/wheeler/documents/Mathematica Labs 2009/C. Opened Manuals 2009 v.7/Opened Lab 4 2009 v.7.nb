Cell[TextData[{
 "The distinction between",
 StyleBox[" ",
  FontWeight->"Bold"],
 StyleBox["oscillation",
  FontColor->RGBColor[0, 0, 1]],
 " (closed curves) and ",
 StyleBox["libration ",
  FontColor->RGBColor[0, 0, 1]],
 "(open curves) is now clearly evident.\n"
}], "Text"],

Cell["", "Text",
 CellChangeTimes->{{3.3953634286295347`*^9, 3.395363428831757*^9}}],

Cell[TextData[StyleBox["Damped Pendulum", "Subsection",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{3.395363443898808*^9, 3.395363460653063*^9}}],

Cell["We look to the illustrative equation", "Text"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   StyleBox[
    RowBox[{
     RowBox[{"\[Theta]", "''"}], "[", "t", "]"}],
    FontColor->GrayLevel[0.500008]], 
   StyleBox["\[Equal]",
    FontColor->GrayLevel[0.500008]], 
   RowBox[{
    StyleBox[
     RowBox[{"-", 
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}],
     FontColor->RGBColor[1, 0, 0]], 
    StyleBox["-",
     FontColor->GrayLevel[0.500008]], 
    StyleBox[
     RowBox[{
      SuperscriptBox["3", "2"], 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}],
     FontColor->GrayLevel[0.500008]]}]}], "Output"]], "Input"],

Cell[TextData[{
 "which results from introducing a ",
 StyleBox["damping term",
  FontColor->RGBColor[1, 0, 0]],
 " into the equation studied in the preceding section",
 StyleBox[". Mathematica",
  FontSlant->"Italic"],
 " thinks for awhile, then informs us that it is unable to supply an \
analytical solution"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["3", "2"], 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], "}"}], ",", 
    RowBox[{"\[Theta]", "[", "t", "]"}], ",", "t"}], "]"}], "//", 
  "Timing"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "::", "\<\"ifun\"\>"}], 
  RowBox[{
  ":", " "}], "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"Inverse functions are being \
used by \\\\\\\"\\\", \
\\\"MT\\\"]\\)\[NoBreak]\\!\\(\\*StyleBox[\\!\\(Solve\\), \\\"MT\\\"]\\)\
\[NoBreak]\\!\\(\\*StyleBox[\\\"\\\\\\\", so some solutions may not be found; \
use Reduce for complete solution information.\\\\\\\"\\\", \\\"MT\\\"]\\) \\!\
\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", \
ButtonFrame->None, ButtonData:>\\\"paclet:ref/message/Solve/ifun\\\", \
ButtonNote -> \\\"Solve::ifun\\\"]\\)\"\>"}]], "Message", "MSG",
 CellChangeTimes->{3.444485719169525*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"21.2666949999998`", ",", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "9"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "-", 
        RowBox[{
         SuperscriptBox["\[Theta]", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}]}], "}"}], ",", 
     RowBox[{"\[Theta]", "[", "t", "]"}], ",", "t"}], "]"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.444485729074718*^9}]
}, Open  ]],

Cell[TextData[{
 "so we ",
 StyleBox["proceed numerically",
  FontColor->RGBColor[1, 0, 0]],
 ", taking our initial conditions to be identical to those adopted at the \
beginning of the preceding discussion",
 ":"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NDSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["3", "2"], 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}],
    ",", 
   RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Theta]", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     TagBox[
      RowBox[{"InterpolatingFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0.`", ",", "10.`"}], "}"}], "}"}], ",", "\<\"<>\"\>"}], 
       "]"}],
      False,
      Editable->False], "[", "t", "]"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.4444857363940487`*^9}]
}, Open  ]],

Cell["\<\
Or better\[LongDash]as Wagon (on his p. 298) has taught us to do\[LongDash]we \
define:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dampedpendulum3000", "=", 
  RowBox[{
   RowBox[{"\[Theta]", "[", "t", "]"}], "/.", 
   RowBox[{"First", "[", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], "-", 
          RowBox[{
           SuperscriptBox["3", "2"], 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], 
       "}"}], ",", 
      RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "]"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  TagBox[
   RowBox[{"InterpolatingFunction", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "10.`"}], "}"}], "}"}], ",", "\<\"<>\"\>"}], "]"}],
   
   False,
   Editable->False], "[", "t", "]"}]], "Output",
 CellChangeTimes->{3.444485740042495*^9}]
}, Open  ]],

Cell[TextData[{
 "The",
 StyleBox[" InterpolatingFunction ", "Output"],
 "is a bunch of data that now lives in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s memory. We use graphical means to extract that data:"
}], "Text",
 CellChangeTimes->{{3.3953638455918694`*^9, 3.395363933274413*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "dampedpendulum3000", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Ticks", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], ",", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], "\[Pi]"}], ",", "0", ",", 
        RowBox[{
         FractionBox["1", "2"], "\[Pi]"}], ",", "\[Pi]"}], "}"}]}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Time", ",", " ", "Angle"}], "}"}]}]}], "]"}]], "Input"],

