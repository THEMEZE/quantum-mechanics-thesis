Cell[CellGroupData[{

Cell[TextData[StyleBox["An Unexplored Resource",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.39561877839476*^9, 3.395618792485861*^9}}],

Cell[TextData[{
 "I have only just become aware of the existence of a resource which seems to \
be new in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6, and which relates in what appears to be a very powerful to the graphic \
display of the solution of ODEs. It resides in the ",
 StyleBox["EquationTrekker",
  FontWeight->"Bold"],
 " package. To read about it, search for ",
 StyleBox["EquationTrekker/tutorial/EquationTrekker",
  FontColor->RGBColor[0, 0, 1]],
 ".  "
}], "Text",
 CellChangeTimes->{{3.395400224140147*^9, 3.3954002242094593`*^9}, {
  3.395618820612906*^9, 3.3956189235206823`*^9}, {3.3956189654774323`*^9, 
  3.3956190514196663`*^9}}]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]]
