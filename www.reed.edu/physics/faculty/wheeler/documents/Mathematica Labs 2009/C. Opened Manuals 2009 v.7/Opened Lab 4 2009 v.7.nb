Cell[TextData[{
 "The circle is the surprise\[Ellipsis]though when you think about it, such \
circles are seen every 4th of July, and become quite unsurprising when you ",
 StyleBox["consider how the particle motion would appear to an observer \
falling from the explosion point",
  FontColor->RGBColor[0, 0, 1]],
 ". "
}], "Text",
 CellChangeTimes->{{3.395396351040715*^9, 3.395396360047352*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395396435202374*^9, 3.395396435262973*^9}}],

Cell[TextData[{
 "We are in position now to do also things not commonly done in an \
introductory course. For example: let us suppose a thrown projectile \
experiences a ",
 StyleBox["drag force",
  FontColor->RGBColor[1, 0, 0]],
 " of the form"
}], "Text",
 CellChangeTimes->{3.39539646359146*^9}],

Cell[BoxData[
 StyleBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{"d", "rag"}], " ", "vector"}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"drag", " ", "coefficient"}], ")"}]}], 
     RowBox[{"(", 
      RowBox[{"velocity", " ", "vector"}], ")"}]}]}], "Output"],
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "We ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to solve"
}], "Text",
 CellChangeTimes->{{3.395397172798931*^9, 3.395397177523397*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"X", "[", "t", "]"}], ",", 
    RowBox[{"Y", "[", "t", "]"}]}], "}"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"X", "''"}], "[", "t", "]"}], "\[Equal]", 
        StyleBox[
         RowBox[{
          RowBox[{"-", "b"}], " ", 
          RowBox[{
           RowBox[{"X", "'"}], "[", "t", "]"}]}],
         FontColor->GrayLevel[0]]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Y", "''"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         StyleBox[
          RowBox[{
           RowBox[{"-", "b"}], " ", 
           RowBox[{
            RowBox[{"Y", "'"}], "[", "t", "]"}]}],
          FontColor->GrayLevel[0]], "-", "g"}]}], ",", 
       RowBox[{
        RowBox[{"X", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{"Y", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"X", "'"}], "[", "0", "]"}], "\[Equal]", 
        RowBox[{"v", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Y", "'"}], "[", "0", "]"}], "\[Equal]", 
        RowBox[{"v", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", "[", "t", "]"}], ",", 
       RowBox[{"Y", "[", "t", "]"}]}], "}"}], ",", " ", "t"}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.395396613985477*^9, 3.395396682906612*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "t"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"b", " ", "t"}]]}], ")"}], " ", "v", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "b"], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "b"}], " ", "t"}]], " ", 
      RowBox[{"(", 
       RowBox[{"g", "-", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"b", " ", "t"}]], " ", "g"}], "+", 
        RowBox[{"b", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"b", " ", "t"}]], " ", "g", " ", "t"}], "+", 
        RowBox[{"b", " ", "v", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "-", 
        RowBox[{"b", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"b", " ", "t"}]], " ", "v", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}], 
     SuperscriptBox["b", "2"]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.444485926834413*^9}]
}, Open  ]],

Cell["and on this basis define the functions", "Text",
 CellChangeTimes->{{3.39539720524229*^9, 3.395397227784198*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"X", "[", 
   RowBox[{"t_", ",", "v_", ",", "\[Theta]_", ",", "b_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "b"}], " ", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"b", " ", "t"}]]}], ")"}], " ", "v", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "b"]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y", "[", 
   RowBox[{"t_", ",", "v_", ",", "\[Theta]_", ",", "g_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["b", "2"]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "b"}], " ", "t"}]], " ", 
      RowBox[{"(", 
       RowBox[{"g", "-", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"b", " ", "t"}]], " ", "g"}], "+", 
        RowBox[{"b", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"b", " ", "t"}]], " ", "g", " ", "t"}], "+", 
        RowBox[{"b", " ", "v", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "-", 
        RowBox[{"b", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"b", " ", "t"}]], " ", "v", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}], 
     ")"}]}]}]}]}], "Input"],

Cell["which we feed into the following graphic:", "Text",
 CellChangeTimes->{{3.3953972681256*^9, 3.395397282397718*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dampedflight", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"X", "[", 
          RowBox[{"t", ",", "8", ",", 
           RowBox[{
            FractionBox["k", "20"], " ", 
            RowBox[{"\[Pi]", "/", "2"}]}], ",", 
           FractionBox["3", "10"]}], "]"}], ",", 
         RowBox[{"Y", "[", 
          RowBox[{"t", ",", "8", ",", 
           RowBox[{
            FractionBox["k", "20"], " ", 
            RowBox[{"\[Pi]", "/", "2"}]}], ",", "4", ",", 
           FractionBox["3", "10"]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
