Cell["\<\
In preparation for the next superimposition of figures we prepare variants of \
a couple of previous figures (the only adjustment is that we have extended \
the \[Theta]-range), which we paint gray:\
\>", "Text",
 CellChangeTimes->{{3.395365870627625*^9, 3.395365872276016*^9}, {
  3.39536591072079*^9, 3.395365922735927*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"G1", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"{", 
      RowBox[{"dampedpendulum8121", ",", 
       RowBox[{"D", "[", 
        RowBox[{"dampedpendulum8121", ",", "t"}], "]"}]}], "}"}], "]"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], ",", "15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "15"}], ",", "15"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"GrayLevel", "[", ".6", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotPoints", "\[Rule]", "300"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Ticks", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Pi]"}], ",", "0", ",", "\[Pi]", ",", 
         RowBox[{"2", "\[Pi]"}], ",", 
         RowBox[{"3", "\[Pi]"}], ",", 
         RowBox[{"4", "\[Pi]"}]}], "}"}], ",", "None"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "\"\<\[Theta]dot\>\""}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.395365677747304*^9}],

