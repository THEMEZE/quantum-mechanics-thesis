Cell["Now we turn on a harmonic ", "Text",
 CellChangeTimes->{{3.3953303425667753`*^9, 3.395330354514333*^9}, {
  3.3953304323958282`*^9, 3.39533043393848*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"ForcingFunction", "[", "t_", "]"}], ":=", " ", 
  RowBox[{"Sin", "[", 
   RowBox[{"2", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.3953303639781113`*^9, 3.395330395194846*^9}, 
   3.395330501118313*^9}],

Cell["with", "Text",
 CellChangeTimes->{{3.395330378143042*^9, 3.3953304157550697`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ForcingPeriod", "=", 
  RowBox[{
   FractionBox[
    RowBox[{"2", "\[Pi]"}], "2"], "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.39533045186395*^9, 3.3953305121206427`*^9}}],

Cell[BoxData["3.141592653589793`"], "Output",
 CellChangeTimes->{3.4444841034809713`*^9}]
}, Open  ]],

Cell["The equation of motion now gives (this will take a minute)", "Text",
 CellChangeTimes->{{3.395330863529513*^9, 3.3953308929158707`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "[", "t", "]"}], "/.", 
  RowBox[{"First", "[", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "+", 
         RowBox[{
          SuperscriptBox["3", "2"], 
          RowBox[{"x", "[", "t", "]"}]}]}], "\[Equal]", 
        StyleBox[
         RowBox[{"Sin", "[", 
          RowBox[{"2", "t"}], "]"}],
         FontColor->RGBColor[0, 0, 1]]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "3"}]}], "}"}], ",", 
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}]], "Input"],

