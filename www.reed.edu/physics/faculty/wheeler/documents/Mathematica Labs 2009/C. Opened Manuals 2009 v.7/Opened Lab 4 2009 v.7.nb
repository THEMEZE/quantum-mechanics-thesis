Cell["Compare that non-reentrant orbit with the following one:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"subperturbedorbit", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"x", "[", "t", "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"x", "[", "t", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"y", "[", "t", "]"}], "2"]}], ")"}], 
          StyleBox["1.49",
           FontColor->RGBColor[1, 0, 0]]]]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "''"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"y", "[", "t", "]"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"x", "[", "t", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"y", "[", "t", "]"}], "2"]}], ")"}], 
          StyleBox["1.49",
           FontColor->RGBColor[1, 0, 0]]]]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{
