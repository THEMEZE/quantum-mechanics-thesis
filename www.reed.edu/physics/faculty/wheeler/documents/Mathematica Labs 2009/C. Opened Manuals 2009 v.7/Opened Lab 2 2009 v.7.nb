Cell[TextData[{
 "It is evident\[LongDash]most vividly evident if you view the composite \
figure from the appropriate angle\[LongDash]that the ",
 StyleBox["magnitudes of the gradient vectors",
  FontWeight->"Bold"],
 " are indicated not by the length of the arrows (all have the same length) \
but by the relative ",
 StyleBox["sizes of their arrowheads",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.3949772106562767`*^9, 3.394977406063925*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394977436816737*^9, 3.394977436921152*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395957828644422*^9, 3.3959578286576643`*^9}}],

Cell["", "Text"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Polyhedra",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.39497745440932*^9, 3.394977456205921*^9}}],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 5.2 was supplemented by standard packages\[LongDash]called ",
 StyleBox["Graphics`Shapes`", "Input"],
 " and ",
 StyleBox["Graphics`Polyhedra`", "Input"],
 "\[LongDash]that provided images and other information about a variety of 3D \
geometrical forms.  In ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6 the information formerly available ",
 StyleBox["Graphics`Shapes`", "Input"],
 " in has been dispersed to a variety of other sources: in the ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 " search for ",
 StyleBox["Compatibility/tutorial/Graphics/Shapes ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["to learn about those, which include ",
  FontColor->GrayLevel[0]],
 StyleBox["Torus", "Input",
  FontColor->GrayLevel[0]],
 StyleBox[", ",
  FontColor->GrayLevel[0]],
 StyleBox["MobiusStrip", "Input",
  FontColor->GrayLevel[0]],
 StyleBox[", ",
  FontColor->GrayLevel[0]],
 StyleBox["DoubleHelix", "Input",
  FontColor->GrayLevel[0]],
 StyleBox[" and such like. ",
  FontColor->GrayLevel[0]],
 " But the information formerly provided in ",
 StyleBox["Graphics`Polyhedra`", "Input"],
 " has in v.6 been written directly into the Kernel. Here I can only hint at \
the richness of that resource, which I have on occasion found to be quite \
useful: for further information, return to the ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 " and search for ",
 StyleBox["ref/PolyhedronData",
  FontColor->RGBColor[0, 0, 1]],
 "."
}], "Text",
 CellChangeTimes->{{3.394977478122951*^9, 3.394977499639599*^9}, {
   3.3949775894351892`*^9, 3.39497763192905*^9}, {3.394977675831687*^9, 
   3.394977682258006*^9}, {3.394977717812145*^9, 3.394977754994944*^9}, {
   3.394977793236409*^9, 3.394977840918008*^9}, {3.394977919052641*^9, 
   3.394978090445436*^9}, {3.394978149244713*^9, 3.394978186918157*^9}, 
   3.3949782646935873`*^9, {3.394978297197219*^9, 3.394978315907812*^9}, {
   3.394978439409876*^9, 3.3949785320308533`*^9}, {3.394982196894597*^9, 
   3.394982219738751*^9}, {3.394982257798794*^9, 3.394982287324731*^9}, {
   3.394982320963831*^9, 3.3949823227453814`*^9}, {3.395958002905819*^9, 
   3.395958003320253*^9}, {3.395958033435936*^9, 3.39595803645297*^9}, {
   3.3959580992099524`*^9, 3.395958145793457*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PolyhedronData", "[", "\"\<Dodecahedron\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.394938755602366*^9, 3.394938778784524*^9}}],

