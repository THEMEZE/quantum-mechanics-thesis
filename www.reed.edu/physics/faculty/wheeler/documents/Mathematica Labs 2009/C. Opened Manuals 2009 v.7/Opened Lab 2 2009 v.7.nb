Cell[BoxData[{
 RowBox[{
  RowBox[{"fib", "=", 
   RowBox[{
    StyleBox["Table",
     FontColor->RGBColor[1, 0, 0]], "[", 
    RowBox[{
     RowBox[{"Fibonacci", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "10"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fibfigure", "=", 
  RowBox[{"ListPlot", "[", 
