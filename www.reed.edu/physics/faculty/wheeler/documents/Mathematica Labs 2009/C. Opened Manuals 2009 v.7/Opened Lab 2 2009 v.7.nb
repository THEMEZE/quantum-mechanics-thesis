Cell[CellGroupData[{

Cell["Dynamic Display", "Section",
 CellChangeTimes->{{3.3950036400690804`*^9, 3.39500364588733*^9}}],

Cell[TextData[{
 "This is an area in which ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6 differs most markedly from earlier versions, as becomes evident from the \
presence of a ",
 StyleBox["Dynamic Interactivity",
  FontWeight->"Bold"],
 " box on the ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 " page,  and when you click on  the ",
 StyleBox["Dynamic Visualization",
  FontWeight->"Bold"],
 " link. "
}], "Text",
 CellChangeTimes->{{3.395963571257132*^9, 3.395963699469719*^9}, {
  3.395963791275186*^9, 3.395963810854825*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Manipulate",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.3949894417100067`*^9, 3.394989444250319*^9}}],

Cell[TextData[{
 "An alternative way to make such comparisons (on-screen, not in print!) is \
provided by the powerful ",
 StyleBox["Manipulate", "Input"],
 " command, which is a new feature of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6. For details, enter the following command"
}], "Text",
 CellChangeTimes->{{3.394989481200851*^9, 3.3949895266918507`*^9}, {
