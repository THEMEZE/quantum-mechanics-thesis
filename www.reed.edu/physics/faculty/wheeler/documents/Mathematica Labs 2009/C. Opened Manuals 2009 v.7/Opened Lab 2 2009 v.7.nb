Cell["", "Text",
 CellChangeTimes->{{3.394994473849785*^9, 3.394994473855316*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Example: Motion of a Quantum Oscillator",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.394994507675776*^9, 3.39499451850749*^9}}],

Cell[TextData[{
 "By way of physical motivation: Suppose a quantum oscillator is initially in \
the equi-weighted superposition of the energy eigenstates  ",
 StyleBox["\[CapitalPsi][m, x]", "Equation"],
 " and  ",
 StyleBox["\[CapitalPsi][n, x]", "Equation"],
 ":"
}], "Text",
 CellChangeTimes->{{3.39499454872834*^9, 3.394994645245154*^9}, {
  3.394995313349986*^9, 3.394995323863574*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"x", ",", "0"}], "]"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"m", ",", "x"}], "]"}], "+", 
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"n", ",", "x"}], "]"}]}], 
    SqrtBox["2"]]}], "Output",
  FontColor->GrayLevel[0.5]]], "Equation",
 CellChangeTimes->{{3.394994651858585*^9, 3.394994683350294*^9}, {
   3.394994722823607*^9, 3.394994749116789*^9}, 3.3959647393191147`*^9, 
   3.395965117843253*^9, 3.395965154641377*^9}],

Cell["At time t it will be then in the state", "Text",
 CellChangeTimes->{{3.394994871293006*^9, 3.3949948866557093`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalPsi]", "[", 
       RowBox[{"m", ",", "x"}], "]"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], 
        RowBox[{"(", 
         RowBox[{"m", "+", 
          FractionBox["1", "2"]}], ")"}], "t"}]]}], "+", 
     RowBox[{
      RowBox[{"\[CapitalPsi]", "[", 
       RowBox[{"n", ",", "x"}], "]"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], 
        RowBox[{"(", 
         RowBox[{"n", "+", 
          FractionBox["1", "2"]}], ")"}], "t"}]]}]}], 
    SqrtBox["2"]]}], "Input"]], "Input"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", "m"}], ")"}], " ", "t"}], "-", 
       FractionBox[
        SuperscriptBox["x", "2"], "4"]}]], " ", 
     RowBox[{"HermiteH", "[", 
      RowBox[{"m", ",", 
       FractionBox["x", 
        SqrtBox["2"]]}], "]"}]}], 
    RowBox[{
     SqrtBox[
      SuperscriptBox["2", "m"]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]"}], ")"}], 
      RowBox[{"1", "/", "4"}]], " ", 
     SqrtBox[
      RowBox[{"m", "!"}]]}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", "n"}], ")"}], " ", "t"}], "-", 
       FractionBox[
        SuperscriptBox["x", "2"], "4"]}]], " ", 
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", 
       FractionBox["x", 
        SqrtBox["2"]]}], "]"}]}], 
    RowBox[{
     SqrtBox[
      SuperscriptBox["2", "n"]], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2", " ", "\[Pi]"}], ")"}], 
      RowBox[{"1", "/", "4"}]], " ", 
     SqrtBox[
      RowBox[{"n", "!"}]]}]]}], 
  SqrtBox["2"]]], "Output",
 CellChangeTimes->{3.3959660377549267`*^9}]
}, Open  ]],

Cell["\<\
The probability of finding the particle in the neighborhood of the point x at \
time t is given then by\
\>", "Text",
 CellChangeTimes->{{3.394995036650096*^9, 3.394995074459133*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"P", "[", 
   RowBox[{"x", ",", "t"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Conjugate", "[", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "]"}], 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"x", ",", "t"}], "]"}]}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox[
      RowBox[{"\[CapitalPsi]", "[", 
       RowBox[{"m", ",", "x"}], "]"}], "2"]}], "+", 
    RowBox[{
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"m", ",", "x"}], "]"}], " ", 
     RowBox[{"\[CapitalPsi]", "[", 
      RowBox[{"n", ",", "x"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "-", "n"}], ")"}], " ", "t"}], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox[
      RowBox[{"\[CapitalPsi]", "[", 
       RowBox[{"n", ",", "x"}], "]"}], "2"]}]}]}]}]], "Equation",
 CellChangeTimes->{{3.394995081674468*^9, 3.394995165860631*^9}, {
  3.3949952425435143`*^9, 3.394995289038536*^9}}],

Cell[TextData[{
 "Notice that t survives only in the cross-term: ",
 StyleBox["quantum motion (therefore ",
  FontVariations->{"Underline"->True}],
 StyleBox["all",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" motion) is an interference effect!",
  FontVariations->{"Underline"->True}],
 " We look to the case ",
 StyleBox["m=2", "Equation"],
 " and",
 StyleBox[" n=3", "Equation"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3949953504421253`*^9, 3.3949954112120028`*^9}, {
  3.3949954550585203`*^9, 3.394995488761921*^9}}],

Cell[TextData[{
 "The red part of the following command plots ",
 StyleBox["P[x,t]", "Equation"],
 " at time t, and the remainder of the command increments t, thus generating \
the animation:"
}], "Text",
 CellChangeTimes->{{3.394995598449935*^9, 3.3949956618840227`*^9}}],

