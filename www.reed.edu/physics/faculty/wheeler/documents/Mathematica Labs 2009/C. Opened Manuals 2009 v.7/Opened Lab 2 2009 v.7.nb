Cell[TextData[{
 "For a large collection of design-it-yourself rotatable polyhedra, visit ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"WolframPolyhedra\"\>", True->
     StyleBox["\<\"WolframPolyhedra\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL[
      "http://library.wolfram.com/webMathematica/Graphics/Polyhedron.jsp"], 
      None},
    ButtonNote->
     "http://library.wolfram.com/webMathematica/Graphics/Polyhedron.jsp"],
   Annotation[#, 
    "http://library.wolfram.com/webMathematica/Graphics/Polyhedron.jsp", 
    "Hyperlink"]& ]],
  CellChangeTimes->{3.3958023148949203`*^9}],
 "."
}], "Text",
 CellChangeTimes->{{3.395802111945146*^9, 3.395802143766013*^9}, {
  3.395802325459359*^9, 3.395802347545557*^9}, {3.395834932818241*^9, 
  3.3958349366013327`*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3949824368756638`*^9, 3.394982436889703*^9}}],

Cell["", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Composite Figures",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.394982451246463*^9, 3.394982454707829*^9}}],

Cell["\<\
Frequently one has need to display related figures in a way that facilitates \
their comparison.  I review here some some techniques standard to printed \
publication, my main objective being to prepare the ground for discussion of \
a much more vividly powerful technique that was made possible by the \
invention of electronic modes of publication.\
\>", "Text",
 CellChangeTimes->{{3.394986803982079*^9, 3.3949868211867533`*^9}}],

Cell[TextData[{
 "Some of the relevant commands employed in this connection by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6 differ from those used in earlier versions of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". Most notably, ",
 StyleBox["GraphicsArray", "Input"],
 " has been superseded by ",
 StyleBox["GraphicsGrid", "Input"],
 " and ",
 StyleBox["Grid", "Input"],
 ".  To read about the details, go to the ",
 StyleBox["Documentation Center",
  FontWeight->"Bold"],
 " and search for ",
 StyleBox["tutorial/RedrawingAndCombiningPlots",
  FontColor->RGBColor[0, 0, 1]],
 ". "
}], "Text",
 CellChangeTimes->{{3.3949868212770643`*^9, 3.394986835698028*^9}, {
  3.394986886042026*^9, 3.394986962283416*^9}, {3.3949870804726562`*^9, 
  3.3949871005196857`*^9}, {3.394987139323091*^9, 3.3949871450003023`*^9}, {
  3.394987285986629*^9, 3.394987329099852*^9}}],

Cell["\<\
\tWe begin by introducing a population of functions that acquire importance \
for physicists because they describe the \"eigenstates\" of a quantum \
oscillator: \
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"He", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     SqrtBox[
      SuperscriptBox["2", "n"]]}], ")"}], 
   RowBox[{"HermiteH", "[", 
    RowBox[{"n", ",", 
     RowBox[{"x", "/", 
      SqrtBox["2"]}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     SqrtBox[
      RowBox[{
       RowBox[{"n", "!"}], 
       SqrtBox[
        RowBox[{"2", "\[Pi]"}]]}]]}], ")"}], 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "4"]}], 
     SuperscriptBox["x", "2"]}]], 
   RowBox[{"He", "[", 
    RowBox[{"n", ",", "x"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.394982569430311*^9, 3.3949825713253593`*^9}}],

Cell["From such evidence as this", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
  RowBox[{
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"0", ",", "x"}], "]"}], 
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"0", ",", "x"}], "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
  RowBox[{
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"1", ",", "x"}], "]"}], 
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"1", ",", "x"}], "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubsuperscriptBox["\[Integral]", 
   RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
  RowBox[{
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"0", ",", "x"}], "]"}], 
   RowBox[{"\[CapitalPsi]", "[", 
    RowBox[{"1", ",", "x"}], "]"}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]}], "Input",
 CellChangeTimes->{{3.394982648091668*^9, 3.394982658165085*^9}}],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.394982636467977*^9, 3.394982668694141*^9}],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.394982636467977*^9, 3.394982668961154*^9}],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.394982636467977*^9, 3.39498266909553*^9}]
}, Open  ]],

Cell["\<\
we infer that the \[CapitalPsi]-functions are orthonormal. A few \
\[CapitalPsi]-functions of low order are plotted below:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"state1", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"0", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", "0.7"}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"state2", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"1", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", "0.7"}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"state3", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"2", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", "0.7"}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"state4", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"3", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", "0.7"}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"state5", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"4", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", "0.7"}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"state6", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]", "[", 
     RowBox[{"5", ",", "x"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.7"}], ",", "0.7"}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.394982806043727*^9, 3.394982859717805*^9}, {
  3.394982911038966*^9, 3.39498292457957*^9}}],

