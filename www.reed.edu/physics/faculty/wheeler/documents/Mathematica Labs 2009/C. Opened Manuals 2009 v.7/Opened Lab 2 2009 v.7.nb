Cell["", "Text"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " possesses also some specifically musical audio capabilities. These can be \
read about by searching for ",
 StyleBox["Music/tutorial/Music",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[", and are accessed by importing a",
  FontColor->GrayLevel[0]],
 StyleBox[" Standard Package",
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[": ",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.395000568056757*^9, 3.395000684650524*^9}, {
