Cell[TextData[{
 "I use those primitives to construct a graphic in (if I may be forgiven for \
trivializing the work of an important artist) the \"style of Piet ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"Mondrian\"\>", True->
     StyleBox["\<\"Mondrian\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["http://en.wikipedia.org/wiki/Piet_Mondrian"], None},
    ButtonNote->"http://en.wikipedia.org/wiki/Piet_Mondrian"],
   Annotation[#, "http://en.wikipedia.org/wiki/Piet_Mondrian", 
    "Hyperlink"]& ]],
  CellChangeTimes->{3.395765638738985*^9, 3.395765760452941*^9}],
 "\" (1872\[Dash]1944): "
}], "Text",
 CellChangeTimes->{{3.394925166126815*^9, 3.394925195659446*^9}, {
   3.3949253988479643`*^9, 3.394925509014155*^9}, 3.39492557502328*^9, {
   3.3949292517516203`*^9, 3.394929264817483*^9}, 3.3957656499027357`*^9, {
   3.3957657715597677`*^9, 3.39576578242002*^9}},
 TextAlignment->Left,
 TextJustification->1.],

Cell[BoxData[
 RowBox[{
  RowBox[{"Mondrian", "=", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.05", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{".5", ",", ".5"}], "}"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.1", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1.5"}], "}"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "0", ",", 
          StyleBox["1",
           FontColor->RGBColor[0, 0, 1]]}], "]"}], ",", 
        RowBox[{"PointSize", "[", "0.15", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1.2", ",", 
           RowBox[{"-", ".5"}]}], "}"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Circle", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", ".5"}], ",", ".75"}], "}"}], ",", ".75"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{
          StyleBox["1",
           FontColor->RGBColor[1, 0, 0]], ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{"Rectangle", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", ".25"}], ",", 
            RowBox[{"-", ".25"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", ".25"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0", ",", 
            StyleBox["1",
             FontColor->RGBColor[0, 1, 0]], ",", "0"}], "]"}], ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1.6", ",", 
              RowBox[{"-", ".6"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1.7", ",", "1.25"}], "}"}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Text", "[", 
         RowBox[{"\"\<A Design After Mondrian\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.7", ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.394924641672554*^9, 3.394924693575678*^9}}],

