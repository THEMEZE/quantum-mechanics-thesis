Cell[CellGroupData[{

Cell["Example: Motion of a Classical Oscillator", "Subsubsection",
 CellChangeTimes->{{3.3949965062986813`*^9, 3.39499652321498*^9}}],

Cell["\<\
Here I use graphics primatives to construct the image of a particle \
oscillating with unit period at the end of a rubber band. \
\>", "Text",
 CellChangeTimes->{{3.3949965560285063`*^9, 3.394996753540946*^9}, {
  3.3949969259702*^9, 3.3949969425718*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Animate", "[", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"0", ",", "0", ",", "1"}], "]"}], ",", 
          RowBox[{"Disk", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "+", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}], ",", "0"}], "}"}], 
            ",", ".1"}], "]"}]}], "}"}], ",", 
        RowBox[{"(*", 
         StyleBox[
          RowBox[{"mass", " ", "point"}],
          FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.7", "]"}], ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", ".1"}], ",", 
              RowBox[{"-", ".5"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", ".5"}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"(*", 
         StyleBox[
          RowBox[{"left", " ", "wall"}],
          FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.7", "]"}], ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"4", ",", 
              RowBox[{"-", ".5"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"4.1", ",", ".5"}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"(*", 
         StyleBox[
          RowBox[{"right", " ", "wall"}],
          FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RGBColor", "[", 
           RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"-", ".02"}], "+", 
               RowBox[{".01", 
                RowBox[{"Cos", "[", 
                 RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1.9", "+", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}], ",", 
              RowBox[{".02", "-", 
               RowBox[{".01", 
                RowBox[{"Cos", "[", 
                 RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}]}], "}"}]}], 
           "]"}]}], "}"}]}], 
       RowBox[{"(*", 
        StyleBox[
         RowBox[{"rubber", " ", "band"}],
         FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "}"}], 
      "]"}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", " ", 
   RowBox[{"AnimationRunning", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.394996222036313*^9, 3.394996274103489*^9}, {
   3.394996413660089*^9, 3.3949964309347563`*^9}, 3.3959661511849937`*^9}],

