Cell[TextData[{
 "I must admit: the graphic (as oppposed to acoustic) output from audio \
commands was much more interesting and informative in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 5 than they have become in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6."
}], "Text",
 CellChangeTimes->{{3.39506397137892*^9, 3.395063976454719*^9}, {
