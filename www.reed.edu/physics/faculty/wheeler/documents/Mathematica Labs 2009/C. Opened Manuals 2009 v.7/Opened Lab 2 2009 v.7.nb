Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": The presence of the",
 StyleBox[" AnimationRunning->False", "Input"],
 " command causes the animation to run only when when we hit the \"Play\" \
button. In the absence of that option, the figure would run all the time, \
which can become annoying. "
}], "Text",
 CellChangeTimes->{{3.395965457003368*^9, 3.395965603693392*^9}}],

