Cell[TextData[{
 "Note that (and how) the rubber band has been designed to get thicker as it \
gets shorter. The right wall was included as a way of forcing all frames to \
be drawn to the same scale; otherwise ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " would draw each to its own scale\[LongDash]the scale that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", in its wisdom, considers in each instance to be \"optimal.\""
}], "Text",
 CellChangeTimes->{{3.394996909412196*^9, 3.394996932812828*^9}}],

Cell[TextData[{
 "More important: ",
 StyleBox["notice again the method used to insert comments into the command",
  FontColor->RGBColor[1, 0, 0]],
 ". In long/complicated commands such comments are often helpful."
}], "Text",
 CellChangeTimes->{{3.3949969586727324`*^9, 3.394997003466494*^9}, {
  3.3949971126115837`*^9, 3.394997118698073*^9}, {3.3959662309522247`*^9, 
  3.395966238033835*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394997302885672*^9, 3.394997302897757*^9}}]
}, Open  ]],

