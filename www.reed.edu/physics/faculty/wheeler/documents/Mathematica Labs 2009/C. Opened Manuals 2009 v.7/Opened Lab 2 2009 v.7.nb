Cell[CellGroupData[{

Cell[TextData[StyleBox["Graphical Representation of Vector Fields",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.3949344023628473`*^9, 3.3949344358608828`*^9}}],

Cell[TextData[{
 "As physicists, we spend a lot of time thinking about \"vector fields\" of \
various sorts (they might be electric/magnetic/gravitational force fields, or \
might refer to some kind of \"flow,\" etc.)\[Ellipsis]but we seldom attempt \
to draw pictures of such objects.  ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " takes the pain out of that exercise, and the results are often quite \
informative."
}], "Text",
 CellChangeTimes->{{3.3949345059572144`*^9, 3.39493451524935*^9}}],

Cell[TextData[{
 "To gain access to that powerful resource one must import the ",
 StyleBox["Vector Field Plotting Package",
  FontWeight->"Bold"],
 " \[Ellipsis]but, before we do so, I interpolate a general comment \
concerning  "
}], "Text",
 CellChangeTimes->{{3.394934682567597*^9, 3.39493474237341*^9}, {
  3.394935859651478*^9, 3.394935877765704*^9}, {3.395956781802019*^9, 
  3.39595684750879*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3959574110531387`*^9, 3.395957411062201*^9}}],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["The Preferred Way to Load Packages",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395956867179105*^9, 3.395956878813918*^9}}],

Cell[TextData[{
 "Two alternative commands are available, the ",
 StyleBox["Needs", "Input"],
 " command"
}], "Text",
 CellChangeTimes->{{3.3959569142711143`*^9, 3.395956930813916*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Needs"}]], "Input",
 CellChangeTimes->{{3.395956455534891*^9, 3.3959564587217093`*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"Needs\\\", \\\"[\\\", \
StyleBox[\\\"\\\\\\\"\\\\!\\\\(\\\\*StyleBox[\\\\\\\"context\\\\\\\",\\\\\\\"\
TI\\\\\\\"]\\\\)`\\\\\\\"\\\", ShowStringCharacters->True], \\\"]\\\"}]\\) \
loads an appropriate file if the specified context is not already in \
$Packages. \\n\\!\\(\\*RowBox[{\\\"Needs\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"\\\\\\\"\\\\!\\\\(\\\\*StyleBox[\\\\\\\"context\\\\\\\",\
\\\\\\\"TI\\\\\\\"]\\\\)`\\\\\\\"\\\", ShowStringCharacters->True], \
\\\",\\\", StyleBox[\\\"\\\\\\\"\\\\!\\\\(\\\\*StyleBox[\\\\\\\"file\\\\\\\",\
\\\\\\\"TI\\\\\\\"]\\\\)\\\\\\\"\\\", ShowStringCharacters->True]}], \
\\\"]\\\"}]\\) loads \\!\\(\\*StyleBox[\\\"file\\\", \\\"TI\\\"]\\) if the \
specified context is not already in $Packages. \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Needs"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.3959564639223127`*^9},
 CellTags->"Info3395931262-2283397"]
}, Open  ]],

Cell[TextData[{
 "and the ",
 StyleBox["Get", "Input"],
 " command (of which ",
 StyleBox["<<", "Input"],
 " is the symbolic name):"
}], "Text",
 CellChangeTimes->{{3.39595695712551*^9, 3.39595707543307*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Get"}]], "Input",
 CellChangeTimes->{{3.395956967439465*^9, 3.395956968481556*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"<<\\\", StyleBox[\\\"name\\\", \
\\\"TI\\\"]}]\\) reads in a file, evaluating each expression in it, and \
returning the last one. \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Get"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.3959569715407467`*^9},
 CellTags->"Info3395931771-7691032"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "<<"}]], "Input",
 CellChangeTimes->{{3.395956694114952*^9, 3.395956696965521*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"<<\\\", StyleBox[\\\"name\\\", \
\\\"TI\\\"]}]\\) reads in a file, evaluating each expression in it, and \
returning the last one. \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Get"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.395956702460177*^9},
 CellTags->"Info3395931501-8269410"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " tends to become caught up in an endless loop and crash when asked to \"get\
\" something that has already been \"got,\" whereas Needs undertakes to get \
the thing only if it ",
 StyleBox["has not already",
  FontSlant->"Italic"],
 " been got, and thus avoids such difficulties. ",
 StyleBox["Needs", "Input"],
 "\[LongDash]not ",
 StyleBox["<<", "Input"],
 "\[LongDash]is therefore the preferred (because least hazardous) command. "
}], "Text",
 CellChangeTimes->{{3.395957111200946*^9, 3.3959572576829042`*^9}, {
   3.395957303515554*^9, 3.3959573558777246`*^9}, 3.395957391467176*^9}],

Cell["", "Text",
 CellChangeTimes->{{3.3959574015906773`*^9, 3.395957401668332*^9}}],

Cell["", "Text"],

Cell["\<\
Returning now to the main line of the present discussion, we import the \
package\
\>", "Text",
 CellChangeTimes->{{3.395957431848373*^9, 3.395957458558218*^9}}],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<VectorFieldPlots`\>\"", "]"}]], "Input"],

Cell["and inquire about its contents:", "Text",
 CellChangeTimes->{{3.3959574710463963`*^9, 3.395957480254003*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "VectorFieldPlot"}]], "Input",
 CellChangeTimes->{{3.396742251455822*^9, 3.396742258338418*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"VectorFieldPlot\\\", \\\"[\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"f\\\", \
\\\"TI\\\"], StyleBox[\\\"x\\\", \\\"TI\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"f\\\", \\\"TI\\\"], StyleBox[\\\"y\\\", \
\\\"TI\\\"]]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{StyleBox[\\\"x\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\
\", RowBox[{StyleBox[\\\"y\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]]}], \\\"}\\\"}]}], \\\"]\\\"}]\\) generates \
a plot of the vector field given by the vector valued function \
\\!\\(\\*RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"f\\\", \\\"TI\\\
\"], StyleBox[\\\"x\\\", \\\"TI\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"f\
\\\", \\\"TI\\\"], StyleBox[\\\"y\\\", \\\"TI\\\"]]}], \\\"}\\\"}]\\) as a \
function of \\!\\(\\*StyleBox[\\\"x\\\", \\\"TI\\\"]\\) and \
\\!\\(\\*StyleBox[\\\"y\\\", \
\\\"TI\\\"]\\).\\n\\!\\(\\*RowBox[{\\\"VectorFieldPlot\\\", \\\"[\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"f\\\", \
\\\"TI\\\"], StyleBox[\\\"x\\\", \\\"TI\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"f\\\", \\\"TI\\\"], StyleBox[\\\"y\\\", \
\\\"TI\\\"]]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{StyleBox[\\\"x\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]], \\\",\\\", StyleBox[\\\"dx\\\", \
\\\"TI\\\"]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{StyleBox[\\\
\"y\\\", \\\"TI\\\"], \\\",\\\", SubscriptBox[StyleBox[\\\"y\\\", \
\\\"TI\\\"], StyleBox[\\\"min\\\", \\\"TI\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], StyleBox[\\\"max\\\", \
\\\"TI\\\"]], \\\",\\\", StyleBox[\\\"dy\\\", \\\"TI\\\"]}], \\\"}\\\"}]}], \
\\\"]\\\"}]\\) uses steps \\!\\(\\*StyleBox[\\\"dx\\\", \\\"TI\\\"]\\) in \
variable \\!\\(\\*StyleBox[\\\"x\\\", \\\"TI\\\"]\\), and steps \
\\!\\(\\*StyleBox[\\\"dy\\\", \\\"TI\\\"]\\) in variable \\!\\(\\*StyleBox[\\\
\"y\\\", \\\"TI\\\"]\\).\"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
