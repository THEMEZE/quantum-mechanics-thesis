Cell[TextData[{
 "Stop the animation, do ",
 StyleBox["repeated",
  FontVariations->{"Underline"->True}],
 " clicks on the up-control to accelerate the film, repeated clicks on the \
down-control to slow it down. "
}], "Text",
 CellChangeTimes->{{3.3949957707641478`*^9, 3.3949958050375023`*^9}, {
  3.3949958484917583`*^9, 3.3949958827344933`*^9}, {3.395966101318919*^9, 
