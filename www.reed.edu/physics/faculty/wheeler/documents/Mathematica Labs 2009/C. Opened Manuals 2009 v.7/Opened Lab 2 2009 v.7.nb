Cell[TextData[{
 "This fulsome output provides vivid evidence of why people have tended to \
avoid accurate figures by hand! And why they can never hope to achieve the \
accurate detail that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " insists upon achieving."
}], "Text",
 CellChangeTimes->{{3.395956132148608*^9, 3.395956238419838*^9}}],

Cell[TextData[{
 "To learn more about this subject, go to ",
 StyleBox["Help > Documentation Center",
  FontWeight->"Bold"],
 " and, in the search window, ask first about ",
 StyleBox["ref/Graphics",
  FontColor->RGBColor[0, 0, 1]],
 " and then about ",
 StyleBox["tutorial/TheStructureOfGraphics",
  FontColor->RGBColor[0, 0, 1]],
 "."
}], "Text",
 CellChangeTimes->{{3.394930735071122*^9, 3.3949307824362507`*^9}, {
  3.3949308207417603`*^9, 3.394930860095105*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.394930936958881*^9, 3.394930936965087*^9}}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["The Graphics Menu",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.394930986231475*^9, 3.394930995303636*^9}, 
   3.394979976430694*^9}],

Cell[TextData[{
 "New to v.6 are the resouces made available by the ",
 StyleBox["Graphics",
  FontWeight->"Bold"],
 " menu. "
}], "Text",
 CellChangeTimes->{{3.394931001699891*^9, 3.394931139754854*^9}, {
   3.394931172298112*^9, 3.394931257936389*^9}, 3.394932325897575*^9}],

Cell[TextData[{
 "Consult ",
 StyleBox["Help > Documentation Center",
  FontWeight->"Bold"],
 " and, in the search window, ask about ",
 StyleBox["guide/GraphicsMenu",
  FontColor->RGBColor[0, 0, 1]],
 "."
}], "Text",
 CellChangeTimes->{{3.394932254647324*^9, 3.3949322977085238`*^9}}],

Cell[TextData[{
 "Go first to ",
 StyleBox["Graphics > New Graphic ",
  FontWeight->"Bold"],
 "(which introduces a rectangular space upon which to draw), then to ",
 StyleBox["Graphics > Drawing Tools",
  FontWeight->"Bold"],
 ", which produces a tablet displaying various tools you can  use to \
construct a graphic very much as you would draw on a piece of paper: ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " automatically converts you art into a sequence of primitive graphic \
commands."
}], "Text",
 CellChangeTimes->{{3.394932358047037*^9, 3.394932384710124*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3949342621714287`*^9, 3.3949342621787157`*^9}}],

Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.394931315524961*^9, 3.3949313167160797`*^9}}],

