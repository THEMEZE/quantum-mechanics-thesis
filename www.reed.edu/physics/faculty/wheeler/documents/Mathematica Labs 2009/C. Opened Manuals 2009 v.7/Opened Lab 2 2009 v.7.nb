          RowBox[{"2", ",", "x"}], "]"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"\[CapitalPsi]", "[", 
         RowBox[{"2", ",", "x"}], "]"}], " ", 
        RowBox[{"\[CapitalPsi]", "[", 
         RowBox[{"3", ",", "x"}], "]"}], " ", 
        RowBox[{"Cos", "[", "t", "]"}]}], "+", 
