Cell[CellGroupData[{

Cell[TextData[StyleBox["Example: Five Simultaneous Pure Tones with \
Incommensurate Frequencies ",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395002758982334*^9, 3.395002765922928*^9}, {
  3.395002833142622*^9, 3.395002861735176*^9}, {3.395002947392425*^9, 
  3.39500295537461*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Play", "[", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"1000", " ", 
