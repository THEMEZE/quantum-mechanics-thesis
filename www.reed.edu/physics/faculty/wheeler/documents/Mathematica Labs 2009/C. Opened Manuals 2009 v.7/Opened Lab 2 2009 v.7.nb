Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.394934864724854*^9, 3.394934870475573*^9}}],

Cell[TextData[{
 "A 2-dimensional vector field is a 2-element list, of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "x"], "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", " ", 
     RowBox[{
      SubscriptBox["V", "y"], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "}"}], TraditionalForm]], 
  "Equation"],
 ". Consider this specific example:"
}], "Text",
 CellChangeTimes->{{3.3949349033407707`*^9, 3.394935005616387*^9}, {
  3.394935050579783*^9, 3.3949350749373083`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"vectorfield", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "4"], "+", 
     SuperscriptBox["y", "4"], "-", 
     RowBox[{"6", 
      SuperscriptBox["x", "2"], 
      SuperscriptBox["y", "2"]}], "-", "1"}], ",", 
    RowBox[{
     RowBox[{"4", "x", " ", 
      SuperscriptBox["y", "3"]}], "-", 
     RowBox[{"4", 
      SuperscriptBox["x", "3"], "y"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.394935096442891*^9, 3.394935104525435*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VectorFieldPlot", "[", 
  RowBox[{
   RowBox[{"vectorfield", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.39493521076129*^9, 3.3949352307763*^9}}],

