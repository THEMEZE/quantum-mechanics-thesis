Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Play", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"2", "\[Pi]", " ", "440", " ", "t"}], "]"}], "+", 
    RowBox[{"Sin", "[", 
