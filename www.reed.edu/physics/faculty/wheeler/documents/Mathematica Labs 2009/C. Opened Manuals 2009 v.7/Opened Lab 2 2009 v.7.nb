Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Play"}]], "Input",
 CellChangeTimes->{{3.395966673473957*^9, 3.395966676483735*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"Play\\\", \\\"[\\\", RowBox[{StyleBox[\\\
\"f\\\", \\\"TI\\\"], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{StyleBox[\\\"t\\\", \\\"TI\\\"], \\\",\\\", \
SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]]}], \\\"}\\\"}]}], \\\"]\\\"}]\\) creates \
an object that plays as a sound whose amplitude is given by \
\\!\\(\\*StyleBox[\\\"f\\\", \\\"TI\\\"]\\) as a function of time \
\\!\\(\\*StyleBox[\\\"t\\\", \\\"TI\\\"]\\) in seconds between \
\\!\\(\\*SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]]\\) and \\!\\(\\*SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]]\\). \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Play"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.395966678625184*^9},
 CellTags->"Info3395941477-9736163"]
}, Open  ]],

