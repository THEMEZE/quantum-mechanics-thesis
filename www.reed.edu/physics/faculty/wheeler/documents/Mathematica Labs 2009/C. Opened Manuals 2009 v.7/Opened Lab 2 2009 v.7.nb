Cell[TextData[{
 "The function ",
 StyleBox["Sin[2 \[Pi] 440 t]\[LongDash]with t interpreted to mean \"time,\" \
in  seconds\[LongDash]describes oscillations of unit amplitude at 440 Hz. \
Here we ", "Equation"],
 StyleBox["listen", "Equation",
  FontSlant->"Italic"],
 StyleBox[" to that function:", "Equation"]
}], "Text",
 CellChangeTimes->{{3.3949998758623238`*^9, 3.394999994518877*^9}}],

