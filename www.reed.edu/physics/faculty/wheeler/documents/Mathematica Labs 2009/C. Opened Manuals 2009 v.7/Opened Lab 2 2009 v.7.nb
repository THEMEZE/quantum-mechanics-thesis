StyleBox[\\\"2\\\", \\\"TR\\\"]]}], \\\"}\\\"}]}], \\\"}\\\"}], \
\\\"]\\\"}]\\) is a graphics primitive which represents an arrow from \
\\!\\(\\*RowBox[{\\\"(\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\
\"], StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"y\
\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \\\"TR\\\"]]}], \\\")\\\"}]\\) to \
\\!\\(\\*RowBox[{\\\"(\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\
\"], StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"y\
