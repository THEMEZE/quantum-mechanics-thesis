Cell[CellGroupData[{

Cell[TextData[StyleBox["A Non-acoustic Application of Audio",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395000229399644*^9, 3.395000244499627*^9}}],

Cell["\<\
We \"listen\" to the function that describes (among other things) quantum \
state of a uniformly accelerated particle:\
\>", "Text",
 CellChangeTimes->{{3.395000254455524*^9, 3.3950002880415297`*^9}, {
  3.395003902529373*^9, 3.3950039220788183`*^9}}],

