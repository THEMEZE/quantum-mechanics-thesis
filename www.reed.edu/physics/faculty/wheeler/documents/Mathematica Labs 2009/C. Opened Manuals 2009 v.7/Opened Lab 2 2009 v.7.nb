Cell[TextData[StyleBox["Example: Five Simultaneous Pure Tones with Changing \
Frequencies ",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395002877012581*^9, 3.395002883700933*^9}, 
