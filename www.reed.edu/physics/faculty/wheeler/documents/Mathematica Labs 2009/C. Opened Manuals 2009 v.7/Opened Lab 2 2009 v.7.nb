Cell[CellGroupData[{

Cell["Audio", "Section",
 CellChangeTimes->{{3.39500370686353*^9, 3.395003710817451*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395003721594859*^9, 3.3950037216249723`*^9}}],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " treats graphics and sound as siblings, though the former leads a very busy \
life while the latter is often neglected. They are controled by quite similar \
commands. For detailed information about ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " 6's audio capabilities, command"
}], "Text",
 CellChangeTimes->{{3.394999153912545*^9, 3.394999274909115*^9}, {
  3.395966480649955*^9, 3.395966484543551*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Sound"}]], "Input",
 CellChangeTimes->{{3.3959664163525743`*^9, 3.395966418699295*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\\!\\(\\*RowBox[{\\\"Sound\\\", \\\"[\\\", \
StyleBox[\\\"primitives\\\", \\\"TI\\\"], \\\"]\\\"}]\\) represents a sound. \
\\n\\!\\(\\*RowBox[{\\\"Sound\\\", \\\"[\\\", RowBox[{StyleBox[\\\"primitives\
\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"t\\\", \\\"TI\\\"]}], \
\\\"]\\\"}]\\) specifies that the sound should have duration \
\\!\\(\\*StyleBox[\\\"t\\\", \
\\\"TI\\\"]\\).\\n\\!\\(\\*RowBox[{\\\"Sound\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"primitives\\\", \\\"TI\\\"], \\\",\\\", \
RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], \
StyleBox[\\\"min\\\", \\\"TI\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], StyleBox[\\\"max\\\", \
\\\"TI\\\"]]}], \\\"}\\\"}]}], \\\"]\\\"}]\\) specifies that the sound should \
extend from time \\!\\(\\*SubscriptBox[StyleBox[\\\"t\\\", \\\"TI\\\"], \
StyleBox[\\\"min\\\", \\\"TI\\\"]]\\) to time \\!\\(\\*SubscriptBox[StyleBox[\
\\\"t\\\", \\\"TI\\\"], StyleBox[\\\"max\\\", \\\"TI\\\"]]\\).\"\>", "MSG"], 
  " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Sound"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.395966424657992*^9},
 CellTags->"Info3395941224-6493492"]
}, Open  ]],

