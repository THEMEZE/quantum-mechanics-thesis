Cell[CellGroupData[{

Cell["A More Interesting Example: Electric Dipole", "Subsubsection",
 CellChangeTimes->{{3.394936141106748*^9, 3.394936167656049*^9}}],

Cell["\<\
The potential in the vicinity of an electric dipole can be described\
\>", "Text",
 CellChangeTimes->{{3.3949362277050667`*^9, 3.394936247418129*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dipolepotential", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    SqrtBox[
     RowBox[{
      StyleBox[".1",
       FontColor->RGBColor[0, 0, 1]], "+", 
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"y", "-", "1"}], ")"}], "2"]}]]], "-", 
   FractionBox["1", 
    SqrtBox[
     RowBox[{
      StyleBox[".1",
       FontColor->RGBColor[0, 0, 1]], "+", 
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"y", "+", "1"}], ")"}], "2"]}]]]}]}]], "Input"],

Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold"],
 ": The ",
 StyleBox["blue terms",
  FontColor->RGBColor[0, 0, 1]],
 " on the right have been introduced (by me,  by hand) to temper the \
singularities which occur at the positions of the \[PlusMinus] charges."
}], "Text",
 CellChangeTimes->{{3.394936273817473*^9, 3.394936301563299*^9}, {
  3.394936351371706*^9, 3.3949363570791483`*^9}, {3.394936414332633*^9, 
  3.394936424797306*^9}, {3.395957614244507*^9, 3.3959576206576242`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"equipotentials", "=", 
  RowBox[{"ContourPlot", "[", 
   RowBox[{
    RowBox[{"dipolepotential", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", " ", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.3949365229534283`*^9, {3.3949365539800367`*^9, 3.394936570014742*^9}}],

