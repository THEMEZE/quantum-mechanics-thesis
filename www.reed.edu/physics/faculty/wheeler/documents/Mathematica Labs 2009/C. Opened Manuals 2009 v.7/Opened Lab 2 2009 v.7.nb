 TagBox[
  StyleBox[
   DynamicModuleBox[{Cell$$21775`t$$ = 0.07754287719726563, Typeset`show$$ = 
    True, Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
