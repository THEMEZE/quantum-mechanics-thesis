Cell[TextData[{
 "The display looks crowded. We can use ",
 StyleBox["Spacings", "Input"]
}], "Text",
 CellChangeTimes->{{3.3949886006585503`*^9, 3.394988609509819*^9}, {
  3.394988642928545*^9, 3.394988652963791*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Spacings"}]], "Input",
 CellChangeTimes->{{3.394983911952929*^9, 3.394983914004676*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"Spacings is an option to Grid and related constructs which \
specifies the spacings to leave between successive objects.\"\>", "MSG"], " ",
   
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Spacings"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.394983920486116*^9},
 CellTags->"Info3394958719-4225164"]
}, Open  ]],

Cell["to give the individual figures a bit of breathing room", "Text",
 CellChangeTimes->{{3.394988683539814*^9, 3.3949886988550177`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"boxedarray", "=", 
  RowBox[{"GraphicsGrid", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"state1", ",", " ", "state2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"state3", ",", "state4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"state5", ",", " ", "state6"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", " ", 
    RowBox[{"Ticks", "\[Rule]", "None"}], ",", " ", 
    RowBox[{"Spacings", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Scaled", "[", ".2", "]"}], ",", 
       RowBox[{"Scaled", "[", ".3", "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.394983819970769*^9, 3.394983903414291*^9}, {
  3.3949839859421597`*^9, 3.394983987085821*^9}, {3.394984065332325*^9, 
