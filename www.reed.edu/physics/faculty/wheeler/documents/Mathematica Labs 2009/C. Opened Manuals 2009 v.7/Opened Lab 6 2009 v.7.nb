Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": It is unfortunate that Wagon did not include in his program a provision \
for changing the aspect ratio of the figures it generates."
}], "Text",
 CellChangeTimes->{{3.395707416814912*^9, 3.395707512893381*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.3957075281078568`*^9, 3.395707528155389*^9}}],

Cell["\<\
\[Ellipsis]we discover faint evidence of an interstitial island at about 2.70 \
which we look at more closely:\
\>", "Text",
 CellChangeTimes->{{3.395690061619052*^9, 3.3956901074679127`*^9}, {
   3.395690745245541*^9, 3.3956907542993593`*^9}, 3.395707566777952*^9}],

