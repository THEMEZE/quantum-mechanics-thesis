Cell["It seems to repeat with period 13, so we try", "Text",
 CellChangeTimes->{{3.395716333068871*^9, 3.395716350240342*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fourierFit", "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"periodicdata", ",", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"0", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"0", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Cos", "[", 
       RowBox[{"1", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"1", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Cos", "[", 
       RowBox[{"3", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"3", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Cos", "[", 
       RowBox[{"4", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"4", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], "13"], "x"}], "]"}]}], "}"}], ",", "x"}], 
   "]"}]}]], "Input"],

