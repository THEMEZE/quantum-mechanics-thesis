Cell[CellGroupData[{

Cell[TextData[StyleBox["Wagon's Cobweb Plot",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395677425931341*^9, 3.3956774338941517`*^9}}],

Cell[TextData[{
 "Stan ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"Wagon\"\>", True->
     StyleBox["\<\"Wagon\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["http://www.stanwagon.com/"], None},
    ButtonNote->"http://www.stanwagon.com/"],
   Annotation[#, "http://www.stanwagon.com/", "Hyperlink"]& ]],
  CellChangeTimes->{3.395767952342449*^9}],
 ", at mathematician at Macalester College, had done a lot of clever things \
with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", and has an engagingly lively way of speaking/writing about them. The \
following bit of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " Programing  is taken from page 143 of his ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " in Action (2nd edition, 1999):"
}], "Text",
 CellChangeTimes->{
  3.395677379777563*^9, {3.395678102516411*^9, 3.3956781957183*^9}, {
   3.395678250403227*^9, 3.395678290728133*^9}, {3.39567837749405*^9, 
   3.3956784165443497`*^9}, {3.395678449766375*^9, 3.3956784637014*^9}, {
   3.3957679928405848`*^9, 3.3957680175719767`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"CobwebPlot", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}], ",", "x0_", ",", 
    "n_Integer"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"CobwebPlot", "[", 
   RowBox[{"f", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", "x0", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "n"}], "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CobwebPlot", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}], ",", "x0_", ",", 
    RowBox[{"{", 
     RowBox[{"n0_", ",", "n_"}], "}"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "fcn"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"fcn", "=", 
      RowBox[{"Compile", "[", 
       RowBox[{"x", ",", "f"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"NestList", "[", 
       RowBox[{"fcn", ",", 
        RowBox[{"s", "=", 
         RowBox[{"Nest", "[", 
          RowBox[{"fcn", ",", "x0", ",", "n0"}], "]"}]}], ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y0", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n0", "\[Equal]", "0"}], ",", "0", ",", "s"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"$DisplayFunction", "=", "Identity"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Plot", "[", 
            RowBox[{"f", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "a", ",", "b"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Graphics", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Thickness", "[", "0.0005", "]"}], ",", 
                RowBox[{"Line", "[", 
                 RowBox[{"Drop", "[", 
                  RowBox[{
                   RowBox[{"Prepend", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"data", "/.", 
                    RowBox[{
                    RowBox[{"z_", "?", "NumericQ"}], ":>", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"z", ",", 
                    RowBox[{"ff", "=", 
                    RowBox[{"fcn", "[", "z", "]"}]}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"ff", ",", "ff"}], "}"}]}], "}"}]}]}], ",", "1"}],
                     "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", "y0"}], "}"}]}], "]"}], ",", 
                   RowBox[{"-", "1"}]}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", 
                  RowBox[{"s", ",", "y0"}], "}"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", 
                RowBox[{"Line", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"a", ",", "a"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"b", ",", "b"}], "}"}]}], "}"}], "]"}]}], "}"}]}],
              "}"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "All"}], "}"}]}]}], "]"}]}]}],
    "]"}]}]], "Input"],

Cell["", "Text",
 CellChangeTimes->{{3.395679964213677*^9, 3.395679964216428*^9}}],

Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": ",
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" programming",
  FontVariations->{"Underline"->True}],
 " is a subject that will not be touched upon in these introductory labs. It \
is gone into in some depth in the Scientific Computing course taught by Joel \
Franklin & Darrell Schroeter, and can be read about in Roman Maeder's ",
 StyleBox["Programming in Mathematica",
  FontSlant->"Italic"],
 " (3rd edition) and other books."
}], "Text",
 CellChangeTimes->{{3.395679520003992*^9, 3.395679549457169*^9}, {
  3.395679589575739*^9, 3.39567973735712*^9}, {3.3956799170460587`*^9, 
  3.395679920554332*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395679955768888*^9, 3.39567995581314*^9}}],

Cell["Wagon's creation works like this", "Text",
 CellChangeTimes->{{3.395679980826479*^9, 3.395679987485289*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"CobwebPlot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       SubscriptBox["x", "initial"], ",", 
       SubscriptBox["x", "final"]}], "}"}], ",", 
     SubscriptBox["x", "seed"], ",", 
     RowBox[{"number", " ", "of", " ", "iterations"}]}], "]"}], ";"}], 
  "Output",
  FontColor->GrayLevel[0.5]]], "Input",
 CellChangeTimes->{{3.39568005456877*^9, 3.395680107495309*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CobwebPlot", "[", 
  RowBox[{
   RowBox[{"Cos", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", "0.2", ",", "15"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.395680010699349*^9, 3.3956800114864397`*^9}, 
   3.395680157220417*^9}],

