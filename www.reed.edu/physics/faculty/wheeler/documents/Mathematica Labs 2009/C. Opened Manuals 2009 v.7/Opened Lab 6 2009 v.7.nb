Cell["", "Text",
 CellChangeTimes->{{3.395715147265456*^9, 3.395715147338025*^9}}],

Cell[TextData[{
 "When we ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " about"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "Interpolation", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InterpolationOrder", "\[Rule]", "3"}], ",", 
   RowBox[{"PeriodicInterpolation", "\[Rule]", "False"}]}], "}"}]], "Output",
 CellChangeTimes->{3.395715170716289*^9, 3.3957153052160177`*^9}]
}, Open  ]],

Cell[TextData[{
 "we are informed that (as previously remarked)",
 StyleBox[" Interpolation", "Input"],
 " uses cubics ",
 StyleBox["by default",
  FontSlant->"Italic"],
 ", the implication being that we might elect to proceed otherwise. ",
 "  Try"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"func1", "=", 
  RowBox[{"Interpolation", "[", 
