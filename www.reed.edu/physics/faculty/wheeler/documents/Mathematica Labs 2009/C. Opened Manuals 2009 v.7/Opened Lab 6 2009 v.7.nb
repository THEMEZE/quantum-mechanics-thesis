Cell[TextData[{
 "We should remember, however, that ",
 StyleBox["infinitely many alternative curves",
  FontSlant->"Italic"],
 " also thread precisely through the prescribed set of points."
}], "Text",
 CellChangeTimes->{3.395714635612646*^9}],

Cell["", "Text",
 CellChangeTimes->{{3.395714638016036*^9, 3.3957146380906067`*^9}}],

Cell[TextData[{
 "When asked to ",
 StyleBox["extrapolate",
  FontColor->RGBColor[0, 0, 1]],
 " from the given data, ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "reminds you that extrapolation is intrinsically hazardous:"
}], "Text",
 CellChangeTimes->{{3.3957147609709167`*^9, 3.3957147791864023`*^9}, 
   3.395733908681402*^9}],

