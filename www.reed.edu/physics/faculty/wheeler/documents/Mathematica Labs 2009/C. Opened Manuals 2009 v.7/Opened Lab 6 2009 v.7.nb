Cell["\<\
Still pretty good!\[Ellipsis]though little errors are now evident.  \
\>", "Text",
 CellChangeTimes->{{3.395683737807357*^9, 3.3956837406504707`*^9}}],

Cell["\<\
If we had serious interest in numerical solution of the logistic ODE we would \
be making \[Tau] smaller and smaller.  But\[LongDash]our curiosity whetted\
\[LongDash]we abandon the ODE to concentrate on the logistic map itself, \
looking especially to its asymptotic properties.  We try a really big \[Tau] \
(\[Tau] = 1.8 ) \
\>", "Text",
 CellChangeTimes->{{3.395683768572308*^9, 3.395683772928938*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Logistic3", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "+", 
   RowBox[{
    StyleBox["1.8",
     FontColor->RGBColor[1, 0, 0]], " ", "x", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.3956838461715727`*^9, 3.39568384724621*^9}, {
  3.3956846662645082`*^9, 3.395684667898904*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Xvalues3", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{"Logistic3", ",", "0.1", ",", "50"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.3956839218458147`*^9, 3.395683931792272*^9}}],

