Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": Without the ",
 StyleBox["PlotPoints \[Rule] 3000", "Input"],
 " adjustment the figure would have been so kinky as to be almost \
unintellgible. "
}], "Text",
 CellChangeTimes->{{3.395701610153997*^9, 3.3957016211426353`*^9}, {
  3.395701787265518*^9, 3.39570181116973*^9}}],

Cell[TextData[{
 "Those figures display, in their respective ways, the ",
 StyleBox["irregular sign-reversals",
  FontColor->RGBColor[0, 0, 1]],
 " that Rikitake (and later A. E. Cook & P. H. Roberts, \"The Rikitake \
two-disc dynamo system,\" Proc. Camb. Phil. Soc. ",
 StyleBox["68",
  FontWeight->"Bold"],
 ", 644\[Dash]649 (1965)) found to be mathematically so \
surprising\[Ellipsis]and so suggestive of the physical facts of the matter \
(irregular reversals of the geomagnetic field)."
}], "Text"],

Cell["\<\
In more literature one more frequently encounters figures of this design: \
\>", "Text",
 CellChangeTimes->{{3.395701877539658*^9, 3.3957019301000433`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rikitakebutterfly", "=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", 
        RowBox[{"y", "[", "t", "]"}], ",", 
        RowBox[{"u", "[", "t", "]"}]}], "}"}], "/.", "rikitake"}], "]"}], ",",
     
