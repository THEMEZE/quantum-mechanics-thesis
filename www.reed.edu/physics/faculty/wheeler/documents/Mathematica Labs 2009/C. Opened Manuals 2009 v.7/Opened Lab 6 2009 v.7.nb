Cell[TextData[{
 "If we were motivated to ",
 StyleBox["solve the logistic equation numerically",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 " we would write"
}], "Text"],

Cell[BoxData[{
 StyleBox[
  StyleBox[
   RowBox[{
    RowBox[{"x", "[", 
     RowBox[{"t", "+", "\[Tau]"}], "]"}], "=", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "+", 
     RowBox[{"\[Tau]", " ", 
      RowBox[{"x", "[", "t", "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "[", "t", "]"}]}], ")"}]}]}]}],
   FontColor->GrayLevel[0.500008]], "Output"], "\[IndentingNewLine]", 
 StyleBox[
  StyleBox[
   RowBox[{
    RowBox[{"x", "[", "0", "]"}], "=", "0.1"}],
   FontColor->GrayLevel[0.500008]], "Output"]}], "Input"],

Cell["\<\
and iterate. We are in position now to discuss very simply what would result \
from such a procedure:\
\>", "Text",
 CellChangeTimes->{3.39568228877853*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Logistic", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "+", 
   RowBox[{
    FractionBox["1", "10"], " ", "x", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], "    ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"I", " ", "have", " ", "set", " ", "\[Tau]"}], " ", "=", " ", 
      RowBox[{"1", "/", "10"}]}], "*)"}]}]}]}]], "Input",
 CellChangeTimes->{{3.395682332370472*^9, 3.395682362036358*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Xvalues", "=", 
  RowBox[{"NestList", "[", 
   RowBox[{"Logistic", ",", "0.1", ",", "100"}], "]"}]}]], "Input",
 CellChangeTimes->{3.395682543760153*^9}],

