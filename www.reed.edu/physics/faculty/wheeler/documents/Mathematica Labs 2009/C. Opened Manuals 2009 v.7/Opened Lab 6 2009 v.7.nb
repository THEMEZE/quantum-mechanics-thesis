Cell["\<\
Might we have taken bigger \[Tau]-steps and, with less labor, still have \
obtained a satisfactory result? Back up and retrace our steps:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Logistic2", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "+", 
   RowBox[{
    StyleBox[
     FractionBox["1", "2"],
     FontColor->RGBColor[1, 0, 0]], " ", "x", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}]}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Xvalues2", "=", 
   RowBox[{"NestList", "[", 
    RowBox[{"Logistic2", ",", "0.1", ",", "20"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tvalues2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     FractionBox["i", "2"], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.395683440002887*^9, {3.395683574769916*^9, 3.395683611704596*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"logisticdata2", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"Tvalues2", ",", "Xvalues2"}], "}"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.395683653836822*^9, 3.395683660401506*^9}}],

