Cell[TextData[{
 "Finally, we ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to take the interation to however many terms it need to arrive finally at \
(to within its built-in margin of error) a ",
 StyleBox["fixed point",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.3956767792670107`*^9, 3.395676855634349*^9}}],

