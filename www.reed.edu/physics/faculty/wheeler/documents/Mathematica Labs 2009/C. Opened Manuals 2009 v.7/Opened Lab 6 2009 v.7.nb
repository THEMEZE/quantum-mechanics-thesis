}, Open  ]],

Cell[TextData[{
 "that asks ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to use its smarts to come up with a \"best\" interpolation (which ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " does by using ",
 StyleBox["piecewise cubic",
  FontColor->RGBColor[0, 0, 1]],
 " curves; we'll see in a moment what that means): "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"func", "=", 
  RowBox[{"Interpolation", "[", "data", "]"}]}]], "Input",
 CellChangeTimes->{{3.395712310714416*^9, 3.395712319204233*^9}, 
   3.395712544227089*^9}],

