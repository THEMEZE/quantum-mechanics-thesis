Cell[TextData[{
 "Let us agree to give the name \"diagonal\" to the straight line that passes \
with unit slope through (0, 0) and (1, 1); it is a graphical device for \
converting output ",
 StyleBox["f[x]", "Input"],
 " into the input of ",
 StyleBox["f[f[x]]", "Input"],
 ". The construction proceeds"
}], "Text",
 CellChangeTimes->{3.395680226307205*^9}],

Cell[BoxData[
 StyleBox[
  RowBox[{"curve", "\[Rule]", 
   RowBox[{"diagonal", "\[Rule]", 
    RowBox[{"curve", "\[Rule]", "diagonal\[Ellipsis]"}]}]}],
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "Such figures are ancient (I don't know how ancient, but were already old \
stuff when brought to my attention in a Reed College math class more than 50 \
years ago; they have been one of my favorate doodles ever since\[Ellipsis]but \
only fairly recently did I learn that they had anything to do with physics!)\
\[Ellipsis]and provide a vivid representation of the meanings both of ",
 StyleBox["f[f[\[Ellipsis][f[x]]\[Ellipsis]]]", "Input"],
 " and of the \"iterative fixed point\" concept. Such \"cobwebs\" are easy\
\[LongDash]and fun!\[LongDash]to generate with pen and paper, but successive \
generations of doodlers failed to notice their most interesting property.  \
Those come into view only with computer assistance\[Ellipsis]and soon will.  \
But first\[Ellipsis] "
}], "Text"],

Cell["\tLook to our other example (same map, different seed):", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CobwebPlot", "[", 
  RowBox[{
   RowBox[{"Cos", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
   StyleBox["0.9",
    FontColor->RGBColor[1, 0, 0]], ",", "15"}], "]"}]], "Input",
 CellChangeTimes->{{3.395680327598639*^9, 3.3956803454176292`*^9}}],

