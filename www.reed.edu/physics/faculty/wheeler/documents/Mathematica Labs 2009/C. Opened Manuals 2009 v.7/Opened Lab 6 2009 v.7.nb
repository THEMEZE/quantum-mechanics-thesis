Cell[TextData[{
 StyleBox["INSTRUCTIONS",
  FontWeight->"Bold"],
 ": It is highly instructive to view the figure from several angles. Be sure \
to do so."
}], "Text",
 CellChangeTimes->{{3.3957023079750013`*^9, 3.39570234562637*^9}, 
   3.396109302093329*^9}],

Cell["", "Text",
 CellChangeTimes->{{3.395702399608767*^9, 3.395702399680663*^9}}],

Cell["", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Lorenz Model",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.3957024120871058`*^9, 3.395702419146915*^9}}],

Cell[TextData[{
 "Gentle heating of a thin layer of (say) peanut oil gives rise to orderly \
arrays of convection cells called ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"Rayleigh-Bernard cells\"\>", True->
     StyleBox["\<\"Rayleigh-Bernard cells\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["http://faraday.physics.uiowa.edu/astro/8B10.31.htm"], None},
    ButtonNote->"http://faraday.physics.uiowa.edu/astro/8B10.31.htm"],
   Annotation[#, "http://faraday.physics.uiowa.edu/astro/8B10.31.htm", 
    "Hyperlink"]& ]],
  CellChangeTimes->{3.3961098820182343`*^9}],
 ". In an effort to clarify aspects of this striking phenomenon (which \
interested him for meteorological reasons) E. N. ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"Lorenz\"\>", True->
     StyleBox["\<\"Lorenz\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["http://en.wikipedia.org/wiki/Edward_Lorenz"], None},
    ButtonNote->"http://en.wikipedia.org/wiki/Edward_Lorenz"],
   Annotation[#, "http://en.wikipedia.org/wiki/Edward_Lorenz", 
    "Hyperlink"]& ]],
  CellChangeTimes->{3.395768271463073*^9}],
 ", in 1963, subjected the equations of fluid dynamics to radical \
simplification (see \[Section]5.1 and Appendix A in Heinz Schuster's book, \
mentioned above; for Lorenz' original paper see \"Deterministic nonperiodic \
flow,\" J. Atmos. Sci ",
 StyleBox["20",
  FontWeight->"Bold"],
 ", 130) and obtained equations  "
}], "Text",
 CellChangeTimes->{{3.3957030449227657`*^9, 3.395703047159196*^9}, {
   3.395768293508071*^9, 3.395768315539765*^9}, 3.396109917726392*^9}],

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Sigma]"}], " ", 
     RowBox[{"x", "[", "t", "]"}]}], "+", 
    RowBox[{"\[Sigma]", " ", 
     RowBox[{"y", "[", "t", "]"}]}]}]}],
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{"x", "[", "t", "]"}]}], "-", 
    RowBox[{"y", "[", "t", "]"}], "-", 
    RowBox[{"r", " ", 
     RowBox[{"x", "[", "t", "]"}], 
     RowBox[{"z", "[", "t", "]"}]}]}]}],
  FontColor->GrayLevel[0.500008]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"z", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], 
     RowBox[{"y", "[", "t", "]"}]}], "-", 
    RowBox[{"b", " ", 
     RowBox[{"z", "[", "t", "]"}]}]}]}],
  FontColor->GrayLevel[0.500008]]}], "Output"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"\[Sigma]", ">", "0"}], ",", 
   RowBox[{
    RowBox[{"r", "  ", "and", "  ", "b"}], ">", 
    RowBox[{"0", "  ", "are", " ", "parameters"}]}]}],
  FontColor->GrayLevel[0.500008]]], "Output"],

Cell[TextData[{
 "Lorenz introduced the picturesque phrase \"",
 StyleBox["butterfly effect",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 "\" to refer to a remarkable property of this system (and,  as it turns out, \
many other systems) of coupled nonlinear ODEs: ",
 StyleBox["infinitesimally different intial conditions typically tin finite \
time to radially different solutions",
  FontColor->RGBColor[0, 0, 1]],
 ". "
}], "Text",
 CellChangeTimes->{{3.395703352608769*^9, 3.395703514358673*^9}, {
  3.39570360171387*^9, 3.395703649113317*^9}}],

Cell["", "Text"],

Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": I provide here a link to an excellent applet, prepared by the San \
Francisco Exploratorium, which lets you experiment with your own instances of \
Lorenz's ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"butterfly effect\"\>", True->
     StyleBox["\<\"butterfly effect\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["http://www.exploratorium.edu/complexity/java/lorenz.html"], None},
    ButtonNote->"http://www.exploratorium.edu/complexity/java/lorenz.html"],
   Annotation[#, "http://www.exploratorium.edu/complexity/java/lorenz.html", 
    "Hyperlink"]& ]],
  CellChangeTimes->{3.395768467333293*^9}],
 "."
}], "Text",
 CellChangeTimes->{{3.39570365722202*^9, 3.395703780202663*^9}, {
  3.395768491292427*^9, 3.395768510299827*^9}, {3.396110007954237*^9, 
  3.3961100134787903`*^9}},
 TextAlignment->Left,
 TextJustification->0.],

Cell["", "Text",
 CellChangeTimes->{{3.3957038398771343`*^9, 3.395703839962406*^9}}],

Cell["\<\
Selecting parameters that are discovered by experiment to place us in the \
\"interesting part\" of parameter space, we proceed exactly as before \
\>", "Text",
 CellChangeTimes->{{3.395704237009542*^9, 3.3957042690317383`*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y", ",", "u", ",", "t"}], "]"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"lorenz", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], 
         RowBox[{"x", "[", "t", "]"}]}], "+", 
        RowBox[{"3", 
         RowBox[{"y", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"26.5", 
         RowBox[{"x", "[", "t", "]"}]}], "-", 
        RowBox[{"y", "[", "t", "]"}], "-", 
        RowBox[{
         RowBox[{"u", "[", "t", "]"}], 
         RowBox[{"x", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], 
         RowBox[{"y", "[", "t", "]"}]}], "-", 
        RowBox[{"u", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"u", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
    RowBox[{"MaxSteps", "\[Rule]", "3000"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "\[Rule]", 
     TagBox[
      RowBox[{"InterpolatingFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0.`", ",", "20.`"}], "}"}], "}"}], ",", "\<\"<>\"\>"}], 
       "]"}],
      False,
      Editable->False]}], ",", 
    RowBox[{"y", "\[Rule]", 
     TagBox[
      RowBox[{"InterpolatingFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0.`", ",", "20.`"}], "}"}], "}"}], ",", "\<\"<>\"\>"}], 
       "]"}],
      False,
      Editable->False]}], ",", 
    RowBox[{"u", "\[Rule]", 
     TagBox[
      RowBox[{"InterpolatingFunction", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0.`", ",", "20.`"}], "}"}], "}"}], ",", "\<\"<>\"\>"}], 
       "]"}],
      False,
      Editable->False]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.395704310744094*^9, 3.395704453064608*^9, 
  3.396110101527172*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"x", "[", "t", "]"}], "]"}], "/.", "%"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{3.395704337339368*^9}],

