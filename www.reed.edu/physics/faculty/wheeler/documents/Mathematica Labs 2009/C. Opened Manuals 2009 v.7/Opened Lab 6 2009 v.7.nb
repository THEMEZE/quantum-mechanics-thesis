Cell[TextData[{
 "Here as always\[LongDash]when mystified by details in a sample command \
(here: the ",
 StyleBox["PlotJoined", "Input"],
 " option, the use of ",
 StyleBox["Epilog", "Input"],
 "  and the meaning of ",
 StyleBox["/@", "Input"],
 "), we can ask ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " about them:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "ListPlot", "]"}]], "Input"],

