    RowBox[{"\[Tau]", ",", 
     StyleBox["2.43",
      FontColor->RGBColor[1, 0, 0]], ",", 
     StyleBox["2.6",
      FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["500",
      FontColor->GrayLevel[0]], ",", 
     StyleBox[
      StyleBox[
       RowBox[{"5", "0"}]],
      FontColor->GrayLevel[0]]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "1500"}], ",", 
   RowBox[{
    StyleBox["GridLines",
     FontColor->RGBColor[1, 0, 0]], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2.448", ",", "2.544", ",", "2.565"}], "}"}], ",", "None"}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1.05", ",", "1.30"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.395687826018519*^9, 3.3956878322779303`*^9}, {
