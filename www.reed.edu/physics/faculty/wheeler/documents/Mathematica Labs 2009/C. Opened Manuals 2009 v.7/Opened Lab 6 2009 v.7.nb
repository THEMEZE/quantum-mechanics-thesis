Cell["\<\
displays the results encountered along the way, so enables you to watch the \
convergence. Here we do the same with a different seed:\
\>", "Text",
 CellChangeTimes->{{3.395676698409811*^9, 3.39567675606459*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NestList", "[", 
  RowBox[{
   RowBox[{"Cos", "[", "x", "]"}], ",", 
   StyleBox["0.9",
    FontColor->RGBColor[1, 0, 0]], ",", "40"}], "]"}]], "Input",
 CellChangeTimes->{3.396138548169733*^9}],

