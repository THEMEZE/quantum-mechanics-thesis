Cell[TextData[{
 "we infer that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", though reluctant to extrapolate on the basis of ",
 StyleBox["Interpolate", "Input"],
 ", is happy to do so on the basis of information produced by ",
 StyleBox["Fit", "Input"],
 " ."
}], "Text"]
