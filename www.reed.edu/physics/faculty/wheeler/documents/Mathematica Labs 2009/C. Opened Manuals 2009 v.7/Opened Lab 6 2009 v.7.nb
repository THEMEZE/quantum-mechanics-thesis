Cell["\<\
we see that we have discovered a 7-cycle, which is bracketed on the left by a \
6-cycle (at \[Tau] = 2.630) and on the right by a 5 cycle (at \[Tau] = \
2.742).\
\>", "Text",
 CellChangeTimes->{{3.395691109938946*^9, 3.395691164481471*^9}, {
   3.395691334778081*^9, 3.395691384563819*^9}, 3.395691425668861*^9}],

Cell["\<\
Looking finally to a magnified view of the big 3-cycle island that lies in \
the neighborhood of \[Tau] = 2.84\
\>", "Text",
 CellChangeTimes->{{3.3956914301212883`*^9, 3.395691475030374*^9}, {
  3.3957002568165197`*^9, 3.395700262564046*^9}}],

