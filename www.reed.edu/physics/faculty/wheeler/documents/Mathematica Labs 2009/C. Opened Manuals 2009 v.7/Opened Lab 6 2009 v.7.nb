}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["The Logistic Map: Bifurcation and the Onset of Chaos",
 
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.39568136194147*^9, 3.3956813843656893`*^9}}],

Cell[TextData[{
 "In Laboratory 4 we encountered the \"logistic equation\" (also called the \
",
 StyleBox["Verhulst equation",
  FontColor->RGBColor[0, 0, 1]],
 ")"
}], "Text"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"x", "[", "t", "]"}]}], ")"}]}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "that models population growth with saturation (",
 StyleBox["Verhulst process",
  FontColor->RGBColor[0, 0, 1]],
 "), which is characteristically \"sigmoid\":"
}], "Text",
 CellChangeTimes->{{3.3956814813168163`*^9, 3.39568149727903*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "[", "t", "]"}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0.1"}]}], "}"}], ",", 
   RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "::", "\<\"ifun\"\>"}], 
  RowBox[{
  ":", " "}], "\<\"Inverse functions are being used by \\!\\(Solve\\), so \
some solutions may not be found; use Reduce for complete solution \
information. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/Solve/ifun\\\", ButtonNote -> \
\\\"Solve::ifun\\\"]\\)\"\>"}]], "Message", "MSG",
 CellChangeTimes->{3.3956815298074627`*^9}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    FractionBox[
     SuperscriptBox["\[ExponentialE]", "t"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"9.000000000000002`", "\[InvisibleSpace]", "-", 
        RowBox[{"1.1021821192326181`*^-15", " ", "\[ImaginaryI]"}]}], ")"}], 
      "+", 
      SuperscriptBox["\[ExponentialE]", "t"]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.395681529843822*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"logisticpopulation", "[", "t_", "]"}], ":=", 
  FractionBox[
   SuperscriptBox["\[ExponentialE]", "t"], 
   RowBox[{"9", "\[InvisibleSpace]", "+", 
    SuperscriptBox["\[ExponentialE]", "t"]}]]}]], "Input",
 CellChangeTimes->{3.395681585672042*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"exact", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"logisticpopulation", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"-", "5"}], ",", "10"}], "}"}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0", ",", "0", ",", "1"}], "]"}], "}"}]}]}], "]"}]}]], "Input",\

 CellChangeTimes->{3.39568161718148*^9}],

