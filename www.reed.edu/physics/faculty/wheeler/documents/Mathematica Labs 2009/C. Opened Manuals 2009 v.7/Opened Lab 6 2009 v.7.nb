Cell[TextData[{
 "we see (after dragging the figure to size) three micro-instances of the \
original/gross figure. This \"boxes within boxes within boxes\[Ellipsis]\" \
phenomenon\[LongDash]popularized by the ubiquitous ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    PaneSelectorBox[{False->"\<\"Mandelbrot set\"\>", True->
     StyleBox["\<\"Mandelbrot set\"\>", "HyperlinkActive"]}, Dynamic[
      CurrentValue["MouseOver"]],
     BaselinePosition->Baseline,
     FrameMargins->0,
     ImageSize->Automatic],
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["http://en.wikipedia.org/wiki/Mandelbrot_set"], None},
    ButtonNote->"http://en.wikipedia.org/wiki/Mandelbrot_set"],
   Annotation[#, "http://en.wikipedia.org/wiki/Mandelbrot_set", 
    "Hyperlink"]& ]],
  CellChangeTimes->{3.396107929009614*^9}],
 "\[LongDash]is entirely characteristic of the results that issue \
asymptotically from recursive processes."
}], "Text",
 CellChangeTimes->{{3.395691631921319*^9, 3.395691672945681*^9}, {
  3.3956919063183193`*^9, 3.3956919796464043`*^9}, {3.395692033814911*^9, 
  3.395692061775766*^9}, {3.395692103239991*^9, 3.395692163811194*^9}, {
  3.39569322866188*^9, 3.395693256326502*^9}, {3.396107948313312*^9, 
  3.396107980761858*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.395692212384959*^9, 3.395692212389339*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Comparison with a Couple of Other Maps: First Glimpse \
of Universality",
 FontColor->RGBColor[0, 0, 1]]], "Subsubsection",
 CellChangeTimes->{{3.395692225853457*^9, 3.395692247582567*^9}}],

Cell["\<\
Other maps gives rise to events which\[LongDash]remarkably\[LongDash]follow \
the same general pattern, as I will now demonstrate. Let the logistic map\
\>", "Text",
 CellChangeTimes->{{3.395693350560711*^9, 3.395693393757882*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"logisticmap", "[", 
    RowBox[{"\[Tau]_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"x", "+", 
    RowBox[{"\[Tau]", " ", "x", 
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}]}]}]}], "Output"]], "Input"],

Cell["be replaced by the ", "Text",
 CellChangeTimes->{{3.395693453217779*^9, 3.39569345676982*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"quadraticmap", "[", 
   RowBox[{"\[Tau]_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"\[Tau]", " ", "x", " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", "x"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.395693473496677*^9, 3.395693505497613*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BifurcationPlot", "[", 
  RowBox[{
   RowBox[{"quadraticmap", "[", 
    RowBox[{"\[Tau]", ",", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", 
     StyleBox["3.2",
      FontColor->GrayLevel[0]], ",", 
     StyleBox["4",
      FontColor->GrayLevel[0]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["500",
      FontColor->GrayLevel[0]], ",", 
     StyleBox[
      StyleBox[
       RowBox[{"5", "0"}]],
      FontColor->GrayLevel[0]]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotPoints", "\[Rule]", "1500"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1.0"}], "}"}]}]}], "]"}]], "Input",
