Cell[TextData[{
 "and discover that we have simply reproduced the effect of ",
 StyleBox["PlotList", "Input"],
 " with ",
 StyleBox["PlotJoined\[Rule]True", "Input"],
 " . We have, in particular, ",
 StyleBox["not",
  FontSlant->"Italic"],
 " managed to fit a straight line to the entire data set (the ",
 StyleBox["Interpolation", "Input"],
 " procedure acts \"piecewise\"). That, however, can be accomplished in the \
",
 StyleBox["least squares",
  FontColor->RGBColor[0, 0, 1]],
 " sense"
}], "Text"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"data", " ", "points"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"data", "-", 
       RowBox[{"linear", " ", "approximant"}]}], ")"}], "2"]}], "=", 
   "minimum"}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", 
  StyleBox["Fit",
   FontColor->RGBColor[1, 0, 0]]}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\!\(\*RowBox[{\\\"Fit\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"data\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"funs\\\", \
\\\"TI\\\"], \\\",\\\", StyleBox[\\\"vars\\\", \\\"TI\\\"]}], \\\"]\\\"}]\) \
finds a least\[Hyphen]squares fit to a list of data as a linear combination \
of the functions \!\(\*StyleBox[\\\"funs\\\", \\\"TI\\\"]\) of variables \!\(\
\*StyleBox[\\\"vars\\\", \\\"TI\\\"]\). \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Fit"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.3957153382789183`*^9},
 CellTags->"Info3395690137-1964985"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["{1, x}", "Input",
  FontColor->RGBColor[0, 0, 1]],
 " in the command"
}], "Text",
 CellChangeTimes->{{3.3957154296398973`*^9, 3.395715431344656*^9}, {
  3.395715484331588*^9, 3.395715498615019*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"linearFit", "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"data", ",", 
    StyleBox[
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}],
     FontColor->RGBColor[0, 0, 1]], ",", "x"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"1.0376337717776276`", "\[InvisibleSpace]", "+", 
  RowBox[{"0.3480891937254643`", " ", "x"}]}]], "Output",
 CellChangeTimes->{3.3957154562449207`*^9}]
}, Open  ]],

Cell[TextData[{
 "signals that we have asked ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "to do its best to fit the data to a curve of the form  "
}], "Text",
 CellChangeTimes->{{3.3957155181726093`*^9, 3.395715551612014*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SubscriptBox["a", "0"], "+", 
   RowBox[{
    SubscriptBox["a", "1"], "x"}]}], "Output",
  FontColor->GrayLevel[0.500008]]], "Input"],

Cell[TextData[{
 "\[LongDash]which is just what ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " did.  Look at the result:"
}], "Text"],

