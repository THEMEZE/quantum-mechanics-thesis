Cell[TextData[{
 StyleBox["In the last figure",
  FontColor->GrayLevel[0]],
 StyleBox[" ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["no fixed point is in evidence",
  FontColor->RGBColor[1, 0, 0]],
 ". ",
 StyleBox[" CobwebPlot", "Input"],
 " permits us to iterate (let us say) 275 times, but show only the last 75; \
to get an improved sense of what's going on, let's do so"
}], "Text",
 CellChangeTimes->{{3.395680784426427*^9, 3.39568079750773*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CobwebPlot", "[", 
  RowBox[{
   RowBox[{
    StyleBox["3",
     FontColor->RGBColor[1, 0, 0]], 
    RowBox[{"Sin", "[", "x", "]"}]}], ",", 
   RowBox[{"{", 
