Cell["\<\
Here are the cobweb plots that result from seemingly slight variants of our \
most recent command:\
\>", "Text",
 CellChangeTimes->{{3.395680562025777*^9, 3.39568061747018*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"CobwebPlot", "[", 
  RowBox[{
   RowBox[{
    StyleBox["2",
     FontColor->RGBColor[1, 0, 0]], 
    RowBox[{"Sin", "[", "x", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     StyleBox["\[Pi]",
      FontColor->GrayLevel[0]]}], "}"}], ",", 
