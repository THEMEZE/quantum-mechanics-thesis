Cell[TextData[{
 StyleBox["REMARK",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 ": If the figure, as initially presented, is scrunched up, grab a handle on \
the figure-box and ",
 StyleBox["drag to size",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 ". This will be required for several of the following figures. It was with \
earlier versions of this figure that I determined where to place the \
gridlines that mark bifurcation points. Those were improved with a couple of \
generations of trial and error. I have also experimented with the ",
 StyleBox["AspectRatio", "Input"],
 " option to find ways to control ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s tendency in these calculations to produce highly elongated figures."
}], "Text",
 CellChangeTimes->{{3.39568879011983*^9, 3.395688855490254*^9}, {
  3.395688892107533*^9, 3.395688960923863*^9}, {3.395689882085936*^9, 
