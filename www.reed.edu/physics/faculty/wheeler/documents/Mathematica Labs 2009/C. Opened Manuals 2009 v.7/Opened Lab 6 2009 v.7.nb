Cell["\<\
The imported file now lives in the notebook, and would remain there even if \
the source file were destroyed.\
\>", "Text",
 CellChangeTimes->{{3.3957112062270803`*^9, 3.395711237336224*^9}, {
  3.395733470644292*^9, 3.3957334727454777`*^9}, {3.395733747907045*^9, 
  3.395733757067976*^9}}],

Cell[TextData[{
 "I will not attempt to survey here the powerful resources that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " places at your disposal for the analysis of images, acoustic signals and \
digital data : you have, by now, learned a bit about how consult the vast ",
 StyleBox["Mathematica ",
  FontSlant->"Italic"],
 "literature (much of it at your electronic fingertips), and will best be \
instructed by urgent necessity as occasions arise."
}], "Text",
 CellChangeTimes->{3.395711288583729*^9}],

Cell[TextData[{
 "I look instead to some techniques having to do with the ",
 StyleBox["graphical display of digital data",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]],
 " (but will not concern myself with the production of bar graphs, pie \
charts, ",
 StyleBox["etc",
  FontSlant->"Italic"],
 ".\[LongDash]stuff that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " also knows how to do, but that physicists seldom find useful). "
}], "Text",
 CellChangeTimes->{{3.395711321073679*^9, 3.395711343035157*^9}}],

Cell["", "Text",
 CellChangeTimes->{{3.39571143486528*^9, 3.395711434877911*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Curve Fitting Techniques",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.39571145802776*^9, 3.3957114635970497`*^9}}],

Cell["\<\
I follow in the steps of Stan Wagon, who treats this subject in his Chapter \
11. We begin by creating some artificial \"data\":\
\>", "Text",
 CellChangeTimes->{{3.395711498113908*^9, 3.395711526133813*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"data", "=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], "-", 
        RowBox[{"Cos", "[", "x", "]"}], "+", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "12", ",", "1"}], "}"}]}], "]"}], "//", 
   "N"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0.`", ",", 
     RowBox[{"-", "1.`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1.`", ",", "0.9943158594997019`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2.`", ",", "2.9348821758069246`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3.`", ",", "3.4336975976543584`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4.`", ",", "2.7300544696118996`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5.`", ",", "2.0155100778951174`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6.`", ",", "2.3713321277949326`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"7.`", ",", "3.81510734980363`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8.`", ",", "5.309245550327632`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"9.`", ",", "5.7299679943906865`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10.`", ",", "4.910170935028343`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"11.`", ",", "3.7996051401945024`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"12.`", ",", "3.5963068656876467`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.3957115340165977`*^9, 3.395715301782568*^9, 
  3.395734150534693*^9}]
}, Open  ]],

Cell[TextData[{
 "Try first a decorated variant of the ",
 StyleBox["ListPlot", "Input"],
 " command, a simple device which we encountered already in Lab 1:"
}], "Text",
 CellChangeTimes->{{3.395711674459486*^9, 3.3957117140053864`*^9}}],

Cell[CellGroupData[{

