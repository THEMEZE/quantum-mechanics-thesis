Cell[TextData[{
 "We ",
 StyleBox["know",
  FontSlant->"Italic"],
 " we would enjoy perfect success in 13th order (since there are 13 data \
points), but it's a little remarkable that we did so well in 8th."
}], "Text"],

Cell["", "Text",
 CellChangeTimes->{{3.395715863173539*^9, 3.3957158632535686`*^9}}],

Cell["", "Text"],

Cell[TextData[{
 "It's important, however, to realize that",
 StyleBox[" we are not married to polynomials",
  FontVariations->{"Underline"->True}],
 ": a mathematician with superhuman insight might try"
}], "Text",
 CellChangeTimes->{3.39571587696312*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"devilsFit", "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"data", ",", 
    RowBox[{"{", 
     StyleBox[
      RowBox[{
       RowBox[{"Sin", "[", "x", "]"}], ",", 
       RowBox[{"Cos", "[", "x", "]"}], ",", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "+", 
         SuperscriptBox["x", "2"]}], "]"}]}],
      FontColor->RGBColor[1, 0, 0]], "}"}], ",", "x"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "1.0000000000000022`"}], " ", 
   RowBox[{"Cos", "[", "x", "]"}]}], "+", 
  RowBox[{"0.9999999999999984`", " ", 
   RowBox[{"Log", "[", 
    RowBox[{"1", "+", 
     SuperscriptBox["x", "2"]}], "]"}]}], "+", 
  RowBox[{"0.9999999999999921`", " ", 
   RowBox[{"Sin", "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{3.395715923035462*^9}]
}, Open  ]],

Cell[TextData[{
 "and thus recover precisely the function we originally used to ",
 StyleBox["generate",
  FontSlant->"Italic"],
 " our toy data! A less insightful mathematician might have tried (say)"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"devilsapprenticeFit", "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"data", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], ",", 
      RowBox[{"Cos", "[", "x", "]"}], ",", 
      StyleBox["1",
       FontColor->RGBColor[1, 0, 0]], ",", 
      StyleBox[
       SuperscriptBox["x", "2"],
       FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", "x"}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"1.7971744893055348`", "\[InvisibleSpace]", "+", 
  RowBox[{"0.02766350402408436`", " ", 
   SuperscriptBox["x", "2"]}], "-", 
  RowBox[{"1.374299622957224`", " ", 
   RowBox[{"Cos", "[", "x", "]"}]}], "+", 
  RowBox[{"0.8953772439219146`", " ", 
   RowBox[{"Sin", "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{3.3957159685086203`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"devilsapprenticeFit", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
   RowBox[{"Epilog", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
      RowBox[{"Point", "/@", "data"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "2"}], ",", "8"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{3.395715984747985*^9}],

