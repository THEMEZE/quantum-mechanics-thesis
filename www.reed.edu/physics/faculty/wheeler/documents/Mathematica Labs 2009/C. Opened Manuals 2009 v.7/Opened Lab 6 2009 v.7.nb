Cell[TextData[{
 "At ",
 StyleBox["{", "Input"],
 StyleBox["500", "Input",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[", ", "Input"],
 StyleBox["50", "Input",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["}", "Input"],
 " we have commanded ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to do 500 iterations, then plot the results of the next 50 iterations: our \
intent has been to suspend the display until the iterative process has had \
time to stabilize ",
 StyleBox["if its going to stabilize",
  FontVariations->{"Underline"->True}],
 "."
}], "Text",
 CellChangeTimes->{{3.395687439893972*^9, 3.395687454529811*^9}, {
   3.395687488144157*^9, 3.3956875454683857`*^9}, {3.395689795038753*^9, 
   3.3956897999294977`*^9}, {3.396106061397978*^9, 3.3961060687567663`*^9}, 
   3.3961063977905912`*^9, {3.396106427964704*^9, 3.3961064825045567`*^9}}],

Cell[TextData[{
 "Looking to the figure, we see that 1 is a fixed point until the control \
parameter ",
 StyleBox["\[Tau]", "Input"],
 " approaches 2, when the fixed point ",
 StyleBox["bifurcates",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " (this is called a \"pitchfork bifurcation\"). We then have a 2-cycle until \
",
 StyleBox["\[Tau]", "Input"],
 " approaches about 2.45, when a pair of second-generation bifurcations gives \
rise to a 4-cycle.  We then pass rapidly through ascending powers of 2 until \
at about ",
 StyleBox["\[Tau]", "Input"],
 " = 2.58 we enter a ",
 StyleBox["chaotic regime",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 "\[Ellipsis]which appears to be punctuated occasionally with \"islands of \
cyclicity.\""
}], "Text",
 CellChangeTimes->{{3.395687636665222*^9, 3.395687694518074*^9}, {
  3.3961065342728148`*^9, 3.396106551251354*^9}}],

Cell[TextData[{
 "If we expand the view of the 2nd & 3rd orders of bifurcation (this is done \
simply by reducing the distance between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "min"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "max"], TraditionalForm]]],
 ") we get the impression that they are just miniature copies of the initial \
bifurcation; ",
 StyleBox["i.e",
  FontSlant->"Italic"],
 "., that a ",
 StyleBox["principle of self-similarity",
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]],
 " is operative. "
}], "Text",
 CellChangeTimes->{{3.395687742597599*^9, 3.395687756935916*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BifurcationPlot", "[", 
  RowBox[{
   RowBox[{"logisticmap", "[", 
    RowBox[{"\[Tau]", ",", "x"}], "]"}], ",", 
