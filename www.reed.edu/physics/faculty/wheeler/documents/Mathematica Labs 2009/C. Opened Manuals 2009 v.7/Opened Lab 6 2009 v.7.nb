Cell[TextData[{
 "we are led asymptotically to an ",
 StyleBox["alternating pair",
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]],
 StyleBox[" of points",
  FontColor->RGBColor[0, 0, 1]],
 ". And at \[Tau] = 2.542 (I take this value from page 5 of the 1987 thesis \
of Stacey Irvine) "
}], "Text"],

