Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Epilog"}]], "Input",
 CellChangeTimes->{{3.3957116287731237`*^9, 3.395711631215096*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"Epilog is an option for graphics functions which gives a list \
of graphics primitives to be rendered after the main part of the graphics is \
rendered. \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Epilog"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.3957153027282333`*^9},
 CellTags->"Info3395690102-4556765"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", 
  StyleBox["/@",
   FontColor->GrayLevel[0]]}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\!\(\*RowBox[{\\\"Map\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"f\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"expr\\\", \\\
\"TI\\\"]}], \\\"]\\\"}]\) or \!\(\*RowBox[{StyleBox[\\\"f\\\", \\\"TI\\\"], \
\\\"/@\\\", StyleBox[\\\"expr\\\", \\\"TI\\\"]}]\) applies \
\!\(\*StyleBox[\\\"f\\\", \\\"TI\\\"]\) to each element on the first level in \
\!\(\*StyleBox[\\\"expr\\\", \\\"TI\\\"]\). \\n\!\(\*RowBox[{\\\"Map\\\", \
\\\"[\\\", RowBox[{StyleBox[\\\"f\\\", \\\"TI\\\"], \\\",\\\", \
StyleBox[\\\"expr\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"levelspec\\\", \\\
\"TI\\\"]}], \\\"]\\\"}]\) applies \!\(\*StyleBox[\\\"f\\\", \\\"TI\\\"]\) to \
parts of \!\(\*StyleBox[\\\"expr\\\", \\\"TI\\\"]\) specified by \
\!\(\*StyleBox[\\\"levelspec\\\", \\\"TI\\\"]\). \"\>", "MSG"], " ", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Map"]}]], "Print", "PrintUsage",
 CellChangeTimes->{3.39571530334238*^9},
 CellTags->"Info3395690103-1228000"]
}, Open  ]],

Cell["", "Text",
 CellChangeTimes->{{3.395712982020988*^9, 3.395712982032138*^9}}],

Cell["", "Text"],

Cell["\<\
Just as easy to use, but in most applications more interesting\[LongDash]and \
certainly more powerful (it contains the preceding as a special case, as we \
will see)\[LongDash]is the command\
\>", "Text",
 CellChangeTimes->{{3.3957118814249783`*^9, 3.395711890527725*^9}, {
  3.395733833175671*^9, 3.395733835913719*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", 
  StyleBox["Interpolation",
   FontColor->RGBColor[1, 0, 0]]}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\!\(\*RowBox[{\\\"Interpolation\\\", \\\"[\\\", RowBox[{\\\"{\
\\\", RowBox[{SubscriptBox[StyleBox[\\\"f\\\", \\\"TI\\\"], \
StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"f\\\", \
\\\"TI\\\"], StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\
\[Ellipsis]\\\", \\\"TR\\\"]}], \\\"}\\\"}], \\\"]\\\"}]\) constructs an \
interpolation of the function values \!\(\*SubscriptBox[StyleBox[\\\"f\\\", \
\\\"TI\\\"], StyleBox[\\\"i\\\", \\\"TI\\\"]]\), assumed to correspond to \
\!\(\*StyleBox[\\\"x\\\", \\\"TI\\\"]\) values 1, 2, \[Ellipsis] . \
\\n\!\(\*RowBox[{\\\"Interpolation\\\", \\\"[\\\", RowBox[{\\\"{\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \
\\\"TI\\\"], StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", \
SubscriptBox[StyleBox[\\\"f\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"2\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"f\\\", \\\"TI\\\"], \
StyleBox[\\\"2\\\", \\\"TR\\\"]]}], \\\"}\\\"}], \\\",\\\", StyleBox[\\\"\
\[Ellipsis]\\\", \\\"TR\\\"]}], \\\"}\\\"}], \\\"]\\\"}]\) constructs an \
interpolation of the function values \!\(\*SubscriptBox[StyleBox[\\\"f\\\", \
\\\"TI\\\"], StyleBox[\\\"i\\\", \\\"TI\\\"]]\) corresponding to \
\!\(\*StyleBox[\\\"x\\\", \\\"TI\\\"]\) values \!\(\*SubscriptBox[StyleBox[\\\
\"x\\\", \\\"TI\\\"], StyleBox[\\\"i\\\", \
\\\"TI\\\"]]\).\\n\!\(\*RowBox[{\\\"Interpolation\\\", \\\"[\\\", \
RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"x\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"y\\\", \\\"TI\\\"], \
StyleBox[\\\"1\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\
