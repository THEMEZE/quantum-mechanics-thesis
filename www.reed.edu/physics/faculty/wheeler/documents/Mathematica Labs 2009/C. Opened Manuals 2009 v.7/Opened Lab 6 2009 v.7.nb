Cell[CellGroupData[{

Cell[TextData[StyleBox["Wagon's Bifurcation Plot",
 FontColor->RGBColor[1, 0, 0]]], "Subsection",
 CellChangeTimes->{{3.395685998514784*^9, 3.3956860060283546`*^9}}],

Cell[TextData[{
 "It becomes natural at this point to try something like the following: (1) \
assign a value to \[Tau]; (2) iterate long enough (say 1000 steps) until \
things have stabilized, then record something like 100 consecutive values; \
(3) increment the value of \[Tau] and do the whole thing over again; (4) plot \
the data thus generated.  Stacey Irvine displays just such a figure on her \
page 7, using C code which she presents in her Appendix A, and Stan Wagon, in \
his \[Section]6.4, describes how to press ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " into such service. Comparison would show Wagon's code (presented on his \
page 158) to be a good deal briefer than Irvine's.  "
}], "Text",
 CellChangeTimes->{
  3.39568641917052*^9, {3.395686533725027*^9, 3.395686549338784*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Utilities`FilterOptions`\>\"", "]"}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"elimDups", "[", "v_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", "=", 
       RowBox[{"Sort", "[", "v", "]"}]}], "}"}], ",", 
     RowBox[{"Union", "[", 
      RowBox[{"FoldList", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#2", "<", 
            RowBox[{"0.001", "+", "#1"}]}], ",", "#1", ",", "#2"}], "]"}], 
         "&"}], ",", 
        RowBox[{"First", "[", "d", "]"}], ",", 
        RowBox[{"Rest", "[", "d", "]"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "BifurcationPlot4", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"PlotPoints", "\[Rule]", "100"}], "}"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BifurcationPlot4", "[", 
    RowBox[{"f_", ",", 
     RowBox[{"{", 
      RowBox[{"r_", ",", "a_", ",", "b_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "x0_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"iter0_", ",", "iterShow_"}], "}"}], ",", "opts___"}], "]"}], ":=",
    
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "n", "}"}], ",", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{
        RowBox[{"PlotPoints", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Options", "[", "BifurcationPlot4", "]"}]}]}], ";", 
      RowBox[{
       RowBox[{"makePts", "[", 
        RowBox[{"{", 
         RowBox[{"s_", ",", "v_"}], "}"}], "]"}], ":=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"s", ",", "#"}], "}"}], "]"}], "&"}], ",", "v"}], "]"}]}],
       ";", 
      RowBox[{"cf", "=", 
       RowBox[{"Compile", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r", ",", "_Real", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", 
         RowBox[{"Evaluate", "[", "f", "]"}]}], "]"}]}], ";", 
      RowBox[{"rVals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"#", ",", "b"}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"N", "[", "a", "]"}], ",", "b", ",", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "-", "a"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}], "]"}]}], "]"}]}]}], ";", 
      RowBox[{"data", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"rVals", ",", 
          RowBox[{"elimDups", "/@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"NestList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cf", "[", 
                RowBox[{"rVals", ",", "#"}], "]"}], "&"}], ",", " ", 
              RowBox[{"Nest", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"cf", "[", 
                  RowBox[{"rVals", ",", "#"}], "]"}], "&"}], ",", 
                RowBox[{"Array", "[", 
                 RowBox[{
                  RowBox[{"x0", "&"}], ",", "n"}], "]"}], ",", "iter0"}], 
               "]"}], ",", "iterShow"}], "]"}], "]"}]}]}], "}"}], "]"}]}], 
      ";", " ", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"AbsolutePointSize", "[", "0.4", "]"}], ",", 
           RowBox[{"makePts", "/@", "data"}]}], "}"}], "]"}], ",", 
        RowBox[{"FilterOptions", "[", 
